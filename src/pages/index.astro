---
import Base from '../layouts/Base.astro';
import { notes, categories } from '../data/notes.js';
---
<Base>
  <section class="hero">
    <div class="hero-copy"><span class="pill"><i></i> YOUR DESIGN REVISION SPACE</span><h1>Design thinking,<br /><em>made clearer.</em></h1><p>Beautifully organised notes for A-level Design & Technology. Less searching, more understanding — and a little more joy in the process.</p><div class="hero-actions"><a class="button" href="/notes/">Explore the notes <span>↗</span></a><span>Made to make things click.</span></div><div class="hero-bottom"><span class="small-line"></span> STUDY SMARTER. DESIGN BETTER.</div></div>
    <div class="hero-art" aria-hidden="true"><div class="art-label">A COLLECTION OF IDEAS<br />& THINGS THAT MATTER</div><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="sphere"><div class="sphere-inner"></div></div><div class="art-caption"><span>01 / 03</span><span>DESIGN IS EVERYWHERE ↗</span></div></div>
  </section>
  <section class="intro section-pad"><div><span class="eyebrow">WELCOME TO A-LEVEL DT</span><h2>Everything you need<br />to make it <i>make sense.</i></h2></div><p>From iconic designers to the science behind materials, explore clear notes that help you understand the why, not just memorise the what.</p></section>
  <section class="topics section-pad"><div class="section-heading"><div><span class="eyebrow">FIND YOUR FOCUS</span><h2>Explore by subject<span class="period">.</span></h2></div><a class="text-link" href="/notes/">View all notes ↗</a></div><div class="topic-grid">{categories.map((category, index) => <a class="topic-card" href={category.href}><span class="topic-top"><span class="topic-number">0{index+1} / SUBJECT</span><span class="arrow">↗</span></span><span class="topic-icon">{category.icon}</span><span class="topic-bottom"><strong>{category.name}</strong><small>{category.description}</small><span class="count">{category.count} {category.count === 1 ? 'note' : 'notes'} available</span></span></a>)}</div></section>
  <section class="featured section-pad"><div class="section-heading"><div><span class="eyebrow">A GOOD PLACE TO START</span><h2>Fresh from the notebook<span class="period">.</span></h2></div><a class="text-link" href="/notes/">Browse the library ↗</a></div><div class="note-list">{notes.map(note => <a class="note-row" href={`/notes/${note.slug}/`}><span class="note-number">{note.number}</span><span class="note-title"><strong>{note.title}</strong><small>{note.description}</small></span><span class="note-category">{note.category}</span><span class="note-arrow">↗</span></a>)}</div></section>
  <section class="closing section-pad"><span class="eyebrow">GOOD DESIGN STARTS HERE</span><h2>Curiosity looks<br />good on you<span class="period">.</span></h2><a class="button" href="/notes/">Get into the notes <span>↗</span></a><div class="closing-mark" aria-hidden="true">a·</div></section>
</Base>
<style>
.hero{display:grid;grid-template-columns:1fr 47%;min-height:630px;padding:28px clamp(24px,5.3vw,96px) 68px;gap:5%}.hero-copy{padding-top:102px;position:relative}.hero h1{margin:27px 0 25px}.hero h1 em{color:#789d4d;font-style:normal}.hero-copy>p{max-width:480px;color:#777b70;font-size:15px}.hero-actions{display:flex;align-items:center;gap:22px;margin-top:33px}.hero-actions>span{font-size:11px;color:#90948b}.hero-bottom{position:absolute;bottom:10px;left:0;font-size:10px;letter-spacing:1.7px;font-weight:800;color:#8e9488;display:flex;align-items:center;gap:10px}.small-line{display:block;width:27px;height:1px;background:#8e9488}.hero-art{background:#d9e7c8;border-radius:8px;min-height:535px;position:relative;overflow:hidden;display:grid;place-items:center}.art-label{position:absolute;top:30px;left:32px;font-size:10px;line-height:1.7;letter-spacing:1.5px;font-weight:800;color:#596b50}.orbit{position:absolute;border:1px solid rgba(74,99,63,.27);width:520px;height:520px;border-radius:50%;transform:rotate(-28deg) scaleX(.68)}.orbit-a{transform:rotate(38deg) scaleX(.67)}.orbit-b{transform:rotate(-38deg) scaleX(.67)}.sphere{width:min(65%,330px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 29% 24%,#f7fde5 0%,#d5ebac 24%,#8eaf66 57%,#415f39 83%,#283c32 100%);box-shadow:28px 40px 65px #657f6360,inset -13px -16px 31px #304d354d;position:relative;z-index:1;transform:rotate(-18deg)}.sphere:before,.sphere:after{content:'';position:absolute;border:1px solid #e1f2c083;border-radius:50%;inset:8% 33%;transform:rotate(28deg)}.sphere:after{inset:33% 8%;transform:rotate(-28deg)}.sphere-inner{position:absolute;inset:0;border-radius:50%;background:repeating-linear-gradient(0deg,transparent 0 16px,#daefb928 17px 18px);mix-blend-mode:soft-light}.art-caption{position:absolute;bottom:29px;left:32px;right:32px;display:flex;justify-content:space-between;font-size:10px;font-weight:800;letter-spacing:1px;color:#56694c}.intro{display:grid;grid-template-columns:1.4fr 1fr;align-items:end;gap:80px;padding-top:35px}.intro h2{margin:17px 0 0}.intro h2 i{font-style:normal;color:#83a959}.intro p{max-width:380px;font-size:14px;color:#787c72;margin-bottom:5px}.topics{padding-top:85px;background:#eeefe9}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:37px}.section-heading h2{margin:15px 0 0}.period{color:#91b464}.section-heading .text-link{margin-bottom:10px}.topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.topic-card{min-height:330px;background:#f9f9f5;border-radius:7px;padding:28px 31px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .2s,background .2s}.topic-card:hover{transform:translateY(-4px);background:#e1ebd3}.topic-card:nth-child(2){background:#dde8cc}.topic-card:nth-child(2):hover{background:#d1e4b5}.topic-top{display:flex;justify-content:space-between;align-items:center}.topic-number,.count{font-size:10px;letter-spacing:1.3px;font-weight:800;color:#778471}.arrow{font-size:22px}.topic-icon{font-size:65px;color:#8cad64;font-weight:300;line-height:1}.topic-bottom{display:grid;gap:9px}.topic-bottom strong{font:800 25px Manrope,sans-serif;letter-spacing:-1.2px}.topic-bottom small{font-size:12px;color:#788073}.count{margin-top:9px}.featured{background:#f7f6f2}.note-list{border-top:1px solid #dcded5}.note-row{padding:27px 5px;display:grid;grid-template-columns:85px 1fr 180px 25px;align-items:center;gap:20px;border-bottom:1px solid #dcded5}.note-row:hover .note-title strong{color:#759f44}.note-number{font-size:12px;color:#89907e}.note-title{display:grid;gap:5px}.note-title strong{font:750 20px Manrope,sans-serif;letter-spacing:-.7px}.note-title small{font-size:12px;color:#83867e}.note-category{font-size:11px;color:#777e71}.note-arrow{font-size:20px}.closing{background:#272d25;color:#fff;position:relative;overflow:hidden;min-height:385px}.closing .eyebrow{color:#bddf89}.closing h2{margin:20px 0 29px}.closing-mark{position:absolute;right:12%;bottom:-90px;font:800 380px Manrope,sans-serif;color:#8caa7230;letter-spacing:-60px;line-height:1}.closing .button{position:relative;z-index:1;color:#252620}@media(max-width:800px){.hero{grid-template-columns:1fr;padding-bottom:40px;gap:30px}.hero-copy{padding-top:50px;padding-bottom:40px}.hero-bottom{bottom:0}.hero-art{min-height:390px}.intro{grid-template-columns:1fr;gap:15px}.intro p{max-width:600px}.note-row{grid-template-columns:40px 1fr 20px}.note-category{display:none}}@media(max-width:600px){.hero-art{min-height:340px}.hero h1{font-size:clamp(48px,11vw,70px)}.hero-actions>span{display:none}.topic-grid{grid-template-columns:1fr}.topic-card{min-height:285px}.section-heading{align-items:start;flex-direction:column}.note-title strong{font-size:16px}.note-title small{font-size:11px}.closing-mark{font-size:250px;right:5%;bottom:-50px}}
</style>
