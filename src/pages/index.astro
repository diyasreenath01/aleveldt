---
import Base from '../layouts/Base.astro';
import { syllabus } from '../data/syllabus.js';
import { notes } from '../data/notes.js';
---
<Base title="AQA A-level Design & Technology | Product Design 7552" description="AQA 7552 Product Design revision notes organised by specification topic, plus official past papers.">
  <section class="masthead"><div class="mast-copy"><div class="course-line"><span>A-LEVEL</span><span>AQA / 7552</span></div><h1>Design &<br />Technology<span>.</span></h1><p class="subtitle">Product Design revision notes and past papers.</p><div class="mast-actions"><a href="/notes/">Browse revision topics <span>↗</span></a><a href="/past-papers/">Past papers <span>↗</span></a></div></div><div class="course-panel"><span>THE AQA 7552 COURSE</span><div class="panel-item"><b>01</b><div><strong>Technical principles</strong><small>Paper 1 / 14 specification topics</small></div></div><div class="panel-item"><b>02</b><div><strong>Designing & making principles</strong><small>Paper 2 / 10 specification topics</small></div></div><div class="panel-item"><b>03</b><div><strong>Non-exam assessment</strong><small>Design and make project</small></div></div></div></section>
  <section class="browse"><div class="section-head"><div><span>REVISION NOTES / AQA 7552</span><h2>Browse the specification</h2><p>Choose a paper, expand a topic and open the notes available so far.</p></div><a href="/notes/">View all 24 topics ↗</a></div><div class="paper-grid">{syllabus.map((group,index) => <article class="paper-card"><div class="paper-label"><span>0{index+1} / {group.code}</span><span>{group.topics.length} TOPICS</span></div><h3>{group.title}</h3><div class="topic-preview">{group.topics.slice(0,4).map(([code,title]) => <a href={`/notes/#${group.id}`}><span>{code}</span>{title}<b>↗</b></a>)}</div><a class="all-link" href={`/notes/#${group.id}`}>All {group.topics.length} topics <span>↗</span></a></article>)}</div></section>
  <section class="lower"><div class="recent"><div class="section-head"><div><span>PUBLISHED NOTES</span><h2>Read a note</h2></div><a href="/notes/">All revision topics ↗</a></div><div class="note-list">{notes.map(note => <a href={`/notes/${note.slug}/`}><div><small>{note.type} / {note.category}</small><strong>{note.title}</strong></div><span>↗</span></a>)}</div></div><aside class="exam"><span>EXAM PRACTICE</span><h2>Past papers</h2><p>Paper 1: Technical principles<br />Paper 2: Designing and making principles</p><a href="/past-papers/">Find question papers and mark schemes ↗</a></aside></section>
</Base>
<style>
.masthead{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(330px,.65fr);background:linear-gradient(112deg,#220e3f 0%,#3f1e72 54%,#7652ac 100%);color:white}.mast-copy{padding:63px 6vw 65px clamp(24px,7vw,112px)}.course-line{display:flex;gap:12px;align-items:center;color:#dac2ff;font-size:10px;letter-spacing:.17em;font-weight:800}.course-line span:first-child{background:#ffffff27;padding:8px 10px;color:white}.masthead h1{font-size:clamp(58px,6.4vw,102px);line-height:1.03;margin:24px 0 13px;letter-spacing:-.075em}.masthead h1 span{color:#bd91ff}.subtitle{font-size:18px;color:#e8d9ff;line-height:1.5}.mast-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:28px}.mast-actions a{background:white;color:#281543;padding:15px 17px;font-size:12px;font-weight:800;display:flex;gap:25px;justify-content:space-between;transition:transform .2s,background .2s}.mast-actions a:last-child{background:#ffffff18;color:white;border:1px solid #baa0d8}.mast-actions a:hover{transform:translateY(-2px);background:#e8d9ff}.course-panel{background:#ffffff14;border-left:1px solid #ffffff26;padding:65px clamp(25px,3vw,55px) 45px;display:flex;flex-direction:column}.course-panel>span{color:#d9bbfc;font-size:10px;font-weight:800;letter-spacing:.17em;margin-bottom:16px}.panel-item{display:flex;gap:16px;padding:18px 0;border-bottom:1px solid #ffffff35;align-items:start}.panel-item b{color:#bc96f3;font-size:12px}.panel-item div{display:grid;gap:5px}.panel-item strong{font-size:14px}.panel-item small{color:#d6c4e8;font-size:11px}.browse{background:#faf8fd;padding:65px clamp(24px,7vw,112px) 77px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:23px}.section-head>div>span,.exam>span{font-size:10px;font-weight:800;letter-spacing:.16em;color:#7343ac}.section-head h2{font-size:clamp(29px,3.4vw,47px);margin:9px 0 6px}.section-head p{color:#71687b;font-size:13px;margin:0}.section-head>a{font-size:12px;color:#69439c;font-weight:800;white-space:nowrap;margin-bottom:6px}.paper-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.paper-card{background:white;border:1px solid #e6dcec;padding:26px 28px 23px}.paper-label{display:flex;justify-content:space-between;color:#7343ac;font-size:10px;font-weight:800;letter-spacing:.1em}.paper-card h3{font-size:29px;line-height:1.14;margin:20px 0;min-height:66px}.topic-preview{border-top:1px solid #e9e3ee}.topic-preview a{border-bottom:1px solid #e9e3ee;padding:11px 0;display:grid;grid-template-columns:52px 1fr 16px;gap:10px;align-items:center;font-size:12px;font-weight:600;transition:color .2s}.topic-preview a:hover{color:#834cc0}.topic-preview span{font-size:10px;color:#916db2}.topic-preview b{font-size:15px;font-weight:400}.all-link{display:flex;justify-content:space-between;font-size:12px;font-weight:800;color:#5a2a93;margin-top:20px}.lower{display:grid;grid-template-columns:1.4fr .6fr;gap:40px;padding:70px clamp(24px,7vw,112px) 90px;background:#fff}.note-list{border-top:1px solid #e6dcec}.note-list>a{padding:18px 0;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e6dcec;transition:color .2s}.note-list>a:hover{color:#8247b5}.note-list div{display:grid;gap:4px}.note-list small{color:#80619b;font-size:10px}.note-list strong{font-size:17px}.exam{background:linear-gradient(145deg,#f0e8fb,#faf7ff);border:1px solid #e9def4;padding:30px;align-self:start}.exam h2{font-size:34px;margin:13px 0}.exam p{font-size:12px;color:#594a69}.exam a{display:inline-block;font-size:12px;font-weight:800;color:#5a2a93;margin-top:12px}@media(max-width:850px){.masthead,.lower{grid-template-columns:1fr}.course-panel{padding:25px 6vw;border-left:0;border-top:1px solid #ffffff26}.course-panel .panel-item{padding:12px 0}.mast-copy{padding-right:24px}.lower{gap:25px}}@media(max-width:650px){.paper-grid{grid-template-columns:1fr}.browse,.lower{padding-top:50px;padding-bottom:55px}.section-head{align-items:start;flex-direction:column}.paper-card h3{min-height:0}}
</style>
