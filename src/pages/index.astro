---
import Base from '../layouts/Base.astro';
import { syllabus } from '../data/syllabus.js';
import { notes } from '../data/notes.js';
---
<Base title="A-level DT | AQA Product Design 7552" description="Revision notes and past papers for AQA A-level Design & Technology: Product Design (7552).">
<div class="dashboard"><div class="breadcrumbs">STUDY SPACE <span>/</span> AQA PRODUCT DESIGN 7552</div><section class="welcome"><div><span class="badge">AQA · A-LEVEL · 7552</span><h1>Your Product Design<br /><em>study space.</em></h1><p>Revision notes by specification topic, with Paper 1 and Paper 2 past papers when you’re ready to practise.</p><a href="/notes/">Find a topic to revise <b>↗</b></a></div><div class="welcome-side" aria-label="Course structure"><div class="draft-grid"></div><span>COURSE MAP</span><strong>14<span>+</span>10</strong><small>Technical topics + designing & making topics</small><div class="rule"></div><small>2 EXAM PAPERS&nbsp;&nbsp; / &nbsp;&nbsp;1 DESIGN PROJECT</small></div></section>
<div class="content-grid"><section class="subjects"><div class="section-title"><div><span>START REVISING</span><h2>Choose your paper</h2></div><a href="/notes/">Full topic list ↗</a></div><div class="subject-cards">{syllabus.map((group,index) => <article class={`subject subject-${index}`}><div class="subject-top"><span>PAPER {index+1} · {group.code}</span><span>{group.topics.length} TOPICS</span></div><h3>{group.title}</h3><div class="subject-list">{group.topics.slice(0,index===0?5:5).map(([code,title]) => <a href={`/notes/#${group.id}`}><span>{code}</span><strong>{title}</strong><span>↗</span></a>)}</div><a class="all-topics" href={`/notes/#${group.id}`}>Explore all {group.topics.length} topics ↗</a></article>)}</div></section><aside class="right-rail"><section class="quick"><span>EXAM PRACTICE</span><h2>Past papers</h2><p>Question papers and mark schemes for AQA 7552/1 and 7552/2.</p><a href="/past-papers/">Open past papers ↗</a></section><section class="fresh"><span>NOTES AVAILABLE</span><h2>Recently added</h2>{notes.map(note => <a href={`/notes/${note.slug}/`}><small>{note.category}</small><strong>{note.title}</strong><b>↗</b></a>)}</section></aside></div></div>
</Base>
<style>
.dashboard{background:#fbf8f5;padding:24px clamp(22px,4vw,62px) 60px}.breadcrumbs{font-size:9px;font-weight:800;letter-spacing:.17em;color:#927ca0;margin-bottom:20px}.breadcrumbs span{margin:0 8px;color:#c9b6d4}.welcome{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(230px,.7fr);background:linear-gradient(114deg,#ead6f5 0%,#f6dceb 54%,#f8eacb 100%);border:1px solid #e4d4e8;border-radius:18px;overflow:hidden;min-height:275px;box-shadow:0 13px 35px #5330680b}.welcome>div:first-child{padding:33px 36px}.badge{background:#ffffffa1;border:1px solid #e4c9e8;border-radius:30px;padding:6px 10px;font-size:9px;font-weight:800;letter-spacing:.14em;color:#6d428b}.welcome h1{font-size:clamp(38px,4.5vw,68px);line-height:1.05;margin:18px 0 12px;color:#281238}.welcome h1 em{font-style:normal;color:#9252a5}.welcome p{font-size:12px;color:#654d68;max-width:500px;margin-bottom:19px}.welcome a{display:inline-flex;gap:40px;align-items:center;background:#3c1c59;color:white;padding:12px 15px;border-radius:7px;font-size:11px;font-weight:800;transition:transform .2s}.welcome a:hover{transform:translateY(-2px)}.welcome-side{border-left:1px solid #cfb7d3;position:relative;overflow:hidden;padding:30px;display:flex;flex-direction:column;justify-content:center;color:#44225c}.draft-grid{position:absolute;inset:0;background-image:linear-gradient(#73428b0e 1px,transparent 1px),linear-gradient(90deg,#73428b0e 1px,transparent 1px);background-size:25px 25px;transform:rotate(-12deg) scale(1.3);pointer-events:none}.welcome-side>span,.welcome-side small{position:relative;font-size:10px;font-weight:800;letter-spacing:.08em}.welcome-side strong{position:relative;font:800 clamp(55px,6vw,94px) Manrope,sans-serif;letter-spacing:-.1em;line-height:1.2}.welcome-side strong span{color:#a068b5}.welcome-side small{max-width:160px;line-height:1.4;font-weight:600;letter-spacing:0}.welcome-side .rule{position:relative;height:1px;background:#8d6b9d6b;margin:16px 0;max-width:180px}.content-grid{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:18px;margin-top:30px}.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:14px}.section-title span,.quick>span,.fresh>span{font-size:9px;font-weight:800;letter-spacing:.15em;color:#8151a1}.section-title h2{font-size:27px;margin:5px 0 0}.section-title>a{font-size:10px;font-weight:800;color:#764498;padding-bottom:5px}.subject-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px}.subject{background:white;border:1px solid #e9dfe8;border-radius:13px;overflow:hidden;box-shadow:0 5px 20px #31104308}.subject-1{background:#fcf8ff}.subject-top{display:flex;justify-content:space-between;padding:19px 20px 0;color:#8453a0;font-size:9px;font-weight:800;letter-spacing:.07em}.subject h3{font-size:23px;line-height:1.16;min-height:56px;margin:16px 20px 13px}.subject-list{border-top:1px solid #eee4ef}.subject-list a{display:grid;grid-template-columns:38px 1fr 15px;gap:8px;align-items:center;padding:9px 19px;border-bottom:1px solid #f0e9ef;font-size:10px;line-height:1.3;transition:background .2s}.subject-list a:hover{background:#f5eaf8}.subject-list a span:first-child{color:#9b76ad;font-size:9px}.subject-list a strong{font-weight:650}.subject-list a span:last-child{color:#8453a0;font-size:13px}.all-topics{display:block;padding:14px 19px;color:#724099;font-size:11px;font-weight:800}.right-rail{display:grid;align-content:start;gap:13px}.quick{background:#3f205e;color:white;border-radius:13px;padding:23px}.quick>span{color:#d8b3f5}.quick h2{font-size:26px;margin:11px 0}.quick p{font-size:11px;color:#e1ccec;line-height:1.6}.quick a{display:block;background:#e2b8ff;color:#35164c;padding:11px;border-radius:6px;text-align:center;font-size:10px;font-weight:800;margin-top:17px}.fresh{background:white;border:1px solid #e9dfe8;border-radius:13px;padding:20px}.fresh h2{font-size:20px;margin:8px 0 12px}.fresh a{display:grid;grid-template-columns:1fr 14px;border-top:1px solid #eee6ef;padding:11px 0;gap:3px}.fresh a small{grid-column:1/-1;color:#9274a2;font-size:9px}.fresh a strong{font-size:11px;letter-spacing:-.01em}.fresh a b{color:#8953b4}@media(max-width:1200px){.content-grid{grid-template-columns:1fr}.right-rail{grid-template-columns:1fr 1fr}}@media(max-width:730px){.welcome{grid-template-columns:1fr}.welcome-side{display:none}.subject-cards,.right-rail{grid-template-columns:1fr}.welcome>div:first-child{padding:26px}.content-grid{margin-top:24px}.subject h3{min-height:0}}
</style>
