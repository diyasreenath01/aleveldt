---
import Base from '../layouts/Base.astro';
import { syllabus } from '../data/syllabus.js';
---
<Base title="A-Level DT Notes | AQA Product Design 7552 Revision" description="Free AQA A-Level Design and Technology Product Design 7552 revision notes, quizzes, flashcards, exam-style practice and past-paper support.">
<div class="dashboard"><div class="breadcrumbs">STUDY SPACE <span>/</span> AQA PRODUCT DESIGN 7552</div><section class="welcome"><div><span class="badge">AQA · A-LEVEL · 7552</span><h1>A-Level DT Revision Notes<br /><em>for AQA Product Design.</em></h1><p>Free AQA A-Level Design & Technology: Product Design (7552) revision notes organised by specification topic, with quizzes, flashcards, exam practice and Paper 1 and Paper 2 support.</p><a href="/notes/">Find a topic to revise <b>↗</b></a></div></section><section class="study-tools"><a href="/tracker/"><span>TRACK YOUR REVISION</span><strong>Revision tracker</strong><p>See what you have covered, what you are learning and what needs another look.</p><b>Open tracker →</b></a><a href="/quiz/"><span>ACTIVE RECALL</span><strong>Quiz mode</strong><p>Test yourself with recall, application and AQA-style exam questions.</p><b>Start a quiz →</b></a></section>
<div class="content-grid"><section class="subjects"><div class="section-title"><div><span>START REVISING</span><h2>Choose your paper</h2></div><a href="/notes/">Full topic list ↗</a></div><div class="subject-cards">{syllabus.map((group,index) => <article class={`subject subject-${index}`}><div class="subject-top"><span>PAPER {index+1} · {group.code}</span><span>{group.topics.length} TOPICS</span></div><h3>{group.title}</h3><div class="subject-list">{group.topics.map(([code,title]) => <a href={`/notes/${code}/`}><span>{code}</span><strong>{title}</strong><span>↗</span></a>)}</div></article>)}</div></section></div></div>
</Base>
<style>
.dashboard{background:#fbf8f5;padding:24px clamp(22px,4vw,62px) 60px}.breadcrumbs{font-size:9px;font-weight:800;letter-spacing:.17em;color:#927ca0;margin-bottom:20px}.breadcrumbs span{margin:0 8px;color:#c9b6d4}.welcome{display:grid;grid-template-columns:1fr;background:linear-gradient(114deg,#ead6f5 0%,#f6dceb 54%,#f8eacb 100%);border:1px solid #e4d4e8;border-radius:18px;overflow:hidden;min-height:330px;box-shadow:0 13px 35px #5330680b}.welcome>div:first-child{padding:44px clamp(28px,4vw,70px)}.badge{background:#ffffffa1;border:1px solid #e4c9e8;border-radius:30px;padding:6px 10px;font-size:9px;font-weight:800;letter-spacing:.14em;color:#6d428b}.welcome h1{font-size:clamp(46px,5vw,86px);line-height:1.05;margin:18px 0 12px;color:#281238}.welcome h1 em{font-style:normal;color:#9252a5}.welcome p{font-size:16px;color:#654d68;max-width:630px;margin-bottom:24px}.welcome a{display:inline-flex;gap:40px;align-items:center;background:#3c1c59;color:white;padding:15px 20px;border-radius:7px;font-size:14px;font-weight:800;transition:transform .2s}.welcome a:hover{transform:translateY(-2px)}.content-grid{display:grid;grid-template-columns:1fr;gap:18px;margin-top:30px}.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:14px}.section-title span,.quick>span{font-size:9px;font-weight:800;letter-spacing:.15em;color:#8151a1}.section-title h2{font-size:34px;margin:5px 0 0}.section-title>a{font-size:13px;font-weight:800;color:#764498;padding-bottom:5px}.subject-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px}.subject{background:white;border:1px solid #e9dfe8;border-radius:13px;overflow:hidden;box-shadow:0 5px 20px #31104308}.subject-1{background:#fcf8ff}.subject-top{display:flex;justify-content:space-between;padding:25px 22px 0;color:#8453a0;font-size:11px;font-weight:800;letter-spacing:.07em}.subject h3{font-size:30px;line-height:1.16;min-height:55px;margin:17px 22px 20px}.subject-list{border-top:1px solid #eee4ef}.subject-list a{display:grid;grid-template-columns:46px 1fr 18px;gap:10px;align-items:center;padding:15px 22px;border-bottom:1px solid #f0e9ef;font-size:15px;line-height:1.35;transition:background .2s}.subject-list a:hover{background:#f5eaf8}.subject-list a span:first-child{color:#9b76ad;font-size:12px}.subject-list a strong{font-weight:650}.subject-list a span:last-child{color:#8453a0;font-size:17px}.all-topics{display:block;padding:18px 22px;color:#724099;font-size:14px;font-weight:800}.right-rail{display:grid;align-content:start;gap:13px}.quick{background:#3f205e;color:white;border-radius:13px;padding:23px}.quick>span{color:#d8b3f5}.quick h2{font-size:26px;margin:11px 0}.quick p{font-size:11px;color:#e1ccec;line-height:1.6}.quick a{display:block;background:#e2b8ff;color:#35164c;padding:11px;border-radius:6px;text-align:center;font-size:10px;font-weight:800;margin-top:17px}@media(max-width:1200px){.content-grid{grid-template-columns:1fr}.right-rail{grid-template-columns:1fr}}@media(max-width:730px){.welcome{grid-template-columns:1fr}.welcome-side{display:none}.subject-cards,.right-rail{grid-template-columns:1fr}.welcome>div:first-child{padding:26px}.content-grid{margin-top:24px}.subject h3{min-height:0}}
.study-tools{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.study-tools>a{background:#fff;border:1px solid #e7dce9;border-radius:13px;padding:24px;transition:transform .2s,background .2s}.study-tools>a:hover{transform:translateY(-2px);background:#fdf8ff}.study-tools span{font-size:9px;letter-spacing:.14em;font-weight:800;color:#8a58a5}.study-tools strong{display:block;font:800 25px Manrope;margin:8px 0}.study-tools p{font-size:12px;color:#766a7c;max-width:470px}.study-tools b{font-size:11px;color:#724099}.home-about{margin-top:46px;border-top:1px solid #ded3e1;padding:55px 0 20px}.about-kicker{display:flex;justify-content:space-between;gap:20px;margin-bottom:30px}.about-kicker span,.about-kicker small{font-size:9px;letter-spacing:.15em;font-weight:800;color:#8551a1}.about-kicker small{color:#9a8e9f}.about-main{display:grid;grid-template-columns:minmax(0,.9fr) minmax(320px,.75fr);gap:clamp(40px,8vw,120px);align-items:start}.about-main h2{font-size:clamp(37px,4.5vw,64px);line-height:1.02;letter-spacing:-.055em;margin:0}.about-main h2 em{font-style:normal;color:#9252a5}.about-main p{font-size:14px;line-height:1.75;color:#665a6c}.about-main a{display:inline-block;margin-top:8px;color:#6e3c8d;font-size:12px;font-weight:800}@media(max-width:730px){.study-tools{grid-template-columns:1fr}.about-main{grid-template-columns:1fr;gap:25px}.about-kicker{margin-bottom:22px}}</style>
