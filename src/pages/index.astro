---
import Base from '../layouts/Base.astro';
import { syllabus } from '../data/syllabus.js';
---
<Base title="A-level DT | Product Design revision" description="AQA A-level Product Design revision notes by topic and past papers.">
  <section class="hero"><div class="hero-inner"><span class="kicker">AQA 7552 / PRODUCT DESIGN</span><h1>Design is better<br />when it <span>makes sense.</span></h1><p>A clear place to revise A-level Design & Technology. Find your topic, read the notes, and practise with past papers.</p><div class="actions"><a class="primary" href="/notes/">Explore revision notes <span>↗</span></a><a class="secondary" href="/past-papers/">Find past papers <span>↗</span></a></div></div><div class="hero-foot"><span>BUILT FOR THE CURIOUS</span><span>SCROLL TO EXPLORE ↓</span></div></section>
  <section class="directory"><div class="section-top"><span class="kicker">01 / REVISION</span><h2>Start with a topic<span class="accent">.</span></h2><p>The AQA specification, organised into the two parts you study.</p></div><div class="groups">{syllabus.map((group, i) => <a class="group" href={`/notes/#${group.id}`}><span class="index">0{i+1} / {group.code}</span><span class="group-title">{group.title}</span><span class="group-detail">{group.topics.length} topics · Browse the syllabus <span>↗</span></span></a>)}</div></section>
  <section class="papers"><span class="kicker">02 / PRACTISE</span><div><h2>Know it. Then<br /><span>put it to the test.</span></h2><p>Question papers, mark schemes and examiner resources from AQA, all in one place.</p><a class="primary light" href="/past-papers/">Explore past papers <span>↗</span></a></div></section>
</Base>
<style>
.hero{min-height:690px;background:radial-gradient(ellipse 80% 90% at 94% 4%,#7956c5 0%,transparent 70%),linear-gradient(130deg,#1b0e36,#351467 64%,#563299);color:white;padding:95px clamp(24px,8vw,128px) 32px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.hero-inner{max-width:1050px}.kicker{font-size:11px;letter-spacing:.16em;font-weight:800}.hero .kicker{color:#d8c9ff}.hero h1{font-size:clamp(57px,7.4vw,118px);letter-spacing:-.075em;line-height:1.04;margin:38px 0 28px}.hero h1 span{color:#d1baff}.hero p{max-width:560px;color:#e0d5f3;font-size:17px;line-height:1.7}.actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:42px}.primary,.secondary{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;padding:17px 21px;border-radius:3px;font-size:13px;font-weight:800;transition:transform .25s ease,background .25s ease}.primary:hover,.secondary:hover{transform:translateY(-3px)}.primary{background:#eee6ff;color:#251342}.primary:hover{background:#fff}.secondary{border:1px solid #a78bce;color:white}.secondary:hover{background:#ffffff1d}.hero-foot{display:flex;justify-content:space-between;font-size:10px;font-weight:700;letter-spacing:.15em;color:#cfbde8}.directory{padding:110px clamp(24px,8vw,128px) 125px;background:#fcfaff}.section-top h2{margin:18px 0 10px;font-size:clamp(40px,5vw,72px)}.section-top p{color:#695d77}.accent{color:#8d62d1}.groups{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:45px}.group{background:white;border:1px solid #e8e0ef;padding:34px;min-height:270px;display:flex;flex-direction:column;justify-content:space-between;transition:background .25s,transform .25s,box-shadow .25s}.group:hover{background:#f3ebff;transform:translateY(-4px);box-shadow:0 20px 50px #2e105b0d}.index,.group-detail{font-size:11px;font-weight:750;color:#7956a5}.group-title{font-size:clamp(26px,3vw,43px);font-weight:800;letter-spacing:-.06em;max-width:450px;line-height:1.13}.group-detail{display:flex;justify-content:space-between}.papers{background:#251141;color:white;padding:105px clamp(24px,8vw,128px);display:grid;grid-template-columns:1fr 2fr;gap:40px}.papers>.kicker{color:#c9a7f8}.papers h2{font-size:clamp(44px,5.6vw,82px);margin:0 0 20px}.papers h2 span{color:#b997eb}.papers p{max-width:510px;color:#d4c3e9}.light{margin-top:22px}@media(max-width:700px){.hero{min-height:650px;padding-top:80px}.hero-foot span:last-child{display:none}.groups,.papers{grid-template-columns:1fr}.directory{padding-top:75px;padding-bottom:85px}.group{min-height:225px}}
</style>
