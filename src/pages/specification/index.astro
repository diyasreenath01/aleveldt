---
import Base from '../../layouts/Base.astro';
import { syllabus, subtopicPath } from '../../data/syllabus.js';
import { hasSubtopicNotes } from '../../data/contentStatus.js';
const specPdf = 'https://filestore.aqa.org.uk/resources/design-and-technology/specifications/AQA-7552-SP-2017.PDF';
---
<Base title="AQA A-Level Product Design 7552 Specification Checklist | A-levelDT" description="A student-friendly AQA A-Level Design and Technology: Product Design 7552 specification checklist. Work through Paper 1 technical principles and Paper 2 designing and making principles with links to revision notes." breadcrumbs={[{name:'A-levelDT',path:'/'},{name:'AQA 7552 specification',path:'/specification/'}]}>
<header class="head"><span class="label">AQA 7552 / SPECIFICATION CHECKLIST</span><h1>The AQA 7552<br /><span>specification, simplified.</span></h1><p>Use this page as your revision checklist. Every section follows the AQA A-Level Design & Technology: Product Design (7552) specification and links straight to the notes already available on ALevelDT.</p><div class="actions"><a class="primary" href={specPdf} target="_blank" rel="noopener noreferrer">Official AQA specification PDF ↗</a><a href="/past-papers/">Past papers →</a></div></header>
<main class="content">
<section class="assessment"><article><span>PAPER 1 · 7552/1</span><strong>Technical principles</strong><p>2 hours 30 minutes · 120 marks · 30% of A-level</p></article><article><span>PAPER 2 · 7552/2</span><strong>Designing & making principles</strong><p>1 hour 30 minutes · 80 marks · 20% of A-level</p></article><article><span>NEA · 7552/C</span><strong>Design & make project</strong><p>100 marks · 50% of A-level</p></article></section>
{syllabus.map(group => <section class="group" id={group.id}><div class="group-head"><div><span>{group.code}</span><h2>{group.title}</h2></div><a href={group.source} target="_blank" rel="noopener noreferrer">Check against AQA ↗</a></div><div class="topics">{group.topics.map(([code,title,subtopics]) => { const available=subtopics.filter(name=>hasSubtopicNotes(code,name)).length; return <details class="topic"><summary><span class="code">{code}</span><strong>{title}</strong><span class="progress">{available}/{subtopics.length} notes live</span><span class="arrow">⌄</span></summary><div class="subtopics">{subtopics.map(name => hasSubtopicNotes(code,name) ? <a href={subtopicPath(code,name)}><span class="tick">✓</span><strong>{name}</strong><span>Read notes →</span></a> : <div class="pending"><span>○</span><strong>{name}</strong><small>Notes coming soon</small></div>)}</div></details> })}</div></section>)}
<section class="next"><div><span class="label">REVISION WORKFLOW</span><h2>Learn it. Test it. Apply it.</h2><p>Use the specification to find your gaps, revise the matching notes, then test your knowledge with flashcards, quizzes and official past papers.</p></div><div class="next-links"><a href="/notes/">Revision notes →</a><a href="/flashcards/">Flashcards →</a><a href="/quiz/">Quizzes →</a><a href="/past-papers/">Past papers →</a></div></section>
</main>
</Base>
<style>
.head{background:linear-gradient(110deg,#f6eafb,#dfcbf6);color:#291743;padding:55px clamp(24px,7vw,112px) 58px}.label,.group-head span,.assessment span{font-size:11px;letter-spacing:.14em;font-weight:800;color:#7750a0}.head h1{font-size:clamp(44px,5.3vw,75px);margin:25px 0;letter-spacing:-.075em}.head h1 span{color:#8953bc}.head>p{max-width:760px;color:#61506e;font-size:16px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:27px}.actions a{border:1px solid #9e79bd;color:#4d2867;padding:12px 15px;border-radius:7px;font-size:11px;font-weight:850}.actions .primary{background:#321754;color:white;border-color:#321754}.content{background:#fffaf7;padding:50px clamp(24px,7vw,112px) 90px}.assessment{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:65px}.assessment article{background:white;border:1px solid #e5daef;border-radius:12px;padding:23px;display:grid;gap:8px}.assessment strong{font-size:19px}.assessment p{font-size:12px;color:#75677d;margin:0}.group{scroll-margin-top:25px;margin-bottom:65px}.group-head{display:flex;justify-content:space-between;gap:25px;align-items:end;padding-bottom:20px;border-bottom:1px solid #dcd4e5}.group-head h2{font-size:clamp(34px,4vw,56px);margin:7px 0 0;letter-spacing:-.055em}.group-head>a{font-size:11px;font-weight:800;color:#7955ac}.topic{border-bottom:1px solid #dcd4e5}.topic summary{list-style:none;display:grid;grid-template-columns:90px minmax(0,1fr) auto 20px;align-items:center;gap:15px;min-height:82px;cursor:pointer}.topic summary::-webkit-details-marker{display:none}.topic summary:hover{background:#f5ebfa}.code{font-size:11px;font-weight:850;color:#7955ac}.topic summary>strong{font-size:19px}.progress{font-size:11px;color:#817489}.arrow{font-size:20px;color:#7955ac;transition:transform .2s}.topic[open] .arrow{transform:rotate(180deg)}.subtopics{margin:0 0 14px 90px;border-left:2px solid #e1d2e8;padding:4px 0 4px 20px}.subtopics>a,.pending{display:grid;grid-template-columns:28px minmax(0,1fr) auto;align-items:center;gap:10px;min-height:49px;padding:5px 12px;border-bottom:1px solid #eee5f0;font-size:13px}.subtopics>a:hover{background:#f4eafb}.subtopics>a>span:last-child,.pending small{font-size:10px;color:#8b6c9d}.tick{color:#70428b;font-weight:900}.pending{color:#8a7d90}.next{background:#321754;color:white;border-radius:14px;padding:32px;display:grid;grid-template-columns:1.2fr .8fr;gap:35px}.next .label{color:#d7b8ed}.next h2{font-size:35px;margin:10px 0}.next p{font-size:12px;color:#d8cce1;max-width:600px}.next-links{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:center}.next-links a{background:white;color:#321754;border-radius:7px;padding:13px;font-size:11px;font-weight:850}@media(max-width:760px){.assessment{grid-template-columns:1fr}.group-head{align-items:start;flex-direction:column}.topic summary{grid-template-columns:58px 1fr 20px;padding:10px 0}.progress{display:none}.subtopics{margin-left:15px;padding-left:10px}.subtopics>a,.pending{grid-template-columns:22px 1fr}.subtopics>a>span:last-child,.pending small{grid-column:2}.next{grid-template-columns:1fr}.next-links{grid-template-columns:1fr}}
</style>