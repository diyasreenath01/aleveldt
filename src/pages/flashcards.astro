---
import Base from '../layouts/Base.astro';import { syllabus } from '../data/syllabus.js';import { flashcards } from '../data/flashcards.js';const available=[...new Set(flashcards.map(x=>x.topic+'::'+x.subtopic))];
---
<Base title="Flashcards | A-level DT"><main class="page"><header><span class="eyebrow">ACTIVE RECALL · AQA 7552</span><h1>Flashcards<span>.</span></h1><p>Recall the answer before revealing it. Mark difficult cards and come back to them.</p></header><section class="setup"><select id="pick">{syllabus.flatMap(g=>g.topics.flatMap(([code,t,subs])=>subs.map(s=><option value={code+'::'+s} disabled={!available.includes(code+'::'+s)}>{code} · {s}{!available.includes(code+'::'+s)?' — coming soon':''}</option>)))}</select><button id="start">Start cards →</button></section><section class="card" id="card" hidden><div class="count" id="count"></div><h2 id="front"></h2><div id="back" class="back" hidden></div><button class="reveal" id="reveal">Reveal answer</button><div class="rate" id="rate" hidden><button data-rate="again">Again</button><button data-rate="hard">Hard</button><button data-rate="got">Got it</button></div></section></main><script define:vars={{cards:flashcards}}>
let bank=[],i=0;const pick=document.querySelector('#pick'),card=document.querySelector('#card'),front=document.querySelector('#front'),back=document.querySelector('#back'),count=document.querySelector('#count'),rate=document.querySelector('#rate'),reveal=document.querySelector('#reveal');function show(){let x=bank[i];front.textContent=x.front;back.textContent=x.back;back.hidden=true;rate.hidden=true;reveal.hidden=false;count.textContent=(i+1)+' / '+bank.length;card.hidden=false}document.querySelector('#start').onclick=()=>{bank=cards.filter(x=>x.topic+'::'+x.subtopic===pick.value);i=0;if(bank.length)show()};reveal.onclick=()=>{back.hidden=false;rate.hidden=false;reveal.hidden=true};rate.querySelectorAll('button').forEach(b=>b.onclick=()=>{if(b.dataset.rate!=='got')bank.push(bank[i]);i++;if(i>=bank.length){front.textContent='Set complete.';back.hidden=true;rate.hidden=true;count.textContent='Nice work';return}show()});
</script></Base><style>.page{padding:48px clamp(24px,7vw,110px) 90px;background:#fbf8f5;min-height:100vh}.page header{max-width:800px}.page h1{font-size:clamp(48px,6vw,80px);margin:10px 0}.page h1 span{color:#9c61b9}.page header p{font-size:18px;color:#6d6074}.setup{display:flex;gap:12px;margin:35px 0}.setup select{flex:1;padding:14px;border:1px solid #dfd3e4;border-radius:8px;background:#fff}.setup button,.reveal,.rate button{border:0;border-radius:7px;background:#482166;color:#fff;padding:14px 20px;font-weight:800;cursor:pointer}.card{max-width:950px;background:#fff;border:1px solid #e6dbe9;border-radius:18px;padding:clamp(30px,5vw,65px);box-shadow:0 12px 35px #4422520a}.count{font-size:11px;font-weight:800;color:#966bad}.card h2{font-size:clamp(28px,4vw,45px);margin:25px 0}.back{font-size:20px;line-height:1.7;background:linear-gradient(110deg,#f2e7f8,#fff8ef);padding:25px;border-radius:12px;margin-bottom:20px}.rate{display:flex;gap:10px}.rate button:nth-child(1){background:#8b3f51}.rate button:nth-child(2){background:#bd7b23}.rate button:nth-child(3){background:#593199}@media(max-width:650px){.setup,.rate{display:grid}}</style>