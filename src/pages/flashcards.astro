---
import Base from '../layouts/Base.astro';import { syllabus } from '../data/syllabus.js';import { flashcards } from '../data/flashcards.js';const available=[...new Set(flashcards.map(x=>x.topic+'::'+x.subtopic))];
---
<Base title="AQA A-Level DT Flashcards | Product Design 7552" description="Revise AQA A-Level Product Design 7552 with topic-based active recall flashcards built from the revision notes."><main class="page"><header><span class="eyebrow">ACTIVE RECALL · AQA 7552</span><h1>Flashcards<span>.</span></h1><p>Recall the answer before revealing it. Mark difficult cards and come back to them.</p></header><section class="library"><div class="library-head"><span>FLASHCARD LIBRARY</span><h2>What do you want to revise?</h2><p>Choose a subtopic and work through its cards one at a time.</p></div><div class="paper-tabs">{syllabus.map(g => <div class="paper"><h3>{g.code} · {g.title}</h3><div class="decks">{g.topics.flatMap(([code,t,subs])=>subs.map(s=>{const key=code+'::'+s;const ready=available.includes(key);const count=flashcards.filter(x=>x.topic===code&&x.subtopic===s).length;return <button type="button" class:list={['deck',{unavailable:!ready}]} data-value={key} disabled={!ready}><span>{code}</span><strong>{s}</strong><small>{ready?`${count} card${count===1?'':'s'}`:'Coming soon'}</small></button>}))}</div></div>)}</div></section><input type="hidden" id="pick" /><section class="card" id="card" hidden><div class="card-label">ACTIVE RECALL</div><div class="count" id="count"></div><h2 id="front"></h2><div id="back" class="back" hidden></div><button class="reveal" id="reveal">Reveal answer</button><div class="rate" id="rate" hidden><button data-rate="again">Again</button><button data-rate="hard">Hard</button><button data-rate="got">Got it</button></div></section></main><script define:vars={{cards:flashcards}}>
let bank=[],i=0;const pick=document.querySelector('#pick'),card=document.querySelector('#card'),front=document.querySelector('#front'),back=document.querySelector('#back'),count=document.querySelector('#count'),rate=document.querySelector('#rate'),reveal=document.querySelector('#reveal');function show(){let x=bank[i];front.textContent=x.front;back.textContent=x.back;back.hidden=true;rate.hidden=true;reveal.hidden=false;count.textContent=(i+1)+' / '+bank.length;card.hidden=false}function startDeck(value){pick.value=value;bank=cards.filter(x=>x.topic+'::'+x.subtopic===value);i=0;if(bank.length){show();card.scrollIntoView({behavior:'smooth',block:'center'})}}document.querySelectorAll('.deck:not(.unavailable)').forEach(b=>b.onclick=()=>{document.querySelectorAll('.deck').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');startDeck(b.dataset.value)});const requested=new URLSearchParams(location.search).get('topic');if(requested){const b=[...document.querySelectorAll('.deck')].find(x=>x.dataset.value===requested&&!x.disabled);if(b)b.click()}reveal.onclick=()=>{back.hidden=false;rate.hidden=false;reveal.hidden=true};rate.querySelectorAll('button').forEach(b=>b.onclick=()=>{if(b.dataset.rate!=='got')bank.push(bank[i]);i++;if(i>=bank.length){front.textContent='Set complete.';back.hidden=true;rate.hidden=true;count.textContent='Nice work';return}show()});
</script></Base><style>
.page{padding:48px clamp(24px,7vw,110px) 90px;background:#fbf8f5;min-height:100vh}.page header{max-width:800px}.page h1{font-size:clamp(48px,6vw,80px);margin:10px 0}.page h1 span{color:#9c61b9}.page header p{font-size:18px;color:#6d6074}.library{margin:36px 0 42px;background:#fff;border:1px solid #e6dce8;border-radius:18px;overflow:hidden}.library-head{padding:28px 30px;background:linear-gradient(105deg,#f3e9fa,#f9eef5 65%,#faf6f0);border-bottom:1px solid #eadfec}.library-head>span,.card-label{font-size:9px;letter-spacing:.14em;font-weight:800;color:#8855a3}.library-head h2{font-size:27px;margin:7px 0 5px}.library-head p{margin:0;color:#74677a;font-size:14px}.paper-tabs{padding:28px 30px}.paper+.paper{margin-top:32px;padding-top:28px;border-top:1px solid #eee6ef}.paper h3{font-size:17px;margin:0 0 15px;color:#3d2351}.decks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.deck{display:grid;gap:5px;text-align:left;padding:16px!important;border:1px solid #e4d9e7!important;border-radius:11px!important;background:#fdfbfe!important;color:#3d2a49!important;cursor:pointer}.deck:hover:not(:disabled),.deck.selected{border-color:#9c6bb5!important;background:#f3e8f8!important;transform:translateY(-1px)}.deck>span{font-size:9px;color:#8d62a3;font-weight:800}.deck strong{font-size:14px}.deck small{font-size:10px;color:#8a7d8e}.deck.unavailable{opacity:.38;cursor:not-allowed}.card{max-width:950px;background:#fff;border:1px solid #e6dbe9;border-radius:18px;padding:clamp(30px,5vw,65px);box-shadow:0 12px 35px #4422520a}.count{font-size:11px;font-weight:800;color:#966bad;margin-top:10px}.card h2{font-size:clamp(28px,4vw,45px);margin:25px 0}.back{font-size:20px;line-height:1.7;background:linear-gradient(110deg,#f2e7f8,#fff8ef);padding:25px;border-radius:12px;margin-bottom:20px}.reveal,.rate button{border:0;border-radius:7px;background:#482166;color:#fff;padding:14px 20px;font-weight:800;cursor:pointer}.rate{display:flex;gap:10px}.rate button:nth-child(1){background:#f4e9ec;color:#743548}.rate button:nth-child(2){background:#f6ecdc;color:#81551c}.rate button:nth-child(3){background:#593199}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}@media(max-width:900px){.decks{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.page{padding:35px 20px 70px}.paper-tabs,.library-head{padding:22px}.decks{grid-template-columns:1fr}.rate{display:grid}}
</style>