<Base title="AQA A-Level DT Flashcards | Product Design 7552" description="Revise AQA A-Level Product Design 7552 with topic-based active recall flashcards built from the revision notes."><main class="page"><header><span class="eyebrow">ACTIVE RECALL · AQA 7552</span><h1>Flashcards<span>.</span></h1><p>Recall the answer before revealing it. Mark difficult cards and come back to them.</p></header><section class="library"><div class="library-head"><span>FLASHCARD LIBRARY</span><h2>What do you want to revise?</h2><p>Choose a subtopic and work through its cards one at a time.</p></div><div class="paper-tabs">{syllabus.map(g => <div class="paper"><h3>{g.code} · {g.title}</h3><div class="decks">{g.topics.flatMap(([code,t,subs])=>subs.map(s=>{const key=code+'::'+s;const ready=available.includes(key);const count=flashcards.filter(x=>x.topic===code&&x.subtopic===s).length;return <button type="button" class:list={['deck',{unavailable:!ready}]} data-value={key} disabled={!ready}><span>{code}</span><strong>{s}</strong><small>{ready?`${count} card${count===1?'':'s'}`:'Coming soon'}</small></button>}))}</div></div>)}</div></section><input type="hidden" id="pick" /><section class="study" id="card" hidden><div class="study-top"><button class="back-decks" id="back-decks">← Choose another topic</button><div class="progress"><span id="count"></span><div class="progress-track"><i id="progress-bar"></i></div></div></div><div class="flip-card" id="flip-card"><div class="card-label">QUESTION</div><h2 id="front"></h2><div id="back" class="back" hidden><span>ANSWER</span><p id="back-text"></p></div><button class="reveal" id="reveal">Reveal answer</button></div><div class="rate" id="rate" hidden><span>How well did you know it?</span><div><button data-rate="again">Again</button><button data-rate="hard">Hard</button><button data-rate="got">Got it</button></div></div></section></main><script define:vars={{cards:flashcards}}>
let bank=[],i=0;const pick=document.querySelector('#pick'),card=document.querySelector('#card'),front=document.querySelector('#front'),back=document.querySelector('#back'),count=document.querySelector('#count'),progress=document.querySelector('#progress-bar'),backText=document.querySelector('#back-text'),rate=document.querySelector('#rate'),reveal=document.querySelector('#reveal');function show(){let x=bank[i];front.textContent=x.front;backText.textContent=x.back;back.hidden=true;rate.hidden=true;reveal.hidden=false;count.textContent=(i+1)+' of '+bank.length;progress.style.width=((i+1)/bank.length*100)+'%';card.hidden=false}function startDeck(value){pick.value=value;bank=cards.filter(x=>value.includes('::')?x.topic+'::'+x.subtopic===value:x.topic===value);i=0;if(bank.length){show();card.scrollIntoView({behavior:'smooth',block:'center'})}}document.querySelectorAll('.deck:not(.unavailable)').forEach(b=>b.onclick=()=>{document.querySelectorAll('.deck').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');startDeck(b.dataset.value)});const requested=new URLSearchParams(location.search).get('topic');if(requested){const b=[...document.querySelectorAll('.deck')].find(x=>x.dataset.value===requested&&!x.disabled);if(b)b.click();else if(requested&&!requested.includes('::'))startDeck(requested)}reveal.onclick=()=>{back.hidden=false;rate.hidden=false;reveal.hidden=true};rate.querySelectorAll('button').forEach(b=>b.onclick=()=>{if(b.dataset.rate!=='got')bank.push(bank[i]);i++;if(i>=bank.length){front.textContent='Set complete.';back.hidden=true;reveal.hidden=true;rate.hidden=true;count.textContent='Complete';progress.style.width='100%';return}show()});
document.querySelector('#back-decks').onclick=()=>{card.hidden=true;document.querySelector('.library').scrollIntoView({behavior:'smooth',block:'start'})};
</script></Base><style>
.page{padding:48px clamp(24px,6vw,92px) 90px;background:#fbf8f5;min-height:100vh}.page>header{max-width:800px}.page h1{font-size:clamp(48px,6vw,76px);margin:10px 0}.page h1 span{color:#9c61b9}.page>header p{font-size:18px;color:#6d6074}.eyebrow,.library-head>span,.card-label{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}.library{margin:36px 0 42px;background:#fff;border:1px solid #e6dce8;border-radius:16px;overflow:hidden}.library-head{padding:26px 30px;background:#f8f1fa;border-bottom:1px solid #eadfec}.library-head h2{font-size:26px;margin:7px 0 4px}.library-head p{margin:0;color:#74677a;font-size:14px}.paper-tabs{padding:28px 30px}.paper+.paper{margin-top:30px;padding-top:26px;border-top:1px solid #eee6ef}.paper h3{font-size:17px;margin:0 0 14px;color:#3d2351}.decks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.deck{display:grid;gap:5px;text-align:left;padding:15px!important;border:1px solid #e4d9e7!important;border-radius:10px!important;background:#fff!important;color:#3d2a49!important;cursor:pointer;min-height:88px}.deck:hover:not(:disabled),.deck.selected{border-color:#8f5baa!important;background:#f7effa!important}.deck>span{font-size:9px;color:#8d62a3;font-weight:800}.deck strong{font-size:14px;line-height:1.3}.deck small{font-size:10px;color:#8a7d8e}.deck.unavailable{opacity:.3;cursor:not-allowed}.study{max-width:900px;margin:0 auto;padding-top:8px}.study-top{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:16px}.back-decks{border:0;background:none;color:#714590;font-weight:750;cursor:pointer;padding:8px 0}.progress{display:flex;align-items:center;gap:12px;color:#7d6c84;font-size:12px;font-weight:700}.progress-track{width:150px;height:5px;border-radius:10px;background:#e9e0eb;overflow:hidden}.progress-track i{display:block;height:100%;width:0;background:#77449a;border-radius:10px;transition:width .2s}.flip-card{background:#fff;border:1px solid #dfd3e4;border-radius:16px;padding:clamp(36px,5vw,62px);min-height:360px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;box-shadow:0 10px 28px #4422520a}.flip-card h2{font-size:clamp(28px,3.5vw,42px);line-height:1.18;margin:18px 0 30px;max-width:760px}.back{width:100%;border-top:1px solid #e9dfea;padding:24px 0 2px;margin:0 0 24px}.back span{font-size:9px;letter-spacing:.14em;font-weight:800;color:#9463ad}.back p{font-size:19px;line-height:1.65;color:#51465a;margin:8px 0 0}.reveal{border:0;border-radius:8px;background:#482166;color:#fff;padding:13px 18px;font-weight:800;cursor:pointer}.rate{margin-top:14px;background:#f7f1f8;border:1px solid #e6dce8;border-radius:12px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:15px}.rate[hidden]{display:none}.rate>span{font-size:12px;font-weight:700;color:#66566e}.rate>div{display:flex;gap:8px}.rate button{border:1px solid #dfd3e4;border-radius:7px;background:#fff;color:#553764;padding:10px 16px;font-weight:800;cursor:pointer}.rate button[data-rate="got"]{background:#593199;color:#fff;border-color:#593199}@media(max-width:900px){.decks{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.page{padding:35px 20px 70px}.paper-tabs,.library-head{padding:22px}.decks{grid-template-columns:1fr}.study-top,.rate{align-items:stretch;flex-direction:column}.progress{justify-content:space-between}.progress-track{flex:1}.rate>div{display:grid;grid-template-columns:repeat(3,1fr)}.flip-card{min-height:330px;padding:30px 24px}}
