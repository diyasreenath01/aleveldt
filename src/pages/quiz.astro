---
import Base from '../layouts/Base.astro';
import { syllabus, subtopicSlug } from '../data/syllabus.js';
import { quizQuestions as authoredQuestions } from '../data/quizQuestions.js';

const noteFiles = import.meta.glob('../content/subtopics/**/*.md', { query: '?raw', import: 'default', eager: true });
const clean = (s='') => s.replace(/<br\s*\/?\s*>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&amp;/g,'&').replace(/&nbsp;/g,' ').replace(/&#39;/g,"'").replace(/&quot;/g,'"').replace(/\s+/g,' ').trim();
const stripComments = (s='') => s.replace(/<!--[\s\S]*?-->/g,'');
const generatedQuestions = [];
for (const [filePath, rawValue] of Object.entries(noteFiles)) {
  const raw = stripComments(String(rawValue || ''));
  if (!raw.trim()) continue;
  const match = filePath.match(/subtopics\/([^/]+)\/(.+)\.md$/);
  if (!match) continue;
  const [, code, slug] = match;
  const topicRow = syllabus.flatMap(g => g.topics).find(([c]) => c === code);
  const subtopic = topicRow?.[2].find(name => subtopicSlug(name) === slug);
  if (!subtopic) continue;

  const blocks = [...raw.matchAll(/<div class="study-card"><h[34]>([\s\S]*?)<\/h[34]>([\s\S]*?)<\/div>/gi)];
  for (const block of blocks) {
    const heading = clean(block[1]);
    const body = block[2];
    const facts = [...body.matchAll(/<(?:li|p)[^>]*>([\s\S]*?)<\/(?:li|p)>/gi)].map(x => clean(x[1])).filter(x => x.length > 8);
    const fallback = clean(body);
    const points = facts.length ? facts : (fallback ? [fallback] : []);
    if (!heading || !points.length) continue;
    generatedQuestions.push({topic:code,subtopic,marks:Math.min(8,Math.max(2,points.length)),type:points.length>=4?'Explain':'Recall',question:`Explain what you need to know about ${heading}.`,points});
  }

  const intros = [...raw.matchAll(/<section class="note-panel"><h2>([\s\S]*?)<\/h2>[\s\S]*?<div class="note-intro">([\s\S]*?)<\/div>/gi)];
  for (const intro of intros) {
    const heading=clean(intro[1]), facts=[...intro[2].matchAll(/<p[^>]*>([\s\S]*?)<\/p>/gi)].map(x=>clean(x[1])).filter(x=>x.length>8);
    if (heading && facts.length) generatedQuestions.push({topic:code,subtopic,marks:Math.min(6,Math.max(2,facts.length)),type:'Recall',question:`Explain ${heading}.`,points:facts});
  }
}
const signature = q => [q.topic,q.subtopic,q.question].join('|').toLowerCase();
const seen = new Set();
const quizQuestions = [...authoredQuestions, ...generatedQuestions].filter(q => { const k=signature(q); if(seen.has(k)) return false; seen.add(k); return true; });
const topicCounts = Object.fromEntries(syllabus.flatMap(g=>g.topics).map(([code])=>[code,quizQuestions.filter(q=>q.topic===code).length]));
---
<Base title="AQA A-Level DT Quiz | Product Design 7552" description="Test AQA A-Level Product Design knowledge with topic-based recall, application and exam-style revision questions."><main class="quiz"><header><span class="eyebrow">ACTIVE RECALL · AQA 7552</span><h1>Quiz mode<span>.</span></h1><p>Practise recall, application and exam-style questions tied to the specification.</p></header><section class="setup"><div class="choose"><span>CHOOSE A TOPIC</span><p class="choose-copy">Each quiz mixes questions from every completed subtopic and note in that topic.</p><div class="topic-list">{syllabus.map(g => (<div class="paper-group"><h2>{g.code} · {g.title}</h2>{g.topics.map(([code,title]) => { const count=topicCounts[code]||0; return (<button type="button" class:list={['whole-topic',{unavailable:!count}]} data-value={code} disabled={!count}><span><small>{code}</small><strong>{title}</strong></span><b>{count ? `${count} questions` : 'Coming soon'} →</b></button>); })}</div>))}</div><input type="hidden" id="topic-select" /></div></section><section id="quiz-card" class="card" hidden><div class="quiz-progress"><span id="progress-text">Question 1 of 1</span><div><i id="progress-bar"></i></div></div><div class="qmeta"><span id="qtype"></span><strong id="qmarks"></strong></div><h2 id="question"></h2><textarea id="answer" rows="7" placeholder="Write your answer here..."></textarea><div class="actions"><button id="submit">Submit answer</button><button id="next" hidden>Next question →</button></div><div id="feedback" hidden><span id="feedback-title">CHECK YOUR ANSWER</span><p id="feedback-copy"></p><div id="markscheme"><span>MARK POINTS</span><ul id="points"></ul><p>Compare your answer with these key ideas. Your wording does not need to be identical.</p></div></div><div id="complete" hidden><span>QUIZ COMPLETE</span><h3>Topic complete.</h3><p>You reached the end of this quiz.</p><button id="restart">Try again ↻</button></div></section></main><script define:vars={{questions:quizQuestions}}>
const s=document.querySelector('#topic-select'),c=document.querySelector('#quiz-card'),q=document.querySelector('#question'),t=document.querySelector('#qtype'),m=document.querySelector('#qmarks'),p=document.querySelector('#points'),a=document.querySelector('#answer'),submit=document.querySelector('#submit'),next=document.querySelector('#next'),feedback=document.querySelector('#feedback'),feedbackCopy=document.querySelector('#feedback-copy'),progressText=document.querySelector('#progress-text'),progressBar=document.querySelector('#progress-bar'),complete=document.querySelector('#complete'),restart=document.querySelector('#restart');let bank=[],i=0;
function normal(v){return (v||'').toLowerCase().replace(/[^a-z0-9%]+/g,' ').trim()}
function show(){const x=bank[i];if(!x)return;q.textContent=x.question;t.textContent=x.type;m.textContent=x.marks+' marks';p.innerHTML=x.points.map(v=>'<li>'+v+'</li>').join('');a.value='';a.disabled=false;feedback.hidden=true;complete.hidden=true;submit.hidden=false;next.hidden=true;progressText.textContent='Question '+(i+1)+' of '+bank.length;progressBar.style.width=((i+1)/bank.length*100)+'%';c.hidden=false;c.scrollIntoView({behavior:'smooth',block:'start'})}
function begin(value){s.value=value;bank=questions.filter(x=>value.includes('::')?x.topic+'::'+x.subtopic===value:x.topic===value).sort(()=>Math.random()-.5);i=0;if(bank.length)show()}
document.querySelectorAll('.whole-topic:not(.unavailable)').forEach(b=>b.onclick=()=>begin(b.dataset.value));
const requested=new URLSearchParams(location.search).get('topic');if(requested){begin(requested)}
submit.onclick=()=>{const x=bank[i],ans=normal(a.value);if(!ans){a.focus();return}const hits=x.points.filter(pt=>{const words=normal(pt).split(' ').filter(w=>w.length>4);return words.some(w=>ans.includes(w))}).length;a.disabled=true;feedback.hidden=false;feedbackCopy.textContent=hits>=Math.max(1,Math.ceil(x.points.length/2))?'Your answer includes some of the expected ideas. Check it against the mark points below.':'Compare your answer carefully with the mark points below and add any key ideas you missed.';submit.hidden=true;next.hidden=false;next.textContent=i===bank.length-1?'Finish quiz →':'Next question →';feedback.scrollIntoView({behavior:'smooth',block:'nearest'})};
next.onclick=()=>{if(i<bank.length-1){i++;show()}else{feedback.hidden=true;submit.hidden=true;next.hidden=true;a.hidden=true;q.hidden=true;document.querySelector('.qmeta').hidden=true;complete.hidden=false;progressText.textContent='Completed '+bank.length+' of '+bank.length;progressBar.style.width='100%'}};
restart.onclick=()=>{a.hidden=false;q.hidden=false;document.querySelector('.qmeta').hidden=false;bank.sort(()=>Math.random()-.5);i=0;show()};
</script></Base><style>.quiz{padding:48px clamp(24px,7vw,110px) 90px;background:#fbf8f5;min-height:100vh}.quiz header{max-width:820px}.quiz h1{font-size:clamp(48px,6vw,80px);margin:10px 0}.quiz h1 span{color:#9c61b9}.quiz header p{font-size:18px;color:#6d6074}.setup{margin:35px 0;background:#fff;border:1px solid #e8dfea;border-radius:16px;padding:28px}.choose>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}.choose-copy{font-size:13px;color:#76677d;margin:8px 0 22px}.topic-list{display:grid;gap:28px;margin:18px 0 8px}.paper-group{border-top:1px solid #eee5ef;padding-top:18px}.paper-group:first-child{border-top:0;padding-top:0}.paper-group>h2{font-size:22px;margin:0 0 18px;color:#32194a}.whole-topic{width:100%;display:flex;justify-content:space-between;align-items:center;gap:20px;border:1px solid #e1d6e5;background:#fdfafd;color:#3f2850;padding:17px 18px;border-radius:10px;margin:8px 0;text-align:left;cursor:pointer}.whole-topic:hover:not(:disabled){border-color:#81539d;background:#f2e7f7}.whole-topic span{display:grid;gap:3px}.whole-topic small{font-size:9px;color:#8a64a0;font-weight:800}.whole-topic strong{font-size:15px}.whole-topic b{font-size:10px;color:#81539d;white-space:nowrap}.whole-topic.unavailable{opacity:.4;cursor:not-allowed}.setup> .choose>button,.actions button{border:0;border-radius:7px;background:#482166;color:#fff;padding:14px 20px;font-weight:800;cursor:pointer}.card{background:#fff;border:1px solid #e6dbe9;border-radius:17px;padding:clamp(25px,4vw,48px);box-shadow:0 10px 30px #4422520a;scroll-margin-top:20px}.quiz-progress{margin-bottom:24px}.quiz-progress>span{font-size:11px;font-weight:800;color:#76528b}.quiz-progress>div{height:5px;background:#eee5f1;border-radius:99px;margin-top:9px;overflow:hidden}.quiz-progress i{display:block;height:100%;width:0;background:#75469c;border-radius:99px;transition:width .25s}.qmeta{display:flex;justify-content:space-between;color:#8554a2;font-size:11px;font-weight:800}.card h2{font-size:clamp(25px,3vw,38px);max-width:900px;margin:22px 0}.card textarea{width:100%;border:1px solid #ded3e3;border-radius:10px;padding:18px;font:500 17px 'DM Sans';resize:vertical;background:#fdfafd}.actions{display:flex;gap:10px;margin-top:14px}.actions button:first-child{background:#482166;color:#fff}#feedback{margin-top:24px}#feedback>span,#complete>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}#feedback-copy{font-size:14px;color:#66586d;line-height:1.55}#complete{margin-top:24px;background:linear-gradient(110deg,#f1e6f8,#fff8ef);border:1px solid #e7d9ea;border-radius:12px;padding:28px}#complete h3{font-size:28px;margin:8px 0}#complete button{border:0;border-radius:7px;background:#482166;color:#fff;padding:12px 16px;font-weight:800;cursor:pointer}#markscheme{margin-top:28px;background:linear-gradient(110deg,#f1e6f8,#fff8ef);border:1px solid #e7d9ea;border-radius:12px;padding:24px}#markscheme>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}#markscheme li{margin:10px 0;line-height:1.55}#markscheme p{font-size:11px;color:#77697d}@media(max-width:650px){.quiz{padding:35px 20px 70px}.setup,.actions{display:grid}}</style>