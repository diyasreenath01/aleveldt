---
import Base from '../layouts/Base.astro';import { syllabus } from '../data/syllabus.js';import { quizQuestions } from '../data/quizQuestions.js';const available=[...new Set(quizQuestions.map(q=>q.topic+'::'+q.subtopic))];
---
<Base title="AQA A-Level DT Quiz | Product Design 7552" description="Test AQA A-Level Product Design knowledge with topic-based recall, application and exam-style revision questions."><main class="quiz"><header><span class="eyebrow">ACTIVE RECALL · AQA 7552</span><h1>Quiz mode<span>.</span></h1><p>Practise recall, application and exam-style questions tied to the specification.</p></header><section class="setup"><label>Choose a subtopic<select id="topic-select">{syllabus.flatMap(g=>g.topics.flatMap(([code,title,subs])=>subs.map(sub=><option value={code+'::'+sub} disabled={!available.includes(code+'::'+sub)}>{code} · {sub}{!available.includes(code+'::'+sub)?' — coming soon':''}</option>)))}</select></label><button id="start">Start quiz →</button></section><section id="quiz-card" class="card" hidden><div class="qmeta"><span id="qtype"></span><strong id="qmarks"></strong></div><h2 id="question"></h2><textarea id="answer" rows="7" placeholder="Write your answer here..."></textarea><div class="actions"><button id="reveal">Show mark points</button><button id="next">Next question →</button></div><div id="markscheme" hidden><span>MARK POINTS</span><ul id="points"></ul><p>Use these as the key ideas your answer should contain. Your wording does not need to be identical.</p></div></section></main><script define:vars={{questions:quizQuestions}}>
const s=document.querySelector('#topic-select'),c=document.querySelector('#quiz-card'),q=document.querySelector('#question'),t=document.querySelector('#qtype'),m=document.querySelector('#qmarks'),p=document.querySelector('#points'),mks=document.querySelector('#markscheme'),a=document.querySelector('#answer');let bank=[],i=0;function show(){let x=bank[i];q.textContent=x.question;t.textContent=x.type;m.textContent=x.marks+' marks';p.innerHTML=x.points.map(v=>'<li>'+v+'</li>').join('');mks.hidden=true;a.value='';c.hidden=false;c.scrollIntoView({behavior:'smooth',block:'start'})}document.querySelector('#start').onclick=()=>{bank=questions.filter(x=>x.topic+'::'+x.subtopic===s.value).sort(()=>Math.random()-.5);i=0;if(bank.length)show()};document.querySelector('#reveal').onclick=()=>mks.hidden=!mks.hidden;document.querySelector('#next').onclick=()=>{i=(i+1)%bank.length;show()};
</script></Base><style>.quiz{padding:48px clamp(24px,7vw,110px) 90px;background:#fbf8f5;min-height:100vh}.quiz header{max-width:820px}.quiz h1{font-size:clamp(48px,6vw,80px);margin:10px 0}.quiz h1 span{color:#9c61b9}.quiz header p{font-size:18px;color:#6d6074}.setup{display:flex;align-items:end;gap:14px;margin:35px 0;background:#fff;border:1px solid #e8dfea;border-radius:14px;padding:24px}.setup label{display:grid;gap:8px;flex:1;font-size:11px;font-weight:800;color:#69447f}.setup select{width:100%;padding:13px;border:1px solid #ded2e4;border-radius:7px;background:#fff;font:600 14px 'DM Sans'}.setup button,.actions button{border:0;border-radius:7px;background:#482166;color:#fff;padding:14px 20px;font-weight:800;cursor:pointer}.card{background:#fff;border:1px solid #e6dbe9;border-radius:17px;padding:clamp(25px,4vw,48px);box-shadow:0 10px 30px #4422520a;scroll-margin-top:20px}.qmeta{display:flex;justify-content:space-between;color:#8554a2;font-size:11px;font-weight:800}.card h2{font-size:clamp(25px,3vw,38px);max-width:900px;margin:22px 0}.card textarea{width:100%;border:1px solid #ded3e3;border-radius:10px;padding:18px;font:500 17px 'DM Sans';resize:vertical;background:#fdfafd}.actions{display:flex;gap:10px;margin-top:14px}.actions button:first-child{background:#eee1f5;color:#52276d}#markscheme{margin-top:28px;background:linear-gradient(110deg,#f1e6f8,#fff8ef);border:1px solid #e7d9ea;border-radius:12px;padding:24px}#markscheme>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}#markscheme li{margin:10px 0;line-height:1.55}#markscheme p{font-size:11px;color:#77697d}@media(max-width:650px){.quiz{padding:35px 20px 70px}.setup,.actions{display:grid}}</style>