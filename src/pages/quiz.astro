---
import Base from '../layouts/Base.astro';import { syllabus } from '../data/syllabus.js';import { quizQuestions } from '../data/quizQuestions.js';const available=[...new Set(quizQuestions.map(q=>q.topic+'::'+q.subtopic))];
---
<Base title="AQA A-Level DT Quiz | Product Design 7552" description="Test AQA A-Level Product Design knowledge with topic-based recall, application and exam-style revision questions."><main class="quiz"><header><span class="eyebrow">ACTIVE RECALL · AQA 7552</span><h1>Quiz mode<span>.</span></h1><p>Practise recall, application and exam-style questions tied to the specification.</p></header><section class="setup"><div class="choose"><span>CHOOSE A TOPIC</span><div class="topic-list">{syllabus.map(g => <div class="paper-group"><h2>{g.code} · {g.title}</h2>{g.topics.map(([code,title,subs]) => <div class="topic-group"><h3>{code} · {title}</h3><div class="subtopics">{subs.map(sub => { const key=code+'::'+sub; const ready=available.includes(key); return <button type="button" class:list={['topic-choice',{unavailable:!ready}]} data-value={key} disabled={!ready}>{sub}{!ready && <small>Coming soon</small>}</button> })}</div></div>)}</div>)}</div><input type="hidden" id="topic-select" /><button id="start" disabled>Start quiz →</button></div></section><section id="quiz-card" class="card" hidden><div class="quiz-progress"><span id="progress-text">Question 1 of 1</span><div><i id="progress-bar"></i></div></div><div class="qmeta"><span id="qtype"></span><strong id="qmarks"></strong></div><h2 id="question"></h2><textarea id="answer" rows="7" placeholder="Write your answer here..."></textarea><div class="actions"><button id="submit">Submit answer</button><button id="next" hidden>Next question →</button></div><div id="feedback" hidden><span id="feedback-title">CHECK YOUR ANSWER</span><p id="feedback-copy"></p><div id="markscheme"><span>MARK POINTS</span><ul id="points"></ul><p>Compare your answer with these key ideas. Your wording does not need to be identical.</p></div></div><div id="complete" hidden><span>QUIZ COMPLETE</span><h3>Topic complete.</h3><p>You reached the end of this quiz.</p><button id="restart">Try again ↻</button></div></section></main><script define:vars={{questions:quizQuestions}}>
const s=document.querySelector('#topic-select'),start=document.querySelector('#start'),c=document.querySelector('#quiz-card'),q=document.querySelector('#question'),t=document.querySelector('#qtype'),m=document.querySelector('#qmarks'),p=document.querySelector('#points'),a=document.querySelector('#answer'),submit=document.querySelector('#submit'),next=document.querySelector('#next'),feedback=document.querySelector('#feedback'),feedbackCopy=document.querySelector('#feedback-copy'),progressText=document.querySelector('#progress-text'),progressBar=document.querySelector('#progress-bar'),complete=document.querySelector('#complete'),restart=document.querySelector('#restart');let bank=[],i=0;
function normal(v){return (v||'').toLowerCase().replace(/[^a-z0-9%]+/g,' ').trim()}
function show(){const x=bank[i];if(!x)return;q.textContent=x.question;t.textContent=x.type;m.textContent=x.marks+' marks';p.innerHTML=x.points.map(v=>'<li>'+v+'</li>').join('');a.value='';a.disabled=false;feedback.hidden=true;complete.hidden=true;submit.hidden=false;next.hidden=true;progressText.textContent='Question '+(i+1)+' of '+bank.length;progressBar.style.width=((i+1)/bank.length*100)+'%';c.hidden=false;c.scrollIntoView({behavior:'smooth',block:'start'})}
function begin(value){s.value=value;bank=questions.filter(x=>value.includes('::')?x.topic+'::'+x.subtopic===value:x.topic===value).sort(()=>Math.random()-.5);i=0;if(bank.length)show()}
document.querySelectorAll('.topic-choice:not(.unavailable)').forEach(b=>b.onclick=()=>{document.querySelectorAll('.topic-choice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');begin(b.dataset.value)});
const requested=new URLSearchParams(location.search).get('topic');if(requested){begin(requested)}
start.onclick=()=>begin(s.value);
submit.onclick=()=>{const x=bank[i],ans=normal(a.value);if(!ans){a.focus();return}const hits=x.points.filter(pt=>{const words=normal(pt).split(' ').filter(w=>w.length>4);return words.some(w=>ans.includes(w))}).length;a.disabled=true;feedback.hidden=false;feedbackCopy.textContent=hits>=Math.max(1,Math.ceil(x.points.length/2))?'Your answer includes some of the expected ideas. Check it against the mark points below.':'Compare your answer carefully with the mark points below and add any key ideas you missed.';submit.hidden=true;next.hidden=false;next.textContent=i===bank.length-1?'Finish quiz →':'Next question →';feedback.scrollIntoView({behavior:'smooth',block:'nearest'})};
next.onclick=()=>{if(i<bank.length-1){i++;show()}else{feedback.hidden=true;submit.hidden=true;next.hidden=true;a.hidden=true;q.hidden=true;document.querySelector('.qmeta').hidden=true;complete.hidden=false;progressText.textContent='Completed '+bank.length+' of '+bank.length;progressBar.style.width='100%'}};
restart.onclick=()=>{a.hidden=false;q.hidden=false;document.querySelector('.qmeta').hidden=false;bank.sort(()=>Math.random()-.5);i=0;show()};
</script></Base><style>.quiz{padding:48px clamp(24px,7vw,110px) 90px;background:#fbf8f5;min-height:100vh}.quiz header{max-width:820px}.quiz h1{font-size:clamp(48px,6vw,80px);margin:10px 0}.quiz h1 span{color:#9c61b9}.quiz header p{font-size:18px;color:#6d6074}.setup{margin:35px 0;background:#fff;border:1px solid #e8dfea;border-radius:16px;padding:28px}.choose>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}.topic-list{display:grid;gap:24px;margin:18px 0 24px}.paper-group{border-top:1px solid #eee5ef;padding-top:18px}.paper-group:first-child{border-top:0;padding-top:0}.paper-group>h2{font-size:22px;margin:0 0 18px;color:#32194a}.topic-group{margin:0 0 20px}.topic-group h3{font-size:13px;margin:0 0 9px;color:#65546e}.subtopics{display:flex;flex-wrap:wrap;gap:8px}.topic-choice{border:1px solid #dfd3e4!important;background:#fbf8fd!important;color:#4f3560!important;padding:10px 13px!important;border-radius:8px!important;font-size:12px;font-weight:700!important;text-align:left}.topic-choice:hover:not(:disabled),.topic-choice.selected{border-color:#75469c!important;background:#eee1f5!important;color:#482166!important}.topic-choice small{display:block;font-size:8px;color:#9a8d9f;margin-top:2px}.topic-choice.unavailable{opacity:.42;cursor:not-allowed}.setup> .choose>button,.actions button{border:0;border-radius:7px;background:#482166;color:#fff;padding:14px 20px;font-weight:800;cursor:pointer}.card{background:#fff;border:1px solid #e6dbe9;border-radius:17px;padding:clamp(25px,4vw,48px);box-shadow:0 10px 30px #4422520a;scroll-margin-top:20px}.quiz-progress{margin-bottom:24px}.quiz-progress>span{font-size:11px;font-weight:800;color:#76528b}.quiz-progress>div{height:5px;background:#eee5f1;border-radius:99px;margin-top:9px;overflow:hidden}.quiz-progress i{display:block;height:100%;width:0;background:#75469c;border-radius:99px;transition:width .25s}.qmeta{display:flex;justify-content:space-between;color:#8554a2;font-size:11px;font-weight:800}.card h2{font-size:clamp(25px,3vw,38px);max-width:900px;margin:22px 0}.card textarea{width:100%;border:1px solid #ded3e3;border-radius:10px;padding:18px;font:500 17px 'DM Sans';resize:vertical;background:#fdfafd}.actions{display:flex;gap:10px;margin-top:14px}.actions button:first-child{background:#482166;color:#fff}#feedback{margin-top:24px}#feedback>span,#complete>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}#feedback-copy{font-size:14px;color:#66586d;line-height:1.55}#complete{margin-top:24px;background:linear-gradient(110deg,#f1e6f8,#fff8ef);border:1px solid #e7d9ea;border-radius:12px;padding:28px}#complete h3{font-size:28px;margin:8px 0}#complete button{border:0;border-radius:7px;background:#482166;color:#fff;padding:12px 16px;font-weight:800;cursor:pointer}#markscheme{margin-top:28px;background:linear-gradient(110deg,#f1e6f8,#fff8ef);border:1px solid #e7d9ea;border-radius:12px;padding:24px}#markscheme>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#81539d}#markscheme li{margin:10px 0;line-height:1.55}#markscheme p{font-size:11px;color:#77697d}@media(max-width:650px){.quiz{padding:35px 20px 70px}.setup,.actions{display:grid}}</style>