---
import Base from '../../../layouts/Base.astro';
import { syllabus, subtopicPath } from '../../../data/syllabus.js';
import { hasSubtopicNotes, hasTopicNotes, paperName, paperPath } from '../../../data/contentStatus.js';

export function getStaticPaths() {
  return syllabus.map(group => ({ params: { paper: group.id === 'technical' ? 'paper-1' : 'paper-2' }, props: { group } }));
}
const { group } = Astro.props;
const paper = paperName(group);
const breadcrumbs = [{name:'A-levelDT',path:'/'},{name:'Revision notes',path:'/notes/'},{name:paper,path:paperPath(group)}];
---
<Base title={`${paper} AQA A-Level Product Design 7552 Notes | A-levelDT`} description={`${paper} ${group.title.toLowerCase()} revision for AQA A-Level Product Design (7552). Browse specification topics and read available notes for each subtopic.`} breadcrumbs={breadcrumbs}>
  <div class="paper-page"><nav class="crumb" aria-label="Breadcrumb"><a href="/">A-levelDT</a><span>›</span><a href="/notes/">Revision notes</a><span>›</span><span aria-current="page">{paper}</span></nav>
    <header><span class="eyebrow">AQA A-LEVEL PRODUCT DESIGN · 7552</span><h1>{paper}: {group.title}</h1><p>{paper === 'Paper 1' ? 'Technical principles' : 'Designing and making principles'} organised by the official specification. Choose a topic to read its notes, then practise with flashcards and quizzes.</p></header>
    <div class="topic-list">{group.topics.map(([code,title,subtopics]) => <section class="topic"><div><span>{code}</span>{hasTopicNotes(code) ? <h2><a href={`/notes/${code}/`}>{title}</a></h2> : <h2>{title}</h2>}<small>{subtopics.filter(name=>hasSubtopicNotes(code,name)).length} of {subtopics.length} subtopics with notes</small></div><ul>{subtopics.map(name => <li>{hasSubtopicNotes(code,name) ? <a href={subtopicPath(code,name)}>{name}</a> : <span>{name} · notes coming soon</span>}</li>)}</ul></section>)}</div>
    <p class="source">Check the <a href={group.source}>official AQA specification</a> for the complete assessment requirements.</p>
  </div>
</Base>
<style>.paper-page{padding:34px clamp(22px,6vw,90px) 90px;background:#fbf8f5}.crumb{display:flex;gap:10px;flex-wrap:wrap;color:#74647e;font-size:13px;margin-bottom:35px}.crumb a:hover,.source a{color:#63328b;text-decoration:underline}.paper-page header{max-width:900px;margin-bottom:40px}.paper-page h1{font-size:clamp(36px,5vw,65px);margin:12px 0}.paper-page header p{font-size:18px;color:#5f5269}.topic-list{display:grid;gap:18px}.topic{display:grid;grid-template-columns:minmax(200px,1fr) minmax(250px,1.5fr);gap:24px;border:1px solid #e7dcec;background:#fff;border-radius:14px;padding:26px}.topic>div>span{font-size:12px;font-weight:800;color:#8053a1}.topic h2{font-size:23px;margin:7px 0}.topic h2 a:hover,.topic li a:hover{color:#854eb0;text-decoration:underline}.topic small{color:#7c7083}.topic ul{margin:0;padding-left:20px;columns:2;column-gap:24px}.topic li{break-inside:avoid;margin-bottom:12px;line-height:1.4}.topic li a{font-weight:650}.topic li span{color:#877b8d}.source{margin-top:35px}@media(max-width:760px){.topic{display:block}.topic ul{columns:1;margin-top:18px}.topic{padding:20px}}</style>
