---
import Base from '../../../layouts/Base.astro';
import { syllabus, subtopicPath } from '../../../data/syllabus.js';
import { notes } from '../../../data/notes.js';
import { hasSubtopicNotes, paperName, paperPath } from '../../../data/contentStatus.js';

export function getStaticPaths() {
  return syllabus.flatMap(group => group.topics.map(([code, title, subtopics]) => ({
    params: { topic: code }, props: { group, code, title, subtopics }
  })));
}
const { group, code, title, subtopics } = Astro.props;
const seoTitle = `${code} ${title} | AQA Product Design 7552 Notes`;
const paper = paperName(group);
const paperURL = paperPath(group);
const extraReading = notes.filter(note => note.topic === code && note.slug !== 'materials-and-properties');
const availableCount = subtopics.filter(name => hasSubtopicNotes(code, name)).length;
const breadcrumbs = [{name:'A-levelDT',path:'/'},{name:'Revision notes',path:'/notes/'},{name:paper,path:paperURL},{name:title,path:`/notes/${code}/`}];
---
<Base title={seoTitle} description={`Revise ${code} ${title} for AQA A-Level Product Design 7552. Browse the complete specification structure and open the notes currently available.`} breadcrumbs={breadcrumbs}>
  <main class="page"><nav class="crumb" aria-label="Breadcrumb"><a href="/">A-levelDT</a> › <a href="/notes/">Revision notes</a> › <a href={paperURL}>{paper}</a> › <span aria-current="page">{title}</span></nav>
  <header><span class="eyebrow">AQA 7552 / {code}</span><h1>{title}<b>.</b></h1><p>{group.title}</p><small class="progress">{availableCount} of {subtopics.length} subtopic notes currently added</small></header>
  <nav class="contents" aria-label="Subtopics"><span>IN THIS TOPIC</span>{subtopics.map((name, i) => hasSubtopicNotes(code,name) ? <a href={subtopicPath(code,name)}>{name} <span>→</span></a> : <span class="pending-chip">{name} <small>not added yet</small></span>)}</nav>
  <div class="sections">{subtopics.map((name, i) => <section class={`section ${hasSubtopicNotes(code,name) ? '' : 'pending-section'}`}><div class="section-top"><span>{code} / {String(i+1).padStart(2,'0')}</span><h2>{hasSubtopicNotes(code,name) ? <a href={subtopicPath(code,name)}>{name}</a> : name}</h2></div>{hasSubtopicNotes(code,name) ? <><p>Read the {name.toLowerCase()} notes and revise this part of {title.toLowerCase()}.</p><div class="section-actions"><a class="detail" href={subtopicPath(code,name)}>Open the notes →</a></div></> : <p class="pending">Notes have not been added for this subtopic yet.</p>}</section>)}</div>
  {availableCount > 0 && <div class="topic-recall"><span>ACTIVE RECALL · {code}</span><h2>Think you have got this whole topic?</h2><p>Test the material currently available for <strong>{title}</strong>.</p><div><a href={`/quiz/?topic=${encodeURIComponent(code)}`}>Quiz the whole topic →</a><a href={`/flashcards/?topic=${encodeURIComponent(code)}`}>Flashcards for the whole topic →</a></div></div>}
  {extraReading.length > 0 && <nav class="related-reading" aria-label="Related reading"><h2>Related reading</h2>{extraReading.map(note => <a href={`/notes/${note.slug}/`}>{note.title} →</a>)}</nav>}<a class="spec" href={group.source} target="_blank" rel="noopener noreferrer">Check the AQA specification ↗</a></main>
</Base>
<style>
.page{background:#fbf8f5;padding:30px clamp(24px,4vw,76px) 85px;color:#291743}.crumb{display:flex;gap:10px;flex-wrap:wrap;color:#74647e;font-size:13px}.crumb a:hover,.section-top h2 a:hover{text-decoration:underline;color:#75469c}.page header{margin:45px 0 30px}.eyebrow,.contents>span,.section-top>span{font-size:12px;letter-spacing:.12em;font-weight:800;color:#8058a2}.page h1{font-size:clamp(44px,5vw,78px);letter-spacing:-.06em;margin:12px 0 4px}.page h1 b{color:#9d64bb}.page header p{color:#766982;margin:0;font-size:17px}.progress{display:block;margin-top:10px;color:#8a7b91}.contents{display:flex;flex-wrap:wrap;align-items:center;gap:9px;padding:20px 0 28px;border-top:1px solid #ded2e6;border-bottom:1px solid #ded2e6}.contents>span{width:100%;margin-bottom:5px}.contents a,.pending-chip{font-size:16px;padding:11px 15px;background:#fff;border:1px solid #e6ddeb;border-radius:5px;color:#593879}.contents a:hover{background:#f3e8fa}.contents a span{color:#9e78b2}.pending-chip{color:#8b7e91;background:#f7f3f7}.pending-chip small{font-size:10px;margin-left:5px;color:#a194a7}.sections{width:100%}.section{scroll-margin-top:22px;border-bottom:1px solid #ded2e6;padding:35px 0 45px}.section-top h2{font-size:clamp(30px,3vw,42px);letter-spacing:-.045em;margin:7px 0 20px}.section>p{font-size:17px;color:#6c5f73}.pending-section{opacity:.72}.pending{font-size:16px!important;color:#8b7e91!important}.section-actions{margin-top:8px}.detail,.spec{display:inline-block;font-size:15px;color:#75469c;font-weight:750;margin-top:16px}.spec{margin-top:30px}.topic-recall{margin:34px 0 8px;background:linear-gradient(110deg,#eee0f6,#fff3e7);border:1px solid #dfcee5;border-radius:16px;padding:clamp(26px,3vw,38px)}.topic-recall>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#8855a3}.topic-recall h2{font-size:clamp(27px,3vw,38px);letter-spacing:-.04em;margin:8px 0 10px}.topic-recall p{font-size:15px;line-height:1.6;color:#65586e;max-width:720px}.topic-recall div{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.topic-recall a{background:#482166;color:#fff;padding:12px 16px;border-radius:7px;font-size:12px;font-weight:800}.topic-recall a+a{background:#fff;color:#54286d;border:1px solid #ddcde4}.related-reading{margin-top:35px;display:grid;gap:12px}.related-reading a{color:#75469c;font-weight:700}.related-reading a:hover{text-decoration:underline}@media(max-width:650px){.page header{margin-top:32px}.section{padding:27px 0 35px}.topic-recall div{display:grid}.topic-recall a{text-align:center}}
</style>
