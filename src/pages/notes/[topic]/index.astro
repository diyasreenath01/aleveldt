---
import Base from '../../../layouts/Base.astro';
import { syllabus, subtopicPath, subtopicSlug } from '../../../data/syllabus.js';
import { notes } from '../../../data/notes.js';
import { quizQuestions } from '../../../data/quizQuestions.js';
import { hasSubtopicNotes, hasTopicNotes, paperName, paperPath } from '../../../data/contentStatus.js';

export function getStaticPaths() {
  return syllabus.flatMap(group => group.topics.filter(([code]) => hasTopicNotes(code)).map(([code, title, subtopics]) => ({
    params: { topic: code }, props: { group, code, title, subtopics }
  })));
}
const { group, code, title, subtopics } = Astro.props;
const seoTitle = `${code} ${title} | AQA Product Design 7552 Notes`;
const paper = paperName(group);
const paperURL = paperPath(group);
const extraReading = notes.filter(note => note.topic === code && note.slug !== 'materials-and-properties');
const breadcrumbs = [{name:'A-levelDT',path:'/'},{name:'Revision notes',path:'/notes/'},{name:paper,path:paperURL},{name:title,path:`/notes/${code}/`}];
const modules = import.meta.glob('../../../content/subtopics/**/*.md', { eager: true });
const sections = subtopics.filter(name => hasSubtopicNotes(code, name)).map(name => ({
  name,
  path: subtopicPath(code, name),
  Content: modules[`../../../content/subtopics/${code}/${subtopicSlug(name)}.md`]?.Content,
  related: notes.filter(note => note.topic === code && note.subtopic === name)
}));
---
<Base title={seoTitle} description={`Revise ${code} ${title} for AQA A-Level Product Design 7552. Browse available subtopic notes and practise with quizzes and flashcards.`} breadcrumbs={breadcrumbs}>
  <main class="page"><nav class="crumb" aria-label="Breadcrumb"><a href="/">A-levelDT</a> › <a href="/notes/">Revision notes</a> › <a href={paperURL}>{paper}</a> › <span aria-current="page">{title}</span></nav><header><span class="eyebrow">AQA 7552 / {code}</span><h1>{title}<b>.</b></h1><p>{group.title}</p></header><nav class="contents" aria-label="On this page"><span>IN THIS TOPIC</span>{sections.map((section, i) => <a href={`#section-${i}`}>{section.name} <span>↓</span></a>)}</nav><div class="sections">{sections.map((section, i) => <section id={`section-${i}`} class="section"><div class="section-top"><span>{code} / {String(i+1).padStart(2,'0')}</span><h2><a href={section.path}>{section.name}</a></h2></div><p>Read the {section.name.toLowerCase()} notes and revise this part of {title.toLowerCase()}.</p><div class="section-actions"><a class="detail" href={section.path}>Open the notes →</a></div></section>)}</div><div class="topic-recall"><span>ACTIVE RECALL · {code}</span><h2>Think you have got this whole topic?</h2><p>Test everything from <strong>{title}</strong> together — questions and flashcards are drawn from all the subtopics and notes above.</p><div><a href={`/quiz/?topic=${encodeURIComponent(code)}`}>Quiz the whole topic →</a><a href={`/flashcards/?topic=${encodeURIComponent(code)}`}>Flashcards for the whole topic →</a></div></div>{extraReading.length > 0 && <nav class="related-reading" aria-label="Related reading"><h2>Related reading</h2>{extraReading.map(note => <a href={`/notes/${note.slug}/`}>{note.title} →</a>)}</nav>}<a class="spec" href={group.source} target="_blank" rel="noopener noreferrer">Check the AQA specification ↗</a></main>
</Base>
<style>
.page{background:#fbf8f5;padding:30px clamp(24px,4vw,76px) 85px;color:#291743}.back{font-size:14px;color:#7750a0;font-weight:700}.page header{margin:45px 0 30px}.eyebrow,.contents>span,.section-top>span{font-size:12px;letter-spacing:.12em;font-weight:800;color:#8058a2}.page h1{font-size:clamp(44px,5vw,78px);letter-spacing:-.06em;margin:12px 0 4px}.page h1 b{color:#9d64bb}.page header p{color:#766982;margin:0;font-size:17px}.contents{display:flex;flex-wrap:wrap;align-items:center;gap:9px;padding:20px 0 28px;border-top:1px solid #ded2e6;border-bottom:1px solid #ded2e6}.contents>span{width:100%;margin-bottom:5px}.contents a{font-size:16px;padding:11px 15px;background:#fff;border:1px solid #e6ddeb;border-radius:5px;color:#593879}.contents a:hover{background:#f3e8fa}.contents a span{color:#9e78b2}.sections{width:100%}.section{scroll-margin-top:22px;border-bottom:1px solid #ded2e6;padding:35px 0 45px}.section-top h2{font-size:clamp(30px,3vw,42px);letter-spacing:-.045em;margin:7px 0 20px}.prose{font-size:22px;line-height:1.78;color:#514a59;width:100%}.prose :global(h1){font-size:36px;margin:30px 0 12px}.prose :global(h2){font-size:34px;margin:34px 0 14px}.prose :global(h3){font-size:27px;margin:28px 0 10px}.prose :global(a){text-decoration:underline;color:#75469c}.prose :global(li){margin:7px 0}.prose :global(hr){border:0;border-top:1px solid #e8deea;margin:30px 0}.pending{color:#7a6d81;font-size:18px}.related a{display:block;color:#75469c;padding:10px 0;font-weight:700}.detail,.spec{display:inline-block;font-size:15px;color:#75469c;font-weight:750;margin-top:16px}.spec{margin-top:30px}@media(max-width:650px){.page header{margin-top:32px}.section{padding:27px 0 35px}.prose{font-size:19px}}
.prose :global(strong){color:#7335a1;font-weight:800}.prose :global(h2){background:linear-gradient(100deg,#efe1f7,#faf2f7 75%,#fff8f0);border:1px solid #ead9ee;border-left:5px solid #9d69bb;border-radius:12px;padding:18px 22px}.prose :global(h3){background:#fff;border:1px solid #e8daeb;border-bottom:0;border-radius:12px 12px 0 0;padding:20px 24px 8px;margin:26px 0 0;color:#43245a}.prose :global(h3 + p){background:#fff;border:1px solid #e8daeb;border-top:0;border-radius:0 0 12px 12px;margin:0;padding:0 24px 22px;box-shadow:0 5px 18px #3e1e5908}.prose :global(h3 + ul),.prose :global(h3 + ol){background:#fff;border:1px solid #e8daeb;border-top:0;border-radius:0 0 12px 12px;margin:0;padding:4px 28px 22px 48px}.prose :global(p){overflow-wrap:anywhere}.prose :global(.study-card){background:#fff;border:1px solid #e7d8ed;border-radius:14px;padding:24px 28px;margin:20px 0;box-shadow:0 7px 24px #3e1e5909}.prose :global(.study-card > h3){background:none;border:0;border-radius:0;padding:0;margin:0 0 12px;color:#582982}.prose :global(.study-card > h3 + p){background:none;border:0;border-radius:0;padding:0;margin:0 0 14px;box-shadow:none}.prose :global(.study-card > p){margin:0 0 14px}.prose :global(.study-card > p:last-child){margin-bottom:0}.prose :global(.table-wrap){width:100%;overflow-x:auto;margin:22px 0;border:1px solid #e7d8ed;border-radius:12px}.prose :global(table){border-collapse:collapse;width:100%;min-width:760px;font-size:.82em;line-height:1.5}.prose :global(th){background:#492269;color:white;font-weight:750;text-align:left;padding:14px;border:1px solid #e7d8ed;vertical-align:top}.prose :global(td){padding:13px 14px;border:1px solid #e7d8ed;vertical-align:top;background:#fff}.prose :global(tbody tr:nth-child(even) td){background:#faf5fd}.prose :global(td p),.prose :global(th p){margin:0 0 8px}.prose :global(td p:last-child),.prose :global(th p:last-child){margin-bottom:0}@media(max-width:650px){.prose :global(.study-card){padding:18px}}.prose :global(.note-panel){background:#fff;border:1px solid #e8e0ed;border-radius:18px;padding:clamp(23px,3vw,40px);margin:28px 0 40px;box-shadow:0 10px 32px #4221520d}.prose :global(.note-panel > h2){background:none;border:0;border-radius:0;padding:0 0 16px;margin:0 0 16px;font-size:clamp(29px,3vw,39px);color:#301b40;position:relative}.prose :global(.note-panel > h2::after){content:'';position:absolute;bottom:5px;left:0;width:76px;height:3px;background:#9c62bf;border-radius:5px}.prose :global(.note-intro){font-size:1.04em;line-height:1.7;color:#504657;margin-bottom:20px}.prose :global(.note-intro > p){margin:0 0 14px}.prose :global(.note-grid){display:grid;grid-template-columns:1fr;gap:18px;align-items:start}.prose :global(.note-grid > .study-card){margin:0;padding:28px 32px;width:100%;background:#fcf9fe;border:1px solid #e8ddec;border-radius:12px;box-shadow:none}.prose :global(.note-grid > .study-card > h3){font-size:1.08em;color:#4e286a;margin-bottom:12px}.prose :global(.note-panel p > strong:only-child){font-weight:inherit;color:inherit}.prose :global(.note-panel .table-wrap){margin:12px 0 0}@media(max-width:900px){.prose :global(.note-grid){grid-template-columns:1fr}}.section-actions{margin-top:20px}.test-box{margin-top:24px;background:linear-gradient(110deg,#f0e3f7,#fff5e9);border:1px solid #e5d6e8;border-radius:14px;padding:26px}.test-box>span{font-size:9px;letter-spacing:.14em;font-weight:800;color:#8855a3}.test-box h3{font-size:25px;margin:8px 0}.test-box p{font-size:14px;color:#65586e}.test-box div{display:flex;gap:9px;flex-wrap:wrap}.test-box a{background:#482166;color:#fff;padding:11px 15px;border-radius:7px;font-size:11px;font-weight:800}.test-box a+a{background:#eee0f4;color:#54286d}.topic-recall{margin:34px 0 8px;background:linear-gradient(110deg,#eee0f6,#fff3e7);border:1px solid #dfcee5;border-radius:16px;padding:clamp(26px,3vw,38px)}.topic-recall>span{font-size:10px;letter-spacing:.14em;font-weight:800;color:#8855a3}.topic-recall h2{font-size:clamp(27px,3vw,38px);letter-spacing:-.04em;margin:8px 0 10px}.topic-recall p{font-size:15px;line-height:1.6;color:#65586e;max-width:720px}.topic-recall div{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.topic-recall a{background:#482166;color:#fff;padding:12px 16px;border-radius:7px;font-size:12px;font-weight:800}.topic-recall a+a{background:#fff;color:#54286d;border:1px solid #ddcde4}@media(max-width:650px){.topic-recall div{display:grid}.topic-recall a{text-align:center}}</style>

<style>.crumb{display:flex;gap:10px;flex-wrap:wrap;color:#74647e;font-size:13px}.crumb a:hover,.section-top h2 a:hover{text-decoration:underline;color:#75469c}.section>p{font-size:17px;color:#6c5f73}.section-actions{margin-top:8px}</style>

<style>.related-reading{margin-top:35px;display:grid;gap:12px}.related-reading a{color:#75469c;font-weight:700}.related-reading a:hover{text-decoration:underline}</style>
