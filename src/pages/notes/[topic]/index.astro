---
import Base from '../../../layouts/Base.astro';
import { syllabus, subtopicPath, subtopicSlug } from '../../../data/syllabus.js';
import { notes } from '../../../data/notes.js';

export function getStaticPaths() {
  return syllabus.flatMap(group => group.topics.map(([code, title, subtopics]) => ({
    params: { topic: code }, props: { group, code, title, subtopics }
  })));
}
const { group, code, title, subtopics } = Astro.props;
const modules = import.meta.glob('../../../content/subtopics/**/*.md', { eager: true });
const sections = subtopics.map(name => ({
  name,
  path: subtopicPath(code, name),
  Content: modules[`../../../content/subtopics/${code}/${subtopicSlug(name)}.md`]?.Content,
  related: notes.filter(note => note.topic === code && note.subtopic === name)
}));
---
<Base title={`${title} | A-level DT notes`} description={`AQA 7552 Product Design: ${title} revision notes.`}>
  <main class="page"><a class="back" href={`/notes/#${group.id}`}>← All revision topics</a><header><span class="eyebrow">AQA 7552 / {code}</span><h1>{title}<b>.</b></h1><p>{group.title}</p></header><nav class="contents" aria-label="On this page"><span>IN THIS TOPIC</span>{sections.map((section, i) => <a href={`#section-${i}`}>{section.name} <span>↓</span></a>)}</nav><div class="sections">{sections.map((section, i) => <section id={`section-${i}`} class="section"><div class="section-top"><span>{code} / {String(i+1).padStart(2,'0')}</span><h2>{section.name}</h2></div>{section.Content ? <div class="prose"><section.Content /></div> : section.related.length ? <div class="related">{section.related.map(note => <a href={`/notes/${note.slug}/`}>{note.title} ↗</a>)}</div> : <p class="pending">Notes for this subtopic are being added.</p>}<a class="detail" href={section.path}>Open this subtopic ↗</a></section>)}</div><a class="spec" href={group.source} target="_blank" rel="noopener noreferrer">Check the AQA specification ↗</a></main>
</Base>
<style>
.page{background:#fbf8f5;padding:30px clamp(24px,4vw,76px) 85px;color:#291743}.back{font-size:14px;color:#7750a0;font-weight:700}.page header{margin:45px 0 30px}.eyebrow,.contents>span,.section-top>span{font-size:12px;letter-spacing:.12em;font-weight:800;color:#8058a2}.page h1{font-size:clamp(44px,5vw,78px);letter-spacing:-.06em;margin:12px 0 4px}.page h1 b{color:#9d64bb}.page header p{color:#766982;margin:0;font-size:17px}.contents{display:flex;flex-wrap:wrap;align-items:center;gap:9px;padding:20px 0 28px;border-top:1px solid #ded2e6;border-bottom:1px solid #ded2e6}.contents>span{width:100%;margin-bottom:5px}.contents a{font-size:16px;padding:11px 15px;background:#fff;border:1px solid #e6ddeb;border-radius:5px;color:#593879}.contents a:hover{background:#f3e8fa}.contents a span{color:#9e78b2}.sections{width:100%}.section{scroll-margin-top:22px;border-bottom:1px solid #ded2e6;padding:35px 0 45px}.section-top h2{font-size:clamp(30px,3vw,42px);letter-spacing:-.045em;margin:7px 0 20px}.prose{font-size:19px;line-height:1.75;color:#514a59;width:100%}.prose :global(h1){font-size:32px;margin:26px 0 10px}.prose :global(h2){font-size:29px;margin:32px 0 12px}.prose :global(h3){font-size:23px;margin:24px 0 8px}.prose :global(a){text-decoration:underline;color:#75469c}.prose :global(li){margin:7px 0}.prose :global(hr){border:0;border-top:1px solid #e8deea;margin:30px 0}.pending{color:#7a6d81;font-size:18px}.related a{display:block;color:#75469c;padding:10px 0;font-weight:700}.detail,.spec{display:inline-block;font-size:15px;color:#75469c;font-weight:750;margin-top:16px}.spec{margin-top:30px}@media(max-width:650px){.page header{margin-top:32px}.section{padding:27px 0 35px}.prose{font-size:17px}}
.prose :global(strong){color:#7335a1;font-weight:800}.prose :global(h2){background:linear-gradient(100deg,#efe1f7,#faf2f7 75%,#fff8f0);border:1px solid #ead9ee;border-left:5px solid #9d69bb;border-radius:12px;padding:18px 22px}.prose :global(h3){background:#fff;border:1px solid #e8daeb;border-bottom:0;border-radius:12px 12px 0 0;padding:20px 24px 8px;margin:26px 0 0;color:#43245a}.prose :global(h3 + p){background:#fff;border:1px solid #e8daeb;border-top:0;border-radius:0 0 12px 12px;margin:0;padding:0 24px 22px;box-shadow:0 5px 18px #3e1e5908}.prose :global(h3 + ul),.prose :global(h3 + ol){background:#fff;border:1px solid #e8daeb;border-top:0;border-radius:0 0 12px 12px;margin:0;padding:4px 28px 22px 48px}.prose :global(p){overflow-wrap:anywhere}.prose :global(.study-card){background:#fff;border:1px solid #e7d8ed;border-radius:14px;padding:24px 28px;margin:20px 0;box-shadow:0 7px 24px #3e1e5909}.prose :global(.study-card > h3){background:none;border:0;border-radius:0;padding:0;margin:0 0 12px;color:#582982}.prose :global(.study-card > h3 + p){background:none;border:0;border-radius:0;padding:0;margin:0 0 14px;box-shadow:none}.prose :global(.study-card > p){margin:0 0 14px}.prose :global(.study-card > p:last-child){margin-bottom:0}.prose :global(.table-wrap){width:100%;overflow-x:auto;margin:22px 0;border:1px solid #e7d8ed;border-radius:12px}.prose :global(table){border-collapse:collapse;width:100%;min-width:760px;font-size:.82em;line-height:1.5}.prose :global(th){background:#492269;color:white;font-weight:750;text-align:left;padding:14px;border:1px solid #e7d8ed;vertical-align:top}.prose :global(td){padding:13px 14px;border:1px solid #e7d8ed;vertical-align:top;background:#fff}.prose :global(tbody tr:nth-child(even) td){background:#faf5fd}.prose :global(td p),.prose :global(th p){margin:0 0 8px}.prose :global(td p:last-child),.prose :global(th p:last-child){margin-bottom:0}@media(max-width:650px){.prose :global(.study-card){padding:18px}}</style>
