---
import Base from '../../../layouts/Base.astro';
import NoteMedia from '../../../components/NoteMedia.astro';
import { syllabus, subtopicSlug } from '../../../data/syllabus.js';
import { notes } from '../../../data/notes.js';
import { quizQuestions } from '../../../data/quizQuestions.js';
import { hasSubtopicNotes, paperPath, paperName } from '../../../data/contentStatus.js';

export function getStaticPaths() {
  return syllabus.flatMap(group => group.topics.flatMap(([code, title, subtopics]) => subtopics
    .filter(subtopic => hasSubtopicNotes(code, subtopic))
    .map((subtopic, index) => ({
      params: { topic: code, subtopic: subtopicSlug(subtopic) },
      props: { group: { id: group.id, title: group.title, source: group.source }, code, title, subtopic, index, subtopics }
    }))));
}
const { group, code, title, subtopic, index, subtopics } = Astro.props;
const seoTitle = `${subtopic} | AQA A-Level Product Design 7552 Notes`;
const related = notes.filter(note => note.topic === code && note.subtopic === subtopic && note.slug !== 'materials-and-properties');
const modules = import.meta.glob('../../../content/subtopics/**/*.md', { eager: true });
const content = modules[`../../../content/subtopics/${code}/${subtopicSlug(subtopic)}.md`];
const Content = content?.Content;
const hasQuiz = quizQuestions.some(q => q.topic === code && q.subtopic === subtopic);
const hasCards = Boolean(Content);
const paper = paperName(group);
const paperURL = paperPath(group);
const siblings = subtopics.filter(name => name !== subtopic && hasSubtopicNotes(code, name));
const breadcrumbs = [{name:'A-levelDT',path:'/'},{name:'Revision notes',path:'/notes/'},{name:paper,path:paperURL},{name:title,path:`/notes/${code}/`},{name:subtopic,path:`/notes/${code}/${subtopicSlug(subtopic)}/`}];
---
<Base title={seoTitle} description={`Study ${subtopic} in AQA A-Level Product Design 7552 (${code}). Read the revision notes, then test your knowledge with topic flashcards and quizzes.`} breadcrumbs={breadcrumbs}>
<div class="subpage"><nav class="crumb" aria-label="Breadcrumb"><a href="/">A-levelDT</a> <span>›</span> <a href="/notes/">Revision notes</a> <span>›</span> <a href={paperURL}>{paper}</a> <span>›</span> <a href={`/notes/${code}/`}>{title}</a> <span>›</span> <span aria-current="page">{subtopic}</span></nav><div class="subhead"><span>AQA 7552 &nbsp; / &nbsp; {code}</span><h1>{subtopic}<b>.</b></h1><p>{title} · {group.title}</p></div><div class="subgrid"><section class="material"><h2>Revision notes</h2>{Content && <div class="prose"><Content /></div>}<NoteMedia code={code} slug={subtopicSlug(subtopic)} />{related.length > 0 && <div class="related"><h3>Related reading</h3>{related.map(note => <a href={`/notes/${note.slug}/`}><div><small>{note.category} · {note.reading}</small><strong>{note.title}</strong><p>{note.description}</p></div><span>↗</span></a>)}</div>}<div class="test-box"><span>ACTIVE RECALL</span><h3>Think you have got this topic?</h3><p>Test yourself before moving on, or use flashcards for a quick recall session.</p><div>{hasQuiz && <a href={`/quiz/?topic=${encodeURIComponent(`${code}::${subtopic}`)}`}>Start a quiz →</a>}{hasCards && <a href={`/flashcards/?topic=${encodeURIComponent(`${code}::${subtopic}`)}`}>Open flashcards →</a>}</div></div>{siblings.length > 0 && <nav class="related" aria-label="More notes in this topic"><h3>More in {title}</h3>{siblings.map(name => <a href={`/notes/${code}/${subtopicSlug(name)}/`}><strong>{name}</strong><span>→</span></a>)}</nav>}<a class="spec" href={group.source} target="_blank" rel="noopener noreferrer">Check this topic in the AQA specification ↗</a></section></div></div>
<script is:inline>
  // Some imported revision notes accidentally contained internal ChatGPT/file
  // citation tokens. They are editing metadata, not student-facing content.
  // Strip every known rendered form site-wide without altering the notes.
  document.querySelectorAll('.prose').forEach((root) => {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach((node) => {
      let text = node.nodeValue || '';
      text = text
        .replace(/(?:\uE200|)?\s*filecite\s*(?:\uE202|)?\s*turn\d+file\d+\s*(?:\uE202|)?\s*L?\d+(?:\s*[-–—]\s*L?\d+)?\s*(?:\uE201|)?/gi, '')
        .replace(/(?:\uE200|)?\s*filecite\s*(?:\uE202|)?[^\s<>]{0,120}(?:\uE201|)/gi, '')
        .replace(/[□�]+(?=\s|$)/g, '')
        .replace(/\s{2,}/g, ' ');
      if (text !== node.nodeValue) node.nodeValue = text;
    });
  });
</script>
</Base>
<style>
.subpage{padding:28px clamp(22px,4vw,62px) 75px;background:#fbf8f5;min-height:80vh}.crumb{display:flex;flex-wrap:wrap;gap:10px;font-size:11px;color:#786887;margin-bottom:23px}.crumb a:hover{color:#8451a9}.crumb span{color:#b4a2bd}.subhead{padding:32px 38px;background:linear-gradient(110deg,#f3e6fb,#f9edf4 68%,#fbeedd);border:1px solid #e9d9eb;border-radius:14px}.subhead>span{font-size:10px;font-weight:800;letter-spacing:.13em;color:#824c9f}.subhead h1{font-size:clamp(37px,4.6vw,65px);margin:13px 0 7px}.subhead h1 b{color:#a568bb}.subhead p{font-size:13px;color:#74627d;margin:0}.subgrid{display:block;margin-top:22px}.material{background:white;border:1px solid #e9dfe8;border-radius:13px;padding:clamp(30px,3.2vw,48px)}.material h2{font-size:30px;margin:0 0 16px}.related{border-top:1px solid #eee5ee}.related>a{padding:16px 0;border-bottom:1px solid #eee5ee;display:flex;justify-content:space-between;align-items:center;gap:20px}.related strong,.related small{display:block}.related small{color:#8a62a3;font-size:10px}.related strong{font-size:18px;margin:5px 0}.related p{color:#776d7c;font-size:12px;margin:0}.related>a>span{color:#7d4ca3}.spec{display:inline-block;font-size:12px;font-weight:800;color:#75469c;margin-top:20px}.prose{font-size:22px;color:#514a59;line-height:1.78}.prose :global(h2){font-size:34px;margin:34px 0 14px;background:linear-gradient(100deg,#efe1f7,#faf2f7 75%,#fff8f0);border:1px solid #ead9ee;border-left:5px solid #9d69bb;border-radius:12px;padding:18px 22px}.prose :global(h3){font-size:27px;background:#fff;border:1px solid #e8daeb;border-bottom:0;border-radius:12px 12px 0 0;padding:20px 24px 8px;margin:26px 0 0;color:#43245a}.prose :global(a){text-decoration:underline}.prose :global(li){margin:8px 0}.prose :global(img){display:block;width:auto;max-width:min(100%,720px);max-height:460px;height:auto;object-fit:contain;margin:18px auto;border-radius:10px}.prose :global(figure.note-figure){max-width:760px;margin:24px auto 32px;padding:14px;background:#fbf8fd;border:1px solid #e8ddec;border-radius:14px}.prose :global(figure.note-figure img){margin:0 auto;max-height:520px}.prose :global(figure.note-figure figcaption){font-size:12px;line-height:1.5;color:#75687b;text-align:center;margin-top:10px}.prose :global(strong){color:#7335a1;font-weight:800}.prose :global(h3 + p){background:#fff;border:1px solid #e8daeb;border-top:0;border-radius:0 0 12px 12px;margin:0;padding:0 24px 22px;box-shadow:0 5px 18px #3e1e5908}.prose :global(.study-card){background:#fff;border:1px solid #e7d8ed;border-radius:14px;padding:24px 28px;margin:20px 0;box-shadow:0 7px 24px #3e1e5909}.prose :global(.study-card > h3){background:none;border:0;border-radius:0;padding:0;margin:0 0 12px;color:#582982}.prose :global(.study-card > h3 + p){background:none;border:0;border-radius:0;padding:0;margin:0 0 14px;box-shadow:none}.prose :global(.table-wrap){width:100%;overflow-x:auto;margin:22px 0;border:1px solid #e7d8ed;border-radius:12px}.prose :global(table){border-collapse:collapse;width:100%;min-width:760px;font-size:.82em;line-height:1.5}.prose :global(th){background:#492269;color:white;font-weight:750;text-align:left;padding:14px;border:1px solid #e7d8ed;vertical-align:top}.prose :global(td){padding:13px 14px;border:1px solid #e7d8ed;vertical-align:top;background:#fff}.prose :global(.note-panel){background:#fff;border:1px solid #e8e0ed;border-radius:18px;padding:clamp(23px,3vw,40px);margin:28px 0 40px;box-shadow:0 10px 32px #4221520d}.prose :global(.note-panel > h2){background:none;border:0;border-radius:0;padding:0 0 16px;margin:0 0 16px;font-size:clamp(29px,3vw,39px);color:#301b40}.prose :global(.note-intro){font-size:1.04em;line-height:1.7;color:#504657;margin-bottom:20px}.prose :global(.note-grid){display:grid;grid-template-columns:1fr;gap:18px;align-items:start}.test-box{margin-top:35px;background:linear-gradient(110deg,#f0e3f7,#fff5e9);border:1px solid #e5d6e8;border-radius:14px;padding:26px}.test-box>span{font-size:9px;letter-spacing:.14em;font-weight:800;color:#8855a3}.test-box h3{font-size:25px;margin:8px 0}.test-box p{font-size:14px}.test-box div{display:flex;gap:9px;flex-wrap:wrap}.test-box a{background:#482166;color:#fff;padding:11px 15px;border-radius:7px;font-size:11px;font-weight:800}.test-box a+a{background:#eee0f4;color:#54286d}@media(max-width:760px){.subhead{padding:24px}.material{padding:24px}.prose :global(img){max-width:100%;max-height:340px}}@media(max-width:650px){.prose :global(.study-card){padding:18px}.prose :global(.note-grid){grid-template-columns:1fr}}
</style>