---
import Base from '../../../layouts/Base.astro';
import { syllabus, subtopicSlug } from '../../../data/syllabus.js';
import { notes } from '../../../data/notes.js';

export function getStaticPaths() {
  return syllabus.flatMap(group => group.topics.flatMap(([code, title, subtopics]) => subtopics.map((subtopic, index) => ({
    params: { topic: code, subtopic: subtopicSlug(subtopic) },
    props: { group: { id: group.id, title: group.title, source: group.source }, code, title, subtopic, index, subtopics }
  }))));
}
const { group, code, title, subtopic, index, subtopics } = Astro.props;
const related = notes.filter(note => note.topic === code && note.subtopic === subtopic);
const modules = import.meta.glob('../../../content/subtopics/**/*.md', { eager: true });
const content = modules[`../../../content/subtopics/${code}/${subtopicSlug(subtopic)}.md`];
const Content = content?.Content;
---
<Base title={`${subtopic} | ${code} | A-level DT`} description={`AQA Product Design ${code}: ${subtopic}. Revision notes and specification links.`}>
<div class="subpage"><div class="crumb"><a href="/notes/">Revision notes</a> <span>/</span> <a href={`/notes/#${group.id}`}>{group.title}</a> <span>/</span> {code}</div><div class="subhead"><span>AQA 7552 &nbsp; / &nbsp; {code}</span><h1>{subtopic}<b>.</b></h1><p>{title} · {group.title}</p></div><div class="subgrid"><section class="material"><h2>Revision notes</h2>{Content ? <div class="prose"><Content /></div> : related.length ? <div class="related">{related.map(note => <a href={`/notes/${note.slug}/`}><div><small>{note.category} · {note.reading}</small><strong>{note.title}</strong><p>{note.description}</p></div><span>↗</span></a>)}</div> : <p class="pending">Notes for this subtopic are being added. Use the AQA specification link below to see the required content.</p>}<a class="spec" href={group.source} target="_blank" rel="noopener noreferrer">Check this topic in the AQA specification ↗</a></section><aside><span>IN THIS TOPIC</span><h3>{code} {title}</h3><nav aria-label="Other subtopics">{subtopics.map(sub => <a class={sub === subtopic ? 'current' : ''} href={`/notes/${code}/${subtopicSlug(sub)}/`}>{sub}</a>)}</nav><a class="back" href={`/notes/#${group.id}`}>← All {group.title} topics</a></aside></div></div>
</Base>
<style>
.subpage{padding:28px clamp(22px,4vw,62px) 75px;background:#fbf8f5;min-height:80vh}.crumb{display:flex;flex-wrap:wrap;gap:10px;font-size:11px;color:#786887;margin-bottom:23px}.crumb a:hover{color:#8451a9}.crumb span{color:#b4a2bd}.subhead{padding:32px 38px;background:linear-gradient(110deg,#f3e6fb,#f9edf4 68%,#fbeedd);border:1px solid #e9d9eb;border-radius:14px}.subhead>span{font-size:10px;font-weight:800;letter-spacing:.13em;color:#824c9f}.subhead h1{font-size:clamp(37px,4.6vw,65px);margin:13px 0 7px}.subhead h1 b{color:#a568bb}.subhead p{font-size:13px;color:#74627d;margin:0}.subgrid{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:20px;margin-top:22px}.material,aside{background:white;border:1px solid #e9dfe8;border-radius:13px;padding:27px}.material h2{font-size:30px;margin:0 0 16px}.pending{background:#f9f4fb;border-left:3px solid #c6a3d8;padding:20px;color:#6c5976;font-size:18px}.related{border-top:1px solid #eee5ee}.related>a{padding:16px 0;border-bottom:1px solid #eee5ee;display:flex;justify-content:space-between;align-items:center;gap:20px}.related strong,.related small{display:block}.related small{color:#8a62a3;font-size:10px}.related strong{font-size:18px;margin:5px 0}.related p{color:#776d7c;font-size:12px;margin:0}.related>a>span{color:#7d4ca3}.spec{display:inline-block;font-size:12px;font-weight:800;color:#75469c;margin-top:20px}.prose{font-size:19px;color:#514a59;line-height:1.75}.prose :global(h2){font-size:29px;margin:30px 0 12px}.prose :global(h3){font-size:23px;margin:24px 0 8px}.prose :global(a){text-decoration:underline}.prose :global(li){margin:8px 0}aside>span{font-size:9px;letter-spacing:.13em;font-weight:800;color:#875ba6}aside h3{font-size:16px;margin:12px 0 19px}aside nav{display:grid;gap:3px}aside nav a{font-size:11px;color:#65586e;padding:10px;border-radius:6px}aside nav a:hover,aside nav a.current{background:#f3e8fa;color:#58277a}aside .back{display:block;border-top:1px solid #eee5ee;margin-top:20px;padding-top:19px;color:#71499b;font-size:11px;font-weight:800}@media(max-width:760px){.subgrid{grid-template-columns:1fr}.subhead{padding:24px}.material,aside{padding:21px}}
.prose :global(strong){color:#7335a1;font-weight:800}.prose :global(h2){background:linear-gradient(100deg,#efe1f7,#faf2f7 75%,#fff8f0);border:1px solid #ead9ee;border-left:5px solid #9d69bb;border-radius:12px;padding:18px 22px}.prose :global(h3){background:#fff;border:1px solid #e8daeb;border-bottom:0;border-radius:12px 12px 0 0;padding:20px 24px 8px;margin:26px 0 0;color:#43245a}.prose :global(h3 + p){background:#fff;border:1px solid #e8daeb;border-top:0;border-radius:0 0 12px 12px;margin:0;padding:0 24px 22px;box-shadow:0 5px 18px #3e1e5908}.prose :global(h3 + ul),.prose :global(h3 + ol){background:#fff;border:1px solid #e8daeb;border-top:0;border-radius:0 0 12px 12px;margin:0;padding:4px 28px 22px 48px}.prose :global(p){overflow-wrap:anywhere}</style>
