---
import Base from '../../layouts/Base.astro';
import { notes, categories } from '../../data/notes.js';
---
<Base title="Explore notes | A-level DT" description="Explore A-level Design & Technology revision notes by subject and topic.">
  <div class="page-head"><span class="eyebrow">THE NOTEBOOK</span><h1>Find your next<br /><em>aha moment.</em></h1><p>Explore the ideas, people and principles behind great design. Pick a subject or search for the thing you need.</p></div>
  <section class="library"><div class="library-top"><label class="search"><span aria-hidden="true">⌕</span><input id="note-search" type="search" placeholder="Search notes, topics or ideas..." aria-label="Search notes" /></label><span id="result-count">{notes.length} notes</span></div><div class="filters" aria-label="Filter by subject"><button class="selected" data-filter="all">All notes</button>{categories.map(category => <button data-filter={category.name}>{category.name}</button>)}</div><div id="note-list" class="list">{notes.map(note => <a href={`/notes/${note.slug}/`} class="note" data-title={note.title.toLowerCase()} data-description={note.description.toLowerCase()} data-category={note.type}><span class="num">{note.number}</span><span class="info"><small>{note.type} / {note.category}</small><strong>{note.title}</strong><span>{note.description}</span></span><span class="time">{note.reading} read</span><span class="arrow">↗</span></a>)}</div><p id="empty" hidden>No matching notes yet. Try another search.</p></section>
</Base>
<script>
  const search = document.querySelector('#note-search');
  const buttons = [...document.querySelectorAll('[data-filter]')];
  const items = [...document.querySelectorAll('.note')];
  let filter = new URLSearchParams(location.search).get('category') || 'all';
  const update = () => {
    const query = search.value.trim().toLowerCase();
    let shown = 0;
    items.forEach(item => { const visible = (filter === 'all' || item.dataset.category === filter) && (!query || `${item.dataset.title} ${item.dataset.description} ${item.dataset.category}`.toLowerCase().includes(query)); item.hidden = !visible; if (visible) shown++; });
    document.querySelector('#result-count').textContent = `${shown} ${shown === 1 ? 'note' : 'notes'}`;
    document.querySelector('#empty').hidden = shown !== 0;
    buttons.forEach(button => button.classList.toggle('selected', button.dataset.filter === filter));
  };
  buttons.forEach(button => button.addEventListener('click', () => { filter = button.dataset.filter; history.replaceState(null, '', filter === 'all' ? '/notes/' : `?category=${encodeURIComponent(filter)}`); update(); }));
  search.addEventListener('input', update);
  update();
</script>
<style>
.page-head{padding:95px clamp(24px,8.5vw,138px) 78px;background:#e6eddb}.page-head h1{margin:20px 0;font-size:clamp(52px,6vw,88px)}.page-head em{font-style:normal;color:#84a75e}.page-head p{max-width:510px;color:#677262;font-size:15px}.library{padding:60px clamp(24px,8.5vw,138px) 110px}.library-top{display:flex;justify-content:space-between;align-items:center;gap:20px}.search{display:flex;align-items:center;gap:12px;background:white;border:1px solid #e2e4dd;padding:0 20px;max-width:500px;width:100%;border-radius:7px}.search span{font-size:26px;color:#849573}.search input{border:0;outline:none;padding:18px 0;width:100%;background:transparent;font-size:13px}.library-top>span{font-size:12px;color:#787e74}.filters{display:flex;gap:9px;flex-wrap:wrap;margin:28px 0 33px}.filters button{border:1px solid #dfe3d8;background:transparent;border-radius:50px;padding:10px 17px;cursor:pointer;font-size:11px;font-weight:700}.filters button.selected,.filters button:hover{background:#252b24;border-color:#252b24;color:white}.list{border-top:1px solid #dddfd6}.note{display:grid;grid-template-columns:50px 1fr 100px 25px;gap:20px;align-items:center;padding:28px 3px;border-bottom:1px solid #dddfd6}.note[hidden]{display:none}.num,.time{font-size:11px;color:#8b9385}.info{display:grid;gap:9px}.info small{font-size:10px;text-transform:uppercase;letter-spacing:1.3px;color:#7a9a57;font-weight:800}.info strong{font:800 22px Manrope,sans-serif;letter-spacing:-1px}.info>span{font-size:12px;color:#7c8078}.note:hover strong{color:#739b4f}.arrow{font-size:20px}#empty{padding:30px 0;color:#737b70}@media(max-width:650px){.page-head{padding-top:70px}.library{padding-top:38px}.note{grid-template-columns:30px 1fr 20px;gap:10px}.time{display:none}.info strong{font-size:18px}.library-top>span{white-space:nowrap}}
</style>
