---
import Base from '../../layouts/Base.astro';
import { syllabus } from '../../data/syllabus.js';
---
<Base title="Revision notes by topic | A-level DT" description="AQA 7552 Product Design revision notes, organised by topic.">
  <header class="head"><span class="label">AQA 7552 / PRODUCT DESIGN</span><h1>Revision notes<br /><span>by AQA topic.</span></h1><p>Choose a topic to read its notes and browse its subtopics.</p></header>
  <main class="catalogue">{syllabus.map(group => <section class="part" id={group.id}><div class="part-head"><span>{group.code}</span><h2>{group.title}</h2><a href={group.source} target="_blank" rel="noopener noreferrer">View AQA specification ↗</a></div><div class="topics">{group.topics.map(([code,title,subtopics]) => <a class="topic" href={`/notes/${code}/`}><span class="code">{code}</span><strong>{title}</strong><span class="count">{subtopics.length} {subtopics.length === 1 ? 'subtopic' : 'subtopics'}</span><span class="arrow" aria-hidden="true">↗</span></a>)}</div></section>)}</main>
</Base>
<style>
.head{background:linear-gradient(110deg,#f6eafb,#dfcbf6);color:#291743;padding:55px clamp(24px,7vw,112px) 58px}.label,.part-head>span{font-size:11px;letter-spacing:.14em;font-weight:800;color:#7750a0}.head h1{font-size:clamp(44px,5.3vw,75px);margin:25px 0;letter-spacing:-.075em}.head h1 span{color:#8953bc}.head p{max-width:540px;color:#61506e;font-size:16px}.catalogue{background:#fffaf7;padding:55px clamp(24px,7vw,112px) 90px}.part{scroll-margin-top:30px;margin-bottom:60px}.part-head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:10px;margin-bottom:25px}.part-head>span{grid-column:1/-1;color:#754fac}.part-head h2{font-size:clamp(35px,4vw,58px);margin:0}.part-head>a{font-size:12px;color:#7955ac;font-weight:750}.topics{border-top:1px solid #dcd4e5}.topic{border-bottom:1px solid #dcd4e5;display:grid;grid-template-columns:95px minmax(0,1fr) auto 22px;align-items:center;gap:20px;min-height:79px;transition:background .2s,padding .2s}.topic:hover,.topic:focus-visible{background:#f3e8fa;padding-left:12px}.code{font-size:12px;color:#7955ac;font-weight:800}.topic strong{font-size:20px;font-weight:750;letter-spacing:-.04em}.count{font-size:12px;color:#83768e}.arrow{font-size:22px;color:#7955ac}@media(max-width:650px){.part-head{grid-template-columns:1fr}.topic{grid-template-columns:55px 1fr 20px;gap:9px;padding:12px 0}.topic strong{font-size:16px}.count{display:none}.code{font-size:10px}}
</style>
