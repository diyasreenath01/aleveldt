---
import Base from '../../layouts/Base.astro';
import { syllabus, subtopicPath } from '../../data/syllabus.js';
import { hasSubtopicNotes, paperName, paperPath } from '../../data/contentStatus.js';
---
<Base title="AQA A-Level Product Design 7552 Revision Notes | A-levelDT" description="Browse AQA A-Level Product Design 7552 notes by Paper 1 and Paper 2, then open specification topics and individual subtopic revision pages." breadcrumbs={[{name:'A-levelDT',path:'/'},{name:'Revision notes',path:'/notes/'}]}>
  <header class="head"><span class="label">AQA 7552 / PRODUCT DESIGN</span><h1>Revision notes<br /><span>by AQA topic.</span></h1><p>Choose a topic to read its notes and browse its subtopics.</p></header>
  <main class="catalogue">{syllabus.map(group => <section class="part" id={group.id}><div class="part-head"><span>{group.code}</span><h2><a href={paperPath(group)}>{paperName(group)}: {group.title}</a></h2><a href={group.source} target="_blank" rel="noopener noreferrer">View AQA specification ↗</a></div><div class="topics">{group.topics.map(([code,title,subtopics]) => <details class="topic"><summary><span class="code">{code}</span><strong>{title}</strong><span class="count">{subtopics.filter(name => hasSubtopicNotes(code,name)).length}/{subtopics.length} notes</span><span class="arrow" aria-hidden="true">⌄</span></summary><div class="subtopics">{subtopics.map((name,i) => hasSubtopicNotes(code,name) ? <a href={subtopicPath(code,name)}><span>{String(i+1).padStart(2,'0')}</span><strong>{name}</strong><b>→</b></a> : <div class="unavailable"><span>{String(i+1).padStart(2,'0')}</span><strong>{name}</strong><small>Notes not added yet</small></div>)}<a class="all-topic" href={`/notes/${code}/`}><span>ALL</span><strong>View {title} topic</strong><b>→</b></a></div></details>)}</div></section>)}</main>
</Base>
<style>
.head{background:linear-gradient(110deg,#f6eafb,#dfcbf6);color:#291743;padding:55px clamp(24px,7vw,112px) 58px}.label,.part-head>span{font-size:11px;letter-spacing:.14em;font-weight:800;color:#7750a0}.head h1{font-size:clamp(44px,5.3vw,75px);margin:25px 0;letter-spacing:-.075em}.head h1 span{color:#8953bc}.head p{max-width:540px;color:#61506e;font-size:16px}.catalogue{background:#fffaf7;padding:55px clamp(24px,7vw,112px) 90px}.part{scroll-margin-top:30px;margin-bottom:60px}.part-head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:10px;margin-bottom:25px}.part-head>span{grid-column:1/-1;color:#754fac}.part-head h2{font-size:clamp(35px,4vw,58px);margin:0}.part-head>a{font-size:12px;color:#7955ac;font-weight:750}.topics{border-top:1px solid #dcd4e5}.topic{border-bottom:1px solid #dcd4e5}.topic summary{list-style:none;display:grid;grid-template-columns:95px minmax(0,1fr) auto 22px;align-items:center;gap:20px;min-height:90px;cursor:pointer;transition:background .2s,padding .2s}.topic summary::-webkit-details-marker{display:none}.topic summary:hover,.topic summary:focus-visible{background:#f3e8fa;padding-left:12px}.code{font-size:12px;color:#7955ac;font-weight:800}.topic summary strong{font-size:23px;font-weight:750;letter-spacing:-.04em}.count{font-size:12px;color:#83768e}.arrow{font-size:22px;color:#7955ac;transition:transform .2s}.topic[open] .arrow{transform:rotate(180deg)}.topic[open] summary{background:#f8f0fb}.subtopics{margin:0 0 14px 95px;border-left:2px solid #e1d2e8;padding:4px 0 4px 22px}.subtopics a{display:grid;grid-template-columns:44px minmax(0,1fr) 20px;align-items:center;gap:10px;min-height:54px;padding:7px 14px;border-bottom:1px solid #eee5f0;color:#3d2948;border-radius:7px}.subtopics a:hover{background:#f4eafb;color:#70428b}.subtopics a>span{font-size:10px;color:#9a7ba9;font-weight:800}.subtopics a>strong{font-size:15px;letter-spacing:0;font-weight:700}.subtopics a>b{font-size:16px;color:#8b5ba4}.subtopics .all-topic{margin-top:8px;background:#f8f3fa;border-bottom:0}.subtopics .all-topic strong{color:#70428b}@media(max-width:650px){.part-head{grid-template-columns:1fr}.topic summary{grid-template-columns:55px 1fr 20px;gap:9px;padding:12px 0}.topic summary strong{font-size:16px}.count{display:none}.code{font-size:10px}.subtopics{margin-left:16px;padding-left:12px}.subtopics a{grid-template-columns:34px 1fr 16px;padding:6px 8px}}
</style>
<style>.part-head h2 a:hover{text-decoration:underline;color:#70428b}.subtopics .unavailable{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:10px;padding:12px 14px;color:#86798d;border-bottom:1px solid #eee5f0}.unavailable small{font-size:11px}@media(max-width:650px){.subtopics .unavailable{grid-template-columns:34px 1fr}.unavailable small{grid-column:2}}</style>
