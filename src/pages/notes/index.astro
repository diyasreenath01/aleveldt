---
import Base from '../../layouts/Base.astro';
import { notes } from '../../data/notes.js';
import { syllabus } from '../../data/syllabus.js';
---
<Base title="Revision notes by topic | A-level DT" description="Browse the full AQA 7552 Product Design topic structure and available revision notes.">
  <header class="head"><span class="label">AQA 7552 / PRODUCT DESIGN</span><h1>Revision notes<br /><span>by AQA topic.</span></h1><p>Paper 1 has 14 Technical principles topics. Paper 2 has 10 Designing and making principles topics. Expand a topic to find its subtopics and published notes.</p></header>
  <main class="catalogue">{syllabus.map(group => <section class="part" id={group.id}><div class="part-head"><span>{group.code}</span><h2>{group.title}</h2><a href={group.source} target="_blank" rel="noopener noreferrer">View AQA specification ↗</a></div><div class="topics">{group.topics.map(([code,title,subtopics]) => <details class="topic"><summary><span class="code">{code}</span><strong>{title}</strong><span class="toggle" aria-hidden="true">+</span></summary><div class="topic-body"><ul>{subtopics.map(sub => <li>{sub}</li>)}</ul>{notes.filter(note => (code === '3.1.1' && note.slug === 'materials-and-properties') || (code === '3.2.2' && ['arts-and-crafts','bauhaus'].includes(note.slug))).map(note => <a class="published" href={`/notes/${note.slug}/`}>Read note: {note.title} <span>↗</span></a>)}<a class="spec" href={`${group.source}`} target="_blank" rel="noopener noreferrer">Full topic detail on AQA ↗</a></div></details>)}</div></section>)}</main>
</Base>
<style>
.head{background:linear-gradient(125deg,#22103d,#543193);color:white;padding:55px clamp(24px,7vw,112px) 58px}.label,.part-head>span{font-size:11px;letter-spacing:.14em;font-weight:800;color:#c5a3f4}.head h1{font-size:clamp(44px,5.3vw,75px);margin:25px 0;letter-spacing:-.075em}.head h1 span{color:#d0b8fa}.head p{max-width:540px;color:#ddd0ee;font-size:16px}.catalogue{background:#fcfaff;padding:55px clamp(24px,7vw,112px) 90px}.part{scroll-margin-top:30px;margin-bottom:60px}.part-head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:10px;margin-bottom:25px}.part-head>span{grid-column:1/-1;color:#754fac}.part-head h2{font-size:clamp(35px,4vw,58px);margin:0}.part-head>a,.spec{font-size:12px;color:#7955ac;font-weight:750}.topics{border-top:1px solid #dcd4e5}.topic{border-bottom:1px solid #dcd4e5}.topic summary{list-style:none;display:grid;grid-template-columns:100px 1fr 30px;align-items:center;gap:20px;min-height:79px;cursor:pointer}.topic summary::-webkit-details-marker{display:none}.code{font-size:12px;color:#7955ac;font-weight:800}.topic strong{font-size:20px;font-weight:750;letter-spacing:-.04em}.toggle{font-size:26px;color:#7955ac;transition:transform .25s}.topic[open] .toggle{transform:rotate(45deg)}.topic-body{padding:0 45px 30px 120px}.topic-body ul{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0 0 18px;padding:0}.topic-body li{border:1px solid #e5dcf0;background:white;padding:9px 12px;font-size:12px;color:#645474}.published{display:flex;justify-content:space-between;max-width:480px;padding:13px 16px;background:#e7d8fa;color:#301653;font-weight:750;font-size:13px;margin:8px 0}.spec{display:inline-block;margin-top:12px}@media(max-width:650px){.part-head{grid-template-columns:1fr}.topic summary{grid-template-columns:58px 1fr 20px;gap:8px}.topic strong{font-size:16px}.topic-body{padding-left:0}.code{font-size:10px}}
</style>
