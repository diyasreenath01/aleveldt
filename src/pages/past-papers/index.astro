---
<Base title="AQA A-Level Product Design Past Papers | 7552" description="AQA A-Level Product Design 7552 past papers and mark schemes organised by year, with question papers and mark schemes viewable from A-levelDT.">
<header class="hero">
  <span>AQA 7552 / PAST PAPERS</span>
  <h1>Past papers,<br/><em>without the searching.</em></h1>
  <p>Choose a year, then open the question paper or mark scheme. The original PDFs are served by AQA and can be viewed here while you revise.</p>
</header>

<main class="wrap">
  <div class="year-nav">{years.map(y => <a href={`#year-${y.year}`}>{y.year}</a>)}</div>

  {years.map((year, yi) =>
    <section class="year" id={`year-${year.year}`}>
      <div class="year-head"><div><span>{String(yi+1).padStart(2,'0')} / {year.series.toUpperCase()}</span><h2>{year.year}</h2></div><p>Question papers + official mark schemes</p></div>
      <div class="papers">
        {year.papers.map(p =>
          <article class="paper">
            <div class="paper-meta"><span>{p.paper}</span><small>{p.code}</small></div>
            <h3>{p.title}</h3>
            <div class="actions">
              <button class="view primary" data-url={p.qp} data-label={`${year.year} · ${p.paper} · Question paper`}>View question paper</button>
              <button class="view" data-url={p.ms} data-label={`${year.year} · ${p.paper} · Mark scheme`}>View mark scheme</button>
            </div>
          </article>
        )}
      </div>
    </section>
  )}

  <section class="viewer" id="viewer" hidden>
    <div class="viewer-head">
      <div><span>DOCUMENT VIEWER</span><h2 id="viewer-title">Past paper</h2></div>
      <div class="viewer-actions"><a id="open-pdf" target="_blank" rel="noopener noreferrer">Open PDF ↗</a><button id="close-viewer">Close</button></div>
    </div>
    <iframe id="pdf-frame" title="AQA past paper PDF" loading="lazy"></iframe>
    <p class="fallback">If your browser blocks AQA from displaying the PDF inside the page, use <strong>Open PDF</strong> above. You will still go straight to the correct document — no searching required.</p>
  </section>

  <p class="source">AQA owns and hosts the examination documents. A-levelDT provides a revision-friendly index and viewer; the PDFs are not copied into this website.</p>
</main>

<script>
const viewer=document.querySelector('#viewer'),frame=document.querySelector('#pdf-frame'),title=document.querySelector('#viewer-title'),open=document.querySelector('#open-pdf');
document.querySelectorAll('.view').forEach(button=>button.addEventListener('click',()=>{
  const url=button.dataset.url;
  frame.src=url+'#view=FitH';
  open.href=url;
  title.textContent=button.dataset.label;
  viewer.hidden=false;
  viewer.scrollIntoView({behavior:'smooth',block:'start'});
}));
document.querySelector('#close-viewer').addEventListener('click',()=>{viewer.hidden=true;frame.src='';});
</script>

<style>
