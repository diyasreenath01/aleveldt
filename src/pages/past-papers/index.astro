---
import Base from '../../layouts/Base.astro';

const years = [
  { year:'2025', folder:'2025/june', session:'JUN25' },
  { year:'2024', folder:'2024/june', session:'JUN24' },
  { year:'2023', folder:'2023/june', session:'JUN23' },
  { year:'2022', folder:'2022/june', session:'JUN22' },
  { year:'2021', folder:'2021/november', session:'NOV21', label:'November 2021' },
  { year:'2020', folder:'2020/november', session:'NOV20', label:'November 2020' },
  { year:'2019', folder:'2019/june', session:'JUN19' }
];
const base = 'https://filestore.aqa.org.uk/sample-papers-and-mark-schemes';
const pdf = (row, paper, type) => `${base}/${row.folder}/AQA-7552${paper}-${type}-${row.session}.PDF`;
---
<Base title="AQA A-Level Product Design Past Papers (7552) | A-levelDT" description="AQA A-Level Design and Technology: Product Design 7552 past papers, mark schemes and examiner reports. Direct official AQA PDF links for Paper 1 and Paper 2." breadcrumbs={[{name:'A-levelDT',path:'/'},{name:'Past papers',path:'/past-papers/'}]}>
<header class="head"><span class="label">AQA 7552 / EXAM PRACTICE</span><h1>AQA Product Design<br /><span>past papers.</span></h1><p>Practise AQA A-Level Design & Technology: Product Design (7552) with direct links to official AQA question papers, mark schemes and examiner reports.</p><div class="quick"><a href="#paper-1">Paper 1 · Technical principles</a><a href="#paper-2">Paper 2 · Designing & making</a><a href="/specification/">7552 specification checklist</a></div></header>
<main class="content">
<section class="intro"><div><span class="eyebrow">EXAM STRUCTURE</span><h2>Know what you're practising.</h2></div><div class="facts"><p><strong>7552/1 · Paper 1</strong><br />Technical principles · 2h 30m · 120 marks · 30%</p><p><strong>7552/2 · Paper 2</strong><br />Designing and making principles · 1h 30m · 80 marks · 20%</p><p><strong>7552/C · NEA</strong><br />Substantial design-and-make project · 100 marks · 50%</p></div></section>
{[1,2].map(paper => <section class="paper-section" id={`paper-${paper}`}><div class="paper-head"><span>7552/{paper}</span><div><h2>{paper === 1 ? 'Paper 1 · Technical principles' : 'Paper 2 · Designing and making principles'}</h2><p>{paper === 1 ? 'Use these papers to test technical knowledge, application, calculations and extended responses.' : 'Includes product analysis and commercial manufacture, with short and extended responses.'}</p></div></div><div class="years">{years.map(row => <article class="year"><div class="year-title"><span>{row.label || `June ${row.year}`}</span><strong>Paper {paper}</strong></div><div class="links"><a href={pdf(row,paper,'QP')} target="_blank" rel="noopener noreferrer">Question paper <span>PDF ↗</span></a><a href={pdf(row,paper,'MS')} target="_blank" rel="noopener noreferrer">Mark scheme <span>PDF ↗</span></a><a href={pdf(row,paper,'WRE')} target="_blank" rel="noopener noreferrer">Examiner report <span>PDF ↗</span></a></div></article>)}</div></section>)}
<section class="official"><div><span class="eyebrow">OFFICIAL AQA</span><h2>More assessment resources</h2><p>AQA controls availability of its assessment materials. If an older direct PDF has been moved or withdrawn, use AQA's current assessment-resources page.</p></div><a href="https://www.aqa.org.uk/subjects/design-and-technology/a-level/design-and-technology-7552/assessment-resources" target="_blank" rel="noopener noreferrer">Open AQA assessment resources ↗</a></section>
<p class="source">All question papers, mark schemes and examiner reports linked above are hosted by AQA. ALevelDT does not host or reproduce the papers.</p>
</main>
</Base>
<style>
.head{background:linear-gradient(110deg,#f6eafb,#dfcbf6);color:#291743;padding:55px clamp(24px,7vw,112px) 58px}.label,.eyebrow,.paper-head>span{font-size:11px;letter-spacing:.14em;font-weight:800;color:#7750a0}.head h1{font-size:clamp(44px,5.3vw,75px);margin:25px 0;letter-spacing:-.075em}.head h1 span{color:#8953bc}.head>p{max-width:720px;color:#61506e;font-size:16px}.quick{display:flex;gap:9px;flex-wrap:wrap;margin-top:28px}.quick a{background:#fff9;border:1px solid #cdb4e3;padding:10px 13px;border-radius:999px;font-size:11px;font-weight:800;color:#5d347b}.content{padding:55px clamp(24px,7vw,112px) 90px;background:#fffaf7}.intro{display:grid;grid-template-columns:.85fr 1.15fr;gap:45px;padding-bottom:55px}.intro h2,.official h2{font-size:clamp(30px,3vw,45px);margin:9px 0}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.facts p{background:white;border:1px solid #e5daef;border-radius:12px;padding:20px;font-size:12px;color:#71647d}.facts strong{color:#35213f;font-size:13px}.paper-section{scroll-margin-top:25px;margin-bottom:65px}.paper-head{display:grid;grid-template-columns:90px 1fr;gap:15px;align-items:start;border-bottom:1px solid #dcd4e5;padding-bottom:22px}.paper-head h2{font-size:clamp(28px,3vw,43px);margin:0 0 7px}.paper-head p{margin:0;color:#74687c;font-size:13px;max-width:700px}.years{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}.year{background:white;border:1px solid #e5daef;border-radius:12px;padding:20px}.year-title{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:13px}.year-title>span{font-size:18px;font-weight:800}.year-title>strong{font-size:10px;letter-spacing:.1em;color:#8a6a9c}.links{display:grid;gap:6px}.links a{display:flex;justify-content:space-between;gap:12px;padding:10px 12px;background:#faf6fc;border-radius:7px;font-size:12px;font-weight:750;color:#4d315b}.links a:hover{background:#eee0f6;color:#70428b}.links a span{font-size:10px;color:#8963a0}.official{display:flex;justify-content:space-between;align-items:end;gap:30px;background:#321754;color:white;border-radius:14px;padding:30px}.official .eyebrow{color:#d9b8f2}.official h2{color:white}.official p{font-size:12px;color:#d9cce2;max-width:650px}.official>a{flex:none;background:white;color:#321754;padding:13px 16px;border-radius:7px;font-size:11px;font-weight:850}.source{font-size:11px;color:#807386;margin-top:18px}@media(max-width:800px){.intro{grid-template-columns:1fr}.facts{grid-template-columns:1fr}.years{grid-template-columns:1fr}.paper-head{grid-template-columns:1fr}.official{align-items:start;flex-direction:column}}
</style>