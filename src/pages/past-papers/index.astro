ify-content:space-between;align-items:center;padding:20px 22px;border-bottom:1px solid #e8dfe9;background:#faf6fb}.viewer-head h2{font-size:19px;margin:5px 0 0}.viewer-actions{display:flex;gap:7px}.viewer-actions a{background:#482166;color:#fff;border-color:#482166}.viewer iframe{display:block;width:100%;height:78vh;min-height:650px;border:0;background:#f3f0f3}.fallback{font-size:11px;color:#817484;margin:0;padding:12px 20px;border-top:1px solid #eee6ef}.source{font-size:11px;color:#8b7e90;max-width:760px}@media(max-width:750px){.papers{grid-template-columns:1fr}.year-head{align-items:start;flex-direction:column;gap:5px}.year-head p{margin:0}.viewer-head{align-items:start;flex-direction:column;gap:13px}.viewer iframe{height:70vh;min-height:500px}.actions{display:grid}.actions button{width:100%}}
</style>