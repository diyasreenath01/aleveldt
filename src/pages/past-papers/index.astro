---
import Base from '../../layouts/Base.astro';

const aqaPastPapers = 'https://www.aqa.org.uk/past-papers-and-mark-schemes-finder';
const aqaAssessment = 'https://www.aqa.org.uk/subjects/design-and-technology/a-level/design-and-technology-7552/assessment-resources';
---
<Base title="AQA A-Level Product Design Past Papers (7552) | A-levelDT" description="Official AQA links for A-Level Design and Technology: Product Design 7552 past papers, mark schemes and examiner reports." breadcrumbs={[{name:'A-levelDT',path:'/'},{name:'Past papers',path:'/past-papers/'}]}>
<header class="head"><span class="label">AQA 7552 / EXAM PRACTICE</span><h1>AQA Product Design<br /><span>past papers.</span></h1><p>Use the official AQA website to access publicly available A-Level Design & Technology: Product Design (7552) question papers, mark schemes and examiner reports.</p><div class="quick"><a href={aqaPastPapers} target="_blank" rel="noopener noreferrer">AQA past paper finder ↗</a><a href={aqaAssessment} target="_blank" rel="noopener noreferrer">7552 assessment resources ↗</a><a href="/specification/">7552 specification checklist</a></div></header>
<main class="content">
<section class="intro"><div><span class="eyebrow">EXAM STRUCTURE</span><h2>Know what you're practising.</h2></div><div class="facts"><p><strong>7552/1 · Paper 1</strong><br />Technical principles · 2h 30m · 120 marks · 30%</p><p><strong>7552/2 · Paper 2</strong><br />Designing and making principles · 1h 30m · 80 marks · 20%</p><p><strong>7552/C · NEA</strong><br />Substantial design-and-make project · 100 marks · 50%</p></div></section>
<section class="official"><div><span class="eyebrow">OFFICIAL AQA</span><h2>Past papers and mark schemes</h2><p>A-levelDT does not host or reproduce AQA question papers, mark schemes or examiner reports. AQA controls which assessment materials are publicly available. Use AQA's official finder and select Design and Technology: Product Design (7552).</p></div><a href={aqaPastPapers} target="_blank" rel="noopener noreferrer">Open AQA past paper finder ↗</a></section>
<section class="official secondary"><div><span class="eyebrow">7552 RESOURCES</span><h2>Product Design assessment resources</h2><p>For the current set of resources published for specification 7552, use AQA's official assessment-resources page.</p></div><a href={aqaAssessment} target="_blank" rel="noopener noreferrer">Open 7552 resources ↗</a></section>
<p class="source">Only links to assessment materials made publicly available by AQA are provided here. Secure Centre Services materials are not hosted or linked.</p>
</main>
</Base>
<style>
.head{background:linear-gradient(110deg,#f6eafb,#dfcbf6);color:#291743;padding:55px clamp(24px,7vw,112px) 58px}.label,.eyebrow{font-size:11px;letter-spacing:.14em;font-weight:800;color:#7750a0}.head h1{font-size:clamp(44px,5.3vw,75px);margin:25px 0;letter-spacing:-.075em}.head h1 span{color:#8953bc}.head>p{max-width:720px;color:#61506e;font-size:16px}.quick{display:flex;gap:9px;flex-wrap:wrap;margin-top:28px}.quick a{background:#fff9;border:1px solid #cdb4e3;padding:10px 13px;border-radius:999px;font-size:11px;font-weight:800;color:#5d347b}.content{padding:55px clamp(24px,7vw,112px) 90px;background:#fffaf7}.intro{display:grid;grid-template-columns:.85fr 1.15fr;gap:45px;padding-bottom:55px}.intro h2,.official h2{font-size:clamp(30px,3vw,45px);margin:9px 0}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.facts p{background:white;border:1px solid #e5daef;border-radius:12px;padding:20px;font-size:12px;color:#71647d}.facts strong{color:#35213f;font-size:13px}.official{display:flex;justify-content:space-between;align-items:end;gap:30px;background:#321754;color:white;border-radius:14px;padding:30px;margin-bottom:16px}.official.secondary{background:#f1e6f7;color:#321754;border:1px solid #dfcde9}.official .eyebrow{color:#d9b8f2}.official.secondary .eyebrow{color:#7750a0}.official h2{color:white}.official.secondary h2{color:#321754}.official p{font-size:12px;color:#d9cce2;max-width:650px}.official.secondary p{color:#65566d}.official>a{flex:none;background:white;color:#321754;padding:13px 16px;border-radius:7px;font-size:11px;font-weight:850}.official.secondary>a{background:#321754;color:white}.source{font-size:11px;color:#807386;margin-top:18px}@media(max-width:800px){.intro{grid-template-columns:1fr}.facts{grid-template-columns:1fr}.official{align-items:start;flex-direction:column}}
</style>