---
import Base from '../layouts/Base.astro';import { syllabus,subtopicPath } from '../data/syllabus.js';import { hasSubtopicNotes } from '../data/contentStatus.js';const items=syllabus.flatMap(g=>g.topics.flatMap(([code,title,subs])=>subs.filter(sub=>hasSubtopicNotes(code,sub)).map(sub=>({code,title,sub,path:subtopicPath(code,sub)}))));
---
<Base noindex title="Search A-Level DT Revision Notes | AQA 7552" description="Search AQA A-Level Product Design 7552 revision topics including materials, processes, CAD, designers and manufacturing."><main class="page"><header><span class="eyebrow">FIND A TOPIC</span><h1>Search your revision<span>.</span></h1><input id="search" autofocus placeholder="Try polymers, CAD, designers, finishes..."/></header><div>{items.map(x=><a class="result" data-search={(x.code+' '+x.title+' '+x.sub).toLowerCase()} href={x.path}><small>{x.code} · {x.title}</small><strong>{x.sub}</strong><span>Open notes →</span></a>)}</div></main><script is:inline>const input=document.querySelector('#search'),rows=[...document.querySelectorAll('.result')];input.oninput=()=>{let q=input.value.toLowerCase().trim();rows.forEach(r=>r.hidden=q&&!r.dataset.search.includes(q))}</script></Base><style>.page{padding:48px clamp(24px,7vw,110px) 90px;background:#fbf8f5;min-height:100vh}.page header{max-width:900px}.page h1{font-size:clamp(45px,5vw,72px);margin:12px 0}.page h1 span{color:#9c61b9}.page input{width:100%;padding:17px 20px;border:1px solid #ded2e4;border-radius:10px;background:#fff;font-size:17px;margin:15px 0 30px}.result{display:grid;grid-template-columns:1fr auto;background:#fff;border:1px solid #e8dfea;border-radius:10px;padding:18px 20px;margin:9px 0}.result small{grid-column:1/-1;color:#9064a7;font-size:10px}.result strong{font-size:17px;margin-top:4px}.result span{font-size:11px;color:#75449a;font-weight:800;align-self:end}</style>