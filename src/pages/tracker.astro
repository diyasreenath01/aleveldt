---
import Base from '../layouts/Base.astro';
import { syllabus, subtopicPath } from '../data/syllabus.js';
import { hasSubtopicNotes } from '../data/contentStatus.js';
const total = syllabus.reduce((n,g)=>n+g.topics.reduce((m,t)=>m+t[2].length,0),0);
---
<Base noindex title="A-Level DT Revision Tracker | AQA Product Design 7552" description="Track your progress through every AQA A-Level Product Design 7552 revision topic and identify areas that need more practice."><main class="tracker"><header><span class="eyebrow">AQA 7552 · REVISION TRACKER</span><h1>Know exactly what you've covered<span>.</span></h1><p>Set a status for every subtopic. Your progress is saved on this device automatically.</p></header><section class="progress-card"><div><strong id="progress-text">0%</strong><span>overall progress</span></div><div class="bar"><i id="progress-bar"></i></div><small id="progress-count">0 of {total} subtopics confident</small></section><div class="legend"><span>○ Not started</span><span>🟠 Learning</span><span>🟣 Confident</span><span>🔴 Needs revision</span></div>{syllabus.map((group,gi)=><section class="group"><div class="group-title"><span>PAPER {gi+1}</span><h2>{group.title}</h2></div>{group.topics.map(([code,title,subs])=><details class="topic"><summary><div><small>{code}</small><strong>{title}</strong></div><span>{subs.length} subtopics⌄</span></summary><div class="subs">{subs.map(sub=><div class="sub" data-key={code+'::'+sub}>{hasSubtopicNotes(code,sub) ? <a href={subtopicPath(code,sub)}><strong>{sub}</strong><small>Open notes ↗</small></a> : <div><strong>{sub}</strong><small>Notes coming soon</small></div>}<div class="states"><button data-status="not" title="Not started"></button><button data-status="learning" title="Learning"></button><button data-status="confident" title="Confident"></button><button data-status="revise" title="Needs revision"></button></div></div>)}</div></details>)}</section>)}</main><script is:inline>
const KEY='adt-progress-v1',rows=[...document.querySelectorAll('.sub')];let state={};try{state=JSON.parse(localStorage.getItem(KEY)||'{}')}catch{}function paint(){let n=0;rows.forEach(r=>{let s=state[r.dataset.key]||'not';r.querySelectorAll('button').forEach(b=>b.classList.toggle('selected',b.dataset.status===s));if(s==='confident')n++});let p=Math.round(n/rows.length*100);document.querySelector('#progress-text').textContent=p+'%';document.querySelector('#progress-bar').style.width=p+'%';document.querySelector('#progress-count').textContent=n+' of '+rows.length+' subtopics confident'}rows.forEach(r=>r.querySelectorAll('button').forEach(b=>b.onclick=()=>{state[r.dataset.key]=b.dataset.status;localStorage.setItem(KEY,JSON.stringify(state));paint()}));paint();
</script></Base>
<style>.tracker{padding:48px clamp(24px,6vw,92px) 90px;background:#fbf8f5;min-height:100vh}.tracker>header{max-width:850px}.tracker h1{font-size:clamp(42px,5vw,72px);margin:12px 0}.tracker h1 span{color:#9b5eb7}.tracker header p{font-size:18px;color:#6d6074}.progress-card{margin:34px 0 18px;background:linear-gradient(110deg,#f1e4f8,#faf0f5 70%,#fff5e7);border:1px solid #e7d9ea;border-radius:16px;padding:25px 28px}.progress-card>div:first-child{display:flex;align-items:baseline;gap:10px}.progress-card strong{font:800 35px Manrope}.progress-card span,.progress-card small{color:#74637c;font-size:12px}.bar{height:10px;background:#e8dfe8;border-radius:20px;margin:16px 0 10px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:#693694;border-radius:20px;transition:width .3s}.legend{display:flex;gap:20px;flex-wrap:wrap;margin:20px 0 38px;font-size:12px;color:#6b5d72}.group{margin-top:42px}.group-title span{font-size:10px;letter-spacing:.15em;font-weight:800;color:#8c61a5}.group-title h2{font-size:34px;margin:6px 0 18px}.topic{background:#fff;border:1px solid #e9dfe8;border-radius:12px;margin:10px 0;overflow:hidden}.topic summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:18px 22px;gap:20px;list-style:none}.topic summary div{display:flex;align-items:center;gap:18px}.topic summary small{color:#946daa;font-weight:800}.topic summary>span{font-size:11px;color:#897b8e}.subs{border-top:1px solid #eee6ee}.sub{display:grid;grid-template-columns:1fr auto;align-items:center;gap:20px;padding:14px 22px;border-bottom:1px solid #f1eaf1}.sub>a{display:flex;flex-direction:column;gap:3px}.sub>a small{font-size:10px;color:#8350a2}.states{display:flex;gap:9px}.states button{width:17px;height:17px;border-radius:50%;border:2px solid #b7aab9;background:#fff;padding:0;cursor:pointer;opacity:.3}.states button[data-status=learning]{background:#d99a2b;border-color:#d99a2b}.states button[data-status=confident]{background:#6634bd;border-color:#6634bd}.states button[data-status=revise]{background:#c84a5a;border-color:#c84a5a}.states button.selected{opacity:1;transform:scale(1.2);box-shadow:0 0 0 3px #eee5f2}@media(max-width:650px){.tracker{padding:35px 20px 70px}.topic summary>span{display:none}.sub{grid-template-columns:1fr}.group-title h2{font-size:28px}}</style>