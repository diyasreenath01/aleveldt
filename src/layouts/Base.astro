---
const { title = 'A-level DT | Product Design revision', description = 'AQA A-level Product Design revision notes and past papers.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#321850" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><title>{title}</title></head>
<body><div class="app"><aside class="sidebar" id="site-sidebar"><a class="brand" href="/" aria-label="A-level DT home">A<span>·</span>DT <small>STUDY SPACE</small></a><div class="course-tag"><b>A-LEVEL / AQA</b><strong>Product Design</strong><small>Specification 7552</small></div><nav aria-label="Main navigation"><span>STUDY</span><a class={path === '/' ? 'active' : ''} href="/"><i aria-hidden="true">▦</i> Overview</a><a class={path.startsWith('/notes/') ? 'active' : ''} href="/notes/"><i aria-hidden="true">▤</i> Revision notes</a><a class={path.startsWith('/past-papers/') ? 'active' : ''} href="/past-papers/"><i aria-hidden="true">◫</i> Past papers</a><span class="nav-sub">THE SPECIFICATION</span><a href="/notes/#technical"><i aria-hidden="true">01</i> Technical principles</a><a href="/notes/#designing"><i aria-hidden="true">02</i> Designing & making</a></nav><div class="sidebar-foot">Made for AQA Product Design<br />students, one topic at a time.</div></aside><div class="workspace"><header class="topbar"><button class="menu-toggle" type="button" aria-controls="site-sidebar" aria-expanded="true"><span aria-hidden="true">☰</span><span class="menu-label">Hide menu</span></button><span>AQA A-level Design & Technology <b>/</b> Product Design</span><a href="/notes/">Explore topics <span>↗</span></a></header><main><slot /></main><footer class="footer"><span>A-levelDT · AQA 7552</span><span>Content organised around the official specification.</span><span>© {new Date().getFullYear()}</span></footer></div></div><script is:inline>
  const toggle = document.querySelector('.menu-toggle');
  const app = document.querySelector('.app');
  const setSidebar = open => {
    app.classList.toggle('sidebar-hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.menu-label').textContent = open ? 'Hide menu' : 'Show menu';
  };
  try { setSidebar(localStorage.getItem('sidebar-open') !== 'false'); } catch (_) {}
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setSidebar(open);
    try { localStorage.setItem('sidebar-open', String(open)); } catch (_) {}
  });
</script></body></html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#291a3c;background:#fbf8f5;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}button,input{font:inherit}::selection{background:#dfc9fb}:focus-visible{outline:3px solid #a66ef2;outline-offset:3px}.app{max-width:1900px;margin:auto;display:grid;grid-template-columns:246px minmax(0,1fr);min-height:100vh}.app.sidebar-hidden{grid-template-columns:minmax(0,1fr)}.sidebar-hidden .sidebar{display:none}.sidebar{position:sticky;top:0;height:100vh;background:#321850;color:#f8f0ff;padding:27px 17px;display:flex;flex-direction:column}.brand{font:800 30px Manrope,sans-serif;letter-spacing:-.12em;padding:0 14px;display:flex;align-items:baseline;white-space:nowrap}.brand span{color:#e2bfff}.brand small{font:800 9px 'DM Sans',sans-serif;letter-spacing:.12em;color:#c6a8dd;margin-left:13px}.course-tag{margin:30px 3px 30px;background:#ffffff16;border:1px solid #ffffff1b;border-radius:12px;padding:16px;display:grid;gap:5px}.course-tag b{font-size:9px;letter-spacing:.15em;color:#d5b0f4}.course-tag strong{font-size:15px}.course-tag small{font-size:11px;color:#d5c0e7}.sidebar nav{display:grid;gap:3px}.sidebar nav>span{font-size:9px;letter-spacing:.16em;color:#b999d2;font-weight:800;padding:10px 15px}.sidebar nav>.nav-sub{margin-top:23px}.sidebar nav a{font-size:14px;font-weight:700;padding:12px 13px;border-radius:8px;display:flex;align-items:center;gap:13px;transition:background .2s,color .2s}.sidebar nav a:hover,.sidebar nav a.active{background:#ffffff22;color:white}.sidebar nav a.active{box-shadow:inset 3px 0 #d7aeff}.sidebar nav i{font-style:normal;color:#dfbef7;font-size:17px;width:21px;text-align:center}.sidebar nav .nav-sub~a i{font-size:10px}.sidebar-foot{margin-top:auto;border-top:1px solid #ffffff30;padding:20px 14px 0;color:#bda4d3;font-size:10px;line-height:1.65}.workspace{min-width:0}.topbar{height:68px;padding:0 clamp(22px,4vw,62px);border-bottom:1px solid #ece4eb;background:#fffdfa;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;font-weight:700;color:#75677e}.menu-toggle{border:1px solid #e6ddeb;border-radius:7px;background:#fff;color:#593879;cursor:pointer;padding:8px 10px;display:inline-flex;gap:8px;align-items:center;font-size:11px;font-weight:800;white-space:nowrap}.menu-toggle:hover{background:#f3e8fa}.topbar b{color:#b49dbd;margin:0 8px}.topbar>a{color:#613594;font-weight:800;white-space:nowrap}.footer{padding:28px clamp(22px,4vw,62px);border-top:1px solid #ede6ee;background:#fffdfa;display:flex;justify-content:space-between;gap:15px;color:#8b7f90;font-size:10px}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Manrope,sans-serif;letter-spacing:-.06em}h1{line-height:1.09}h2{line-height:1.13}p{line-height:1.65}.eyebrow{font-size:10px;letter-spacing:.15em;font-weight:800;color:#8659b4}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:25px;background:#512679;color:#fff;border-radius:7px;padding:13px 18px;font-weight:800;font-size:12px;transition:transform .2s}.button:hover{transform:translateY(-2px)}@media(max-width:870px){.app{grid-template-columns:1fr}.app.sidebar-hidden{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:12px 18px;display:flex;flex-direction:row;align-items:center;gap:18px;overflow:auto}.brand{padding:0;font-size:23px}.brand small,.course-tag,.sidebar-foot,.sidebar nav>span,.sidebar nav>.nav-sub,.sidebar nav .nav-sub~a{display:none}.sidebar nav{display:flex;margin-left:auto;gap:4px}.sidebar nav a{padding:9px;font-size:11px;white-space:nowrap}.sidebar nav a i{display:none}.topbar{height:49px}.footer{flex-wrap:wrap}.footer span:nth-child(2){display:none}}@media(max-width:560px){.sidebar{display:block}.brand{float:left;margin:6px 0}.sidebar nav{justify-content:flex-end}.sidebar nav a{font-size:0;padding:10px 7px}.sidebar nav a:nth-of-type(1)::after{content:'Home';font-size:10px}.sidebar nav a:nth-of-type(2)::after{content:'Notes';font-size:10px}.sidebar nav a:nth-of-type(3)::after{content:'Papers';font-size:10px}.topbar{font-size:10px}.topbar>a{display:none}.menu-label{display:none}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
