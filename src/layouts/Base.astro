---
const { title = 'A-Level DT Notes | AQA Product Design 7552 Revision', description = 'Free AQA A-Level Design and Technology Product Design 7552 revision notes, quizzes, flashcards, exam practice and past-paper support.' } = Astro.props;
const path = Astro.url.pathname;
const canonicalURL = new URL(path, Astro.site ?? Astro.url.origin);
const socialTitle = title;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'A-levelDT',
  alternateName: 'A-Level DT Notes',
  url: 'https://aleveldt.com/',
  description,
  inLanguage: 'en',
  about: { '@type': 'Course', name: 'AQA A-Level Design and Technology: Product Design (7552)' }
};
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="robots" content="index,follow,max-image-preview:large" /><link rel="canonical" href={canonicalURL} /><meta property="og:type" content="website" /><meta property="og:site_name" content="A-levelDT" /><meta property="og:title" content={socialTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalURL} /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content={socialTitle} /><meta name="twitter:description" content={description} /><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><meta name="theme-color" content="#321850" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><title>{title}</title>  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body><div class="app"><aside class="sidebar" id="site-sidebar"><a class="brand" href="/" aria-label="A-level DT home">A<span>·</span>DT <small>STUDY SPACE</small></a><div class="course-tag"><b>A-LEVEL / AQA</b><strong>Product Design</strong><small>Specification 7552</small></div><nav aria-label="Main navigation"><span>STUDY</span><a class={path === '/' ? 'active' : ''} href="/"><i aria-hidden="true">▦</i> Overview</a><a class={path.startsWith('/notes/') ? 'active' : ''} href="/notes/"><i aria-hidden="true">▤</i> Revision notes</a><a class={path.startsWith('/past-papers/') ? 'active' : ''} href="/past-papers/"><i aria-hidden="true">◫</i> Past papers</a><a class={path.startsWith('/tracker') ? 'active' : ''} href="/tracker/"><i aria-hidden="true">✓</i> Revision tracker</a><a class={path.startsWith('/quiz') ? 'active' : ''} href="/quiz/"><i aria-hidden="true">?</i> Quiz mode</a><a class={path.startsWith('/flashcards') ? 'active' : ''} href="/flashcards/"><i aria-hidden="true">◇</i> Flashcards</a><a class={path.startsWith('/about') ? 'active' : ''} href="/about/"><i aria-hidden="true">○</i> About A·DT</a><span class="nav-sub">THE SPECIFICATION</span><a href="/notes/#technical"><i aria-hidden="true">01</i> Technical principles</a><a href="/notes/#designing"><i aria-hidden="true">02</i> Designing & making</a></nav><div class="sidebar-foot">Made for AQA Product Design<br />students, one topic at a time.</div></aside><div class="workspace"><header class="topbar"><button class="menu-toggle" type="button" aria-controls="site-sidebar" aria-expanded="true"><span aria-hidden="true">☰</span><span class="menu-label">Hide menu</span></button><span>AQA A-level Design & Technology <b>/</b> Product Design</span><a class="top-search" href="/search/"><span>⌕</span> Search notes</a></header><main><slot /></main><footer class="footer"><span>A-levelDT · AQA 7552</span><span>Content organised around the official specification.</span><span>© {new Date().getFullYear()}</span></footer></div></div><script is:inline>
  const toggle = document.querySelector('.menu-toggle');
  const app = document.querySelector('.app');
  const setSidebar = open => {
    app.classList.toggle('sidebar-hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.menu-label').textContent = open ? 'Hide menu' : 'Show menu';
  };
  try { setSidebar(localStorage.getItem('sidebar-open') !== 'false'); } catch (_) {}
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setSidebar(open);
    try { localStorage.setItem('sidebar-open', String(open)); } catch (_) {}
  });
</script><script is:inline>
  document.querySelectorAll('.prose').forEach(prose => {
    if (!prose.querySelector(':scope > .note-panel')) {
      [...prose.children].filter(node => node.tagName === 'H2').forEach(heading => {
        const panel = document.createElement('section');
        panel.className = 'note-panel';
        prose.insertBefore(panel, heading);
        let node = heading;
        while (node && (node === heading || node.tagName !== 'H2')) {
          const next = node.nextElementSibling;
          panel.appendChild(node);
          node = next;
        }
      });
    }
    prose.querySelectorAll(':scope > .note-panel').forEach(panel => {
      const heading = panel.querySelector(':scope > h2');
      if (!heading) return;
      const head = document.createElement('div');
      head.className = 'note-panel-head';
      panel.insertBefore(head, heading);
      head.appendChild(heading);
      const intro = panel.querySelector(':scope > .note-intro');
      if (intro) head.appendChild(intro);
      else {
        let next = head.nextElementSibling;
        while (next && next.tagName !== 'H3' && next.tagName !== 'HR' && !next.classList.contains('note-grid')) {
          const following = next.nextElementSibling;
          head.appendChild(next);
          next = following;
        }
      }
      if (!panel.querySelector(':scope > .note-grid')) {
        const grid = document.createElement('div');
        grid.className = 'note-grid';
        let child = head.nextElementSibling;
        let card;
        while (child) {
          const following = child.nextElementSibling;
          if (child.tagName === 'H3') {
            card = document.createElement('div');
            card.className = 'study-card';
            grid.appendChild(card);
          }
          if (card) card.appendChild(child);
          else head.appendChild(child);
          child = following;
        }
        if (grid.childElementCount) panel.appendChild(grid);
      }
    });
  });
</script></body></html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#291a3c;background:#fbf8f5;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}button,input{font:inherit}::selection{background:#dfc9fb}:focus-visible{outline:3px solid #a66ef2;outline-offset:3px}.app{max-width:1900px;margin:auto;display:grid;grid-template-columns:246px minmax(0,1fr);min-height:100vh}.app.sidebar-hidden{grid-template-columns:minmax(0,1fr)}.sidebar-hidden .sidebar{display:none}.sidebar{position:sticky;top:0;height:100vh;background:#321850;color:#f8f0ff;padding:27px 17px;display:flex;flex-direction:column}.brand{font:800 30px Manrope,sans-serif;letter-spacing:-.12em;padding:0 14px;display:flex;align-items:baseline;white-space:nowrap}.brand span{color:#e2bfff}.brand small{font:800 9px 'DM Sans',sans-serif;letter-spacing:.12em;color:#c6a8dd;margin-left:13px}.course-tag{margin:30px 3px 30px;background:#ffffff16;border:1px solid #ffffff1b;border-radius:12px;padding:16px;display:grid;gap:5px}.course-tag b{font-size:9px;letter-spacing:.15em;color:#d5b0f4}.course-tag strong{font-size:15px}.course-tag small{font-size:11px;color:#d5c0e7}.sidebar nav{display:grid;gap:3px}.sidebar nav>span{font-size:9px;letter-spacing:.16em;color:#b999d2;font-weight:800;padding:10px 15px}.sidebar nav>.nav-sub{margin-top:23px}.sidebar nav a{font-size:14px;font-weight:700;padding:12px 13px;border-radius:8px;display:flex;align-items:center;gap:13px;transition:background .2s,color .2s}.sidebar nav a:hover,.sidebar nav a.active{background:#ffffff22;color:white}.sidebar nav a.active{box-shadow:inset 3px 0 #d7aeff}.sidebar nav i{font-style:normal;color:#dfbef7;font-size:17px;width:21px;text-align:center}.sidebar nav .nav-sub~a i{font-size:10px}.sidebar-foot{margin-top:auto;border-top:1px solid #ffffff30;padding:20px 14px 0;color:#bda4d3;font-size:10px;line-height:1.65}.workspace{min-width:0}.topbar{height:68px;padding:0 clamp(22px,4vw,62px);border-bottom:1px solid #ece4eb;background:#fffdfa;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;font-weight:700;color:#75677e}.menu-toggle{border:1px solid #e6ddeb;border-radius:7px;background:#fff;color:#593879;cursor:pointer;padding:8px 10px;display:inline-flex;gap:8px;align-items:center;font-size:11px;font-weight:800;white-space:nowrap}.menu-toggle:hover{background:#f3e8fa}.topbar b{color:#b49dbd;margin:0 8px}.topbar>a{color:#613594;font-weight:800;white-space:nowrap}.top-search{border:1px solid #e6ddeb;border-radius:8px;padding:8px 13px;background:#fff;display:flex;gap:8px;align-items:center}.top-search:hover{background:#f7effa}.footer{padding:28px clamp(22px,4vw,62px);border-top:1px solid #ede6ee;background:#fffdfa;display:flex;justify-content:space-between;gap:15px;color:#8b7f90;font-size:10px}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Manrope,sans-serif;letter-spacing:-.06em}h1{line-height:1.09}h2{line-height:1.13}p{line-height:1.65}.eyebrow{font-size:10px;letter-spacing:.15em;font-weight:800;color:#8659b4}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:25px;background:#512679;color:#fff;border-radius:7px;padding:13px 18px;font-weight:800;font-size:12px;transition:transform .2s}.button:hover{transform:translateY(-2px)}@media(max-width:870px){.app{grid-template-columns:1fr}.app.sidebar-hidden{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:12px 18px;display:flex;flex-direction:row;align-items:center;gap:18px;overflow:auto}.brand{padding:0;font-size:23px}.brand small,.course-tag,.sidebar-foot,.sidebar nav>span,.sidebar nav>.nav-sub,.sidebar nav .nav-sub~a{display:none}.sidebar nav{display:flex;margin-left:auto;gap:4px}.sidebar nav a{padding:9px;font-size:11px;white-space:nowrap}.sidebar nav a i{display:none}.topbar{height:49px}.footer{flex-wrap:wrap}.footer span:nth-child(2){display:none}}@media(max-width:560px){.sidebar{display:block}.brand{float:left;margin:6px 0}.sidebar nav{justify-content:flex-end}.sidebar nav a{font-size:0;padding:10px 7px}.sidebar nav a:nth-of-type(1)::after{content:'Home';font-size:10px}.sidebar nav a:nth-of-type(2)::after{content:'Notes';font-size:10px}.sidebar nav a:nth-of-type(3)::after{content:'Papers';font-size:10px}.topbar{font-size:10px}.topbar>a{display:none}.menu-label{display:none}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
.app .workspace .prose .note-panel{background:#fff;border:1px solid #e8e0ed;border-radius:18px;margin:28px 0 40px;padding:0;overflow:hidden;box-shadow:0 10px 32px #4221520d}.app .workspace .prose .note-panel-head{background:linear-gradient(105deg,#f3e9fa,#f9eef5 63%,#faf6f0);padding:clamp(23px,3vw,39px);border-bottom:1px solid #eadfec}.app .workspace .prose .note-panel-head h2{border:0;background:none;padding:0 0 14px;margin:0 0 14px;color:#2d1a40;font-size:clamp(28px,2.7vw,39px);line-height:1.2;position:relative}.app .workspace .prose .note-panel-head h2::after{content:'';position:absolute;left:0;bottom:0;width:70px;height:3px;border-radius:5px;background:#9a62b9}.app .workspace .prose .note-panel-head p{margin:0 0 12px;color:#55485f}.app .workspace .prose .note-panel-head p:last-child{margin-bottom:0}.app .workspace .prose .note-grid{display:grid;grid-template-columns:1fr;gap:18px;padding:clamp(24px,2.8vw,40px);align-items:start}.app .workspace .prose .note-grid > .study-card{border:1px solid #e8ddec;border-radius:13px;background:#fdfaff;margin:0;padding:28px 32px;box-shadow:none;width:100%}.app .workspace .prose .note-grid > .study-card h3{border:0;background:none;padding:0;margin:0 0 12px;color:#542b79;font-size:1.12em}.app .workspace .prose .note-grid > .study-card p{border:0;background:none;padding:0;margin:0 0 14px;box-shadow:none}.app .workspace .prose .note-grid > .study-card p:last-child{margin-bottom:0}.app .workspace .prose .note-panel p > strong:only-child{color:inherit;font-weight:inherit}.app .workspace .prose .note-panel .table-wrap{width:100%;overflow-x:auto}.app .workspace .prose .note-panel-head .table-wrap{margin:15px 0 0}@media(max-width:900px){.app .workspace .prose .note-grid{grid-template-columns:1fr}}.app .workspace .prose .note-grid > .note-group-title{grid-column:1/-1;padding:4px 2px 0}.app .workspace .prose .note-group-title h3{border:0;background:none;padding:0;margin:0 0 3px;font-size:1.18em;color:#45215f}.app .workspace .prose .note-grid .study-card h4{color:#542b79;font-size:1.06em;line-height:1.3;margin:0 0 14px;font-family:Manrope,sans-serif;letter-spacing:-.035em}.app .workspace .prose .note-grid .study-card h4 ~ p{position:relative;padding-left:19px}.app .workspace .prose .note-grid .study-card h4 ~ p::before{content:'•';position:absolute;left:0;color:#9054b2;font-weight:800}</style>
