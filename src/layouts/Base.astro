---
const { title = 'A-level DT | Product Design revision', description = 'AQA A-level Product Design revision notes and past papers.' } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#24103f" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /><title>{title}</title></head>
<body><div class="shell"><header class="site-header"><a class="brand" href="/" aria-label="A-level DT home">A-level<span>DT.</span></a><nav aria-label="Main navigation"><a href="/notes/">Revision notes</a><a href="/past-papers/">Past papers</a></nav><a class="header-link" href="/notes/">Explore topics ↗</a></header><main><slot /></main><footer class="footer"><a class="brand" href="/">A-level<span>DT.</span></a><span>AQA Product Design / 7552</span><span>© {new Date().getFullYear()} A-level DT</span></footer></div></body></html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#25163a;background:#fffaf7;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}button,input{font:inherit}::selection{background:#cbb0f4;color:#24103f}:focus-visible{outline:3px solid #a66ef2;outline-offset:4px}.shell{max-width:1800px;margin:auto}.site-header{height:80px;padding:0 clamp(24px,8vw,128px);display:flex;align-items:center;gap:50px;background:#fffaf7;border-bottom:1px solid #eadfee}.brand{font-family:Manrope,sans-serif;font-size:22px;font-weight:800;letter-spacing:-.075em;white-space:nowrap}.brand span{color:#865ab9}.site-header nav{display:flex;gap:36px;margin:auto;font-size:12px;font-weight:750}.site-header nav a,.header-link{transition:color .2s}.site-header nav a:hover,.header-link:hover{color:#8952c6}.header-link{font-size:12px;font-weight:800}.footer{border-top:1px solid #eadfee;padding:43px clamp(24px,8vw,128px);display:flex;justify-content:space-between;align-items:center;gap:20px;color:#776a82;font-size:12px}.footer .brand{color:#25163a}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Manrope,sans-serif;letter-spacing:-.06em}h1{line-height:1.08}h2{line-height:1.13}p{line-height:1.7}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.15em;font-weight:800;color:#8952c6}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;background:#eee4ff;color:#25163a;border-radius:3px;padding:16px 20px;font-weight:800;font-size:13px;transition:transform .25s,background .25s}.button:hover{background:white;transform:translateY(-3px)}@media(max-width:670px){.site-header{height:72px;gap:18px}.brand{font-size:19px}.site-header nav{margin-left:auto;gap:16px;font-size:11px}.header-link{display:none}.footer{flex-wrap:wrap}.footer span:last-child{width:100%}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
