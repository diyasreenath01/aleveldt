---
const { title = 'A-level DT — Design knowledge, beautifully organised', description = 'Thoughtful, clear revision notes for A-level Design & Technology.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="A-level DT home"><span class="brand-mark">a<span>·</span></span><span>A-level<span class="brand-light">DT</span></span></a>
        <nav aria-label="Main navigation"><a href="/notes/">Explore notes</a><a href="/about/">About</a></nav>
        <a class="header-cta" href="/notes/">Start studying <span aria-hidden="true">↗</span></a>
      </header>
      <main><slot /></main>
      <footer class="site-footer"><a class="brand" href="/"><span class="brand-mark">a<span>·</span></span><span>A-level<span class="brand-light">DT</span></span></a><span>Made for curious minds and better design.</span><span>© {new Date().getFullYear()} A-level DT</span></footer>
    </div>
  </body>
</html>
<style is:global>
  :root{font-family:'DM Sans',sans-serif;color:#252620;background:#f7f6f2;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}button,input{font:inherit}::selection{background:#dae9b6}.site-shell{max-width:1600px;margin:auto}.site-header{height:94px;padding:0 clamp(24px,5.3vw,96px);display:flex;align-items:center;gap:52px;border-bottom:1px solid #e9e9e2}.brand{display:inline-flex;align-items:center;gap:12px;font-family:Manrope,sans-serif;font-weight:800;font-size:21px;letter-spacing:-1.2px;white-space:nowrap}.brand-mark{width:33px;height:33px;background:#bfe182;border-radius:9px;display:grid;place-items:center;font-size:22px;line-height:1;letter-spacing:-3px;padding-right:4px}.brand-mark span{color:#719839}.brand-light{font-weight:500}.site-header nav{display:flex;gap:38px;margin:auto;font-size:13px;font-weight:700}.site-header nav a:hover,.text-link:hover{color:#749c42}.header-cta{background:#252620;color:#fff;border-radius:7px;padding:14px 19px;font-size:12px;font-weight:700;white-space:nowrap}.header-cta span{margin-left:16px;font-size:16px}.site-footer{border-top:1px solid #e4e4dc;padding:42px clamp(24px,5.3vw,96px);display:flex;justify-content:space-between;align-items:center;gap:20px;color:#777a70;font-size:12px}.site-footer .brand{color:#252620}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:2px;font-weight:800;color:#688d3f}.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid #d8ddce;border-radius:50px;padding:8px 12px;font-size:11px;font-weight:700}.pill i{width:6px;height:6px;border-radius:50%;background:#80ab49}.section-pad{padding:85px clamp(24px,8.5vw,138px)}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Manrope,sans-serif;letter-spacing:-.055em}h1{font-size:clamp(48px,5.3vw,86px);line-height:1.08}h2{font-size:clamp(34px,3.3vw,52px);line-height:1.16}p{line-height:1.8}.text-link{font-size:13px;font-weight:800;text-decoration:underline;text-underline-offset:5px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:42px;background:#bfe182;border-radius:7px;padding:17px 20px;font-weight:800;font-size:13px}.button:hover{background:#afe071}@media(max-width:650px){.site-header{height:72px;gap:12px}.brand{font-size:17px}.brand-mark{width:29px;height:29px}.site-header nav{margin-left:auto;gap:16px;font-size:11px}.header-cta{display:none}.section-pad{padding:65px 24px}.site-footer{flex-wrap:wrap}.site-footer>span:nth-child(2){width:100%;order:3}}
</style>
