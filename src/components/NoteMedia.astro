---
const { code, slug } = Astro.props;
const key = `${code}/${slug}`;
const C='https://commons.wikimedia.org/wiki/Special:FilePath/';
const pageMedia = {
'3.1.1/methods-for-investigating-and-testing-materials': {src:'https://courses.ems.psu.edu/matse81/sites/matse81/files/images/lesson04/stress_strain_testing.jpg',alt:'Tensile testing machine and standard test specimen',caption:'Tensile testing: a controlled load is applied to a standard specimen so strength and deformation can be measured.'},
'3.1.2/woods': {src:'https://www.wonkeedonkeetrend.co.uk/media/wysiwyg/Trend-router-cutters/IMG_2_8.jpg',alt:'Hardwood, softwood, MDF, plywood and chipboard samples',caption:'Natural and manufactured timbers: compare solid woods with MDF, plywood and chipboard.'},
'3.1.2/metals': {src:'https://cf3.ppt-online.org/files3/slide/4/4xTRfj7DnKMkJFE2QqIYti8CmgdVGAlvuywLr5/slide-5.jpg',alt:'Examples of common metals and alloys',caption:'Common engineering metals and alloys: connect appearance with properties and applications.'},
'3.1.2/polymers': {src:'https://www.researchgate.net/publication/367211404/figure/fig1/AS%3A11431281113643605%401674002000935/Plastic-types-thermoplastics-vs-thermosetting-plastics.ppm',alt:'Thermoplastics and thermosetting plastics comparison',caption:'Thermoplastics and thermosets differ in structure, behaviour when heated and applications.'},
'3.1.2/composites': {src:'https://images.squarespace-cdn.com/content/v1/673760fb69e08770836ac3fc/57d15dcd-5def-4e7b-bce2-c8e3060052e8/iStock-622210996-low.jpg',alt:'Carbon fibre and glass fibre reinforcement',caption:'Composite reinforcement fabrics are combined with a matrix such as resin.'},
'3.1.2/smart-materials': {src:'https://image1.slideserve.com/2406727/s-m-a-r-t-m-a-t-e-r-i-a-l-s-l.jpg',alt:'Examples of smart materials',caption:'Examples of smart materials and the responses they produce when exposed to a stimulus.'},
'3.1.4/polymer-processes': {src:C+'Injection%20moulding%20process.png',alt:'Injection moulding process stages',caption:'Injection moulding process. A useful reference for understanding how polymer is heated, injected, cooled and removed.'},
'3.1.4/metal-processes': {src:C+'Casting-process.png',alt:'Schematic casting process',caption:'Casting process: molten material fills a mould, solidifies and is removed for finishing.'},
'3.1.4/wood-processes': {src:'https://img.museoinclusivo.com/images/2026/02/An-illustration-comparing-kerf-bending-steam-bending-and-lamination-for-custom-van-framing.jpg',alt:'Kerf bending, steam bending and lamination',caption:'Comparison of methods for producing curved timber forms.'},
'3.1.5/paper-and-board-printing-processes': {src:C+'Flexographic%20printing%20diagram.svg',alt:'Flexographic printing diagram',caption:'Flexographic printing: note the ink, anilox, plate and impression rollers and how the substrate passes through them.'},
'3.1.7/computer-aided-manufacture-cam': {src:'https://cdn.shopify.com/s/files/1/0915/0434/5380/files/CAD_CAM_to_CNC_Machining_workflow.webp?v=1738897001',alt:'CAD CAM to CNC machining workflow',caption:'CAD/CAM to CNC manufacture: digital geometry is converted into toolpaths and machine instructions.'},
'3.1.7/rapid-prototyping-processes': {src:'https://additivemanufacturingresources.com/input_file_2.png',alt:'Labelled FDM 3D printer',caption:'FDM additive manufacture: filament is melted and deposited through a nozzle layer by layer.'},
'3.1.8/inclusive-design': {src:'https://cdn.sanity.io/images/w7j7fz60/production/8e511f5b68ca45d1a599bf26e2dd4a973e9dbf47-2364x1512.png',alt:'Anthropometric workstation dimensions',caption:'Anthropometric data helps designers accommodate a range of users.'},
'3.2.2/design-influences-styles-and-movements': {src:C+'Bauhaus%203%20Chair.jpg',alt:'Bauhaus chair',caption:'A Bauhaus furniture reference showing reduced form, tubular steel and suitability for industrial manufacture.'},
'3.2.2/designers-and-their-work': {src:'https://www.moma.org/media/W1siZiIsIjIxMDc4MyJdLFsicCIsImNvbnZlcnQiLCItcXVhbGl0eSA5MCAtcmVzaXplIDIwMDB4MjAwMFx1MDAzZSJdXQ.jpg?sha=55c484d9075a5929',alt:'Marcel Breuer Model B3 chair',caption:'When revising designers, connect philosophy to recognisable products, materials and manufacturing methods.'}
};
const headingMedia = {
'Vacuum forming':{src:C+'VacuformVisualization.gif',alt:'Animated vacuum forming process',caption:'Vacuum forming: a heated sheet is drawn over a former and held while it cools.'},
'Injection moulding':{src:C+'Injection%20molding%20diagram.svg',alt:'Labelled injection moulding machine diagram',caption:'Injection moulding: granules are melted and driven by a screw through a nozzle into a closed mould.'},
'Extrusion':{src:C+'Schematic%20of%20metal%20extrusion%20process.jpg',alt:'Extrusion process diagram',caption:'Extrusion forces material through a shaped die to create a continuous cross-section.'},
'Blow moulding':{src:C+'Blow%20molding.png',alt:'Labelled blow moulding process',caption:'Blow moulding: air inflates a hot polymer parison against the walls of a mould.'},
'Rotational moulding':{src:'https://cmf.designdb.com/upload/tech/20220224170622362115.jpg',alt:'Rotational moulding stages',caption:'Rotational moulding: polymer coats the inside of a heated rotating mould before cooling.'},
'Flexography':{src:C+'Flexographic%20printing%20diagram.svg',alt:'Flexographic printing press diagram',caption:'Flexography uses a relief plate and rollers to transfer ink to the substrate.'},
'Offset lithography':{src:C+'Offset-diagram.svg',alt:'Offset lithography process diagram',caption:'Offset lithography transfers the image from plate to blanket cylinder and then to the substrate.'}
};
const media = pageMedia[key];
---
{media && <template id="note-page-media" data-key={key}><figure class="note-figure sourced-visual"><img src={media.src} alt={media.alt} loading="lazy" referrerpolicy="no-referrer"/><figcaption>{media.caption}</figcaption></figure></template>}
{Object.entries(headingMedia).map(([heading,m]) => <template class="note-heading-media" data-heading={heading}><figure class="note-figure sourced-visual"><img src={m.src} alt={m.alt} loading="lazy" referrerpolicy="no-referrer"/><figcaption>{m.caption}</figcaption></figure></template>)}
<script>
 const prose=document.querySelector('.prose');
 if(prose){
  const page=document.querySelector('#note-page-media');
  if(page){const node=page.content.cloneNode(true); const panel=prose.querySelector('.note-panel'); panel?.insertAdjacentElement('afterend',node.firstElementChild) || prose.prepend(node);}
  document.querySelectorAll('template.note-heading-media').forEach(t=>{const wanted=(t.dataset.heading||'').toLowerCase();const h=[...prose.querySelectorAll('h2,h3,h4')].find(x=>x.textContent.trim().toLowerCase()===wanted);if(h){const fig=t.content.cloneNode(true).firstElementChild;h.insertAdjacentElement('afterend',fig);}});
 }
</script>
