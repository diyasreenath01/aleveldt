---
const { code, slug } = Astro.props;
const key = `${code}/${slug}`;
const C='https://commons.wikimedia.org/wiki/Special:FilePath/';
const pageMedia = {
'3.1.1/mechanical-and-physical-properties':{src:C+'Stress_strain_ductile.svg',alt:'Stress strain curve for a ductile material',caption:'Stress–strain behaviour helps compare stiffness, strength and ductility.'},
'3.1.1/classification-of-materials':{src:C+'Materials_science_tetrahedron%3Bstructure%2C_processing%2C_performance%2C_and_proprerties.JPG',alt:'Materials science relationship diagram',caption:'Material selection links structure, properties, processing and performance.'},
'3.1.1/methods-for-investigating-and-testing-materials': {src:'https://courses.ems.psu.edu/matse81/sites/matse81/files/images/lesson04/stress_strain_testing.jpg',alt:'Tensile testing machine and standard test specimen',caption:'Tensile testing: a controlled load is applied to a standard specimen so strength and deformation can be measured.'},
'3.1.2/woods': {src:'https://www.wonkeedonkeetrend.co.uk/media/wysiwyg/Trend-router-cutters/IMG_2_8.jpg',alt:'Hardwood softwood and manufactured board samples',caption:'Compare natural timbers with manufactured boards such as MDF, plywood and chipboard.'},
'3.1.2/metals': {src:C+'Metallic_bonding.svg',alt:'Metallic bonding diagram',caption:'Metallic bonding helps explain properties such as electrical conductivity and malleability.'},
'3.1.2/polymers': {src:'https://www.researchgate.net/publication/367211404/figure/fig1/AS%3A11431281113643605%401674002000935/Plastic-types-thermoplastics-vs-thermosetting-plastics.ppm',alt:'Thermoplastics and thermosetting plastics comparison',caption:'Thermoplastics and thermosets differ in structure, behaviour when heated and applications.'},
'3.1.2/biodegradable-polymers':{src:C+'Biodegradable_plastic_utensils.jpg',alt:'Biodegradable polymer utensils',caption:'Biodegradable polymers are increasingly used for short-life products such as disposable foodware.'},
'3.1.2/composites': {src:'https://images.squarespace-cdn.com/content/v1/673760fb69e08770836ac3fc/57d15dcd-5def-4e7b-bce2-c8e3060052e8/iStock-622210996-low.jpg',alt:'Carbon fibre and glass fibre reinforcement',caption:'Composite reinforcement fabrics are combined with a matrix such as resin.'},
'3.1.2/smart-materials': {src:'https://image1.slideserve.com/2406727/s-m-a-r-t-m-a-t-e-r-i-a-l-s-l.jpg',alt:'Examples of smart materials',caption:'Examples of smart materials and the responses they produce when exposed to a stimulus.'},
'3.1.3/metal-enhancement':{src:C+'Iron-carbon-phase-diagram.svg',alt:'Iron carbon phase diagram',caption:'Heat treatment changes the structure and therefore the properties of steels.'},
'3.1.4/paper-and-board-processes':{src:C+'Die_cutting_machine.jpg',alt:'Industrial die cutting machine',caption:'Die cutting is widely used to cut and crease repeatable packaging nets.'},
'3.1.4/polymer-processes': {src:C+'Injection%20moulding%20process.png',alt:'Injection moulding process stages',caption:'Injection moulding: polymer is heated, injected, cooled and removed from the mould.'},
'3.1.4/metal-processes': {src:C+'Casting-process.png',alt:'Schematic casting process',caption:'Casting: molten material fills a mould, solidifies and is removed for finishing.'},
'3.1.4/wood-processes': {src:'https://img.museoinclusivo.com/images/2026/02/An-illustration-comparing-kerf-bending-steam-bending-and-lamination-for-custom-van-framing.jpg',alt:'Kerf bending steam bending and lamination',caption:'Comparison of methods for producing curved timber forms.'},
'3.1.4/jigs-and-fixtures':{src:C+'Drill_jig.jpg',alt:'Drilling jig used to locate and guide a drill',caption:'A jig locates the work and guides the cutting tool so repeated components can be produced accurately.'},
'3.1.5/paper-and-board-printing-processes': {src:C+'Flexographic%20printing%20diagram.svg',alt:'Flexographic printing diagram',caption:'Flexographic printing: note the ink, anilox, plate and impression rollers.'},
'3.1.5/cathodic-protection':{src:C+'Cathodic_protection_diagram.svg',alt:'Cathodic protection diagram',caption:'Cathodic protection uses a more reactive sacrificial metal or an impressed current to protect the main structure.'},
'3.1.6/scales-of-production':{src:C+'Assembly_line.jpg',alt:'Industrial assembly line',caption:'Assembly lines are associated with high-volume mass production and repeated standardised operations.'},
