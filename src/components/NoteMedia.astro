'3.2.2/designers-and-their-work': {src:'https://www.moma.org/media/W1siZiIsIjIxMDc4MyJdLFsicCIsImNvbnZlcnQiLCItcXVhbGl0eSA5MCAtcmVzaXplIDIwMDB4MjAwMFx1MDAzZSJdXQ.jpg?sha=55c484d9075a5929',alt:'Marcel Breuer Model B3 chair',caption:'Connect a designer’s philosophy to recognisable products, materials and manufacturing methods.'},
'3.2.3/product-life-cycle':{src:C+'Product_life-cycle_curve.svg',alt:'Product life cycle curve',caption:'The product life cycle shows how sales typically change through introduction, growth, maturity and decline.'},
'3.2.4/prototype-development':{src:C+'Rapid_prototyping.jpg',alt:'Physical prototype being produced',caption:'Prototypes allow form, function, manufacture and user response to be tested before final production.'},
'3.2.7/measuring-and-marking-out':{src:C+'Vernier_caliper.svg',alt:'Labelled vernier caliper',caption:'Vernier callipers provide more precise dimensional measurement than a standard ruler.'},
'3.2.7/measuring-aids':{src:C+'Micrometer_caliper_parts_0001.png',alt:'Labelled micrometer',caption:'Precision measuring aids reduce uncertainty when checking manufactured dimensions.'},
'3.2.8/environmental-issues':{src:C+'Waste_hierarchy.svg',alt:'Waste hierarchy diagram',caption:'Responsible design prioritises prevention and reuse before recycling, recovery and disposal.'},
'3.2.9/quality-control-qc':{src:C+'Go_no_go_gauge.png',alt:'Go no-go gauge',caption:'Go/no-go gauges provide a fast production check that a component remains within specified limits.'},
'3.2.10/directives-and-labelling-initiatives':{src:C+'Recycling-Code-01.svg',alt:'Polymer recycling identification symbol',caption:'Identification and environmental labels communicate material, recycling and compliance information.'}
};
const headingMedia = {
'Vacuum forming':{src:C+'VacuformVisualization.gif',alt:'Animated vacuum forming process',caption:'Vacuum forming: a heated sheet is drawn over a former and held while it cools.'},
'Injection moulding':{src:C+'Injection%20molding%20diagram.svg',alt:'Labelled injection moulding machine diagram',caption:'Injection moulding: granules are melted and driven by a screw through a nozzle into a closed mould.'},
'Extrusion':{src:C+'Schematic%20of%20metal%20extrusion%20process.jpg',alt:'Extrusion process diagram',caption:'Extrusion forces material through a shaped die to create a continuous cross-section.'},
'Blow moulding':{src:C+'Blow%20molding.png',alt:'Labelled blow moulding process',caption:'Blow moulding: air inflates a hot polymer parison against the walls of a mould.'},
'Rotational moulding':{src:'https://cmf.designdb.com/upload/tech/20220224170622362115.jpg',alt:'Rotational moulding stages',caption:'Rotational moulding: polymer coats the inside of a heated rotating mould before cooling.'},
'Compression moulding':{src:C+'Compression_molding.svg',alt:'Compression moulding diagram',caption:'Compression moulding uses heat and pressure to force a charge into the mould cavity.'},
'Sand casting':{src:C+'Sand_casting.svg',alt:'Sand casting process diagram',caption:'Sand casting uses a pattern to create a mould cavity before molten metal is poured and allowed to solidify.'},
'Die casting':{src:C+'Cold_chamber_die_casting.svg',alt:'Die casting process diagram',caption:'Die casting injects molten metal into a reusable metal die under pressure.'},
'Investment casting':{src:C+'Investment_casting_process.svg',alt:'Investment casting stages',caption:'Investment casting forms a ceramic mould around a sacrificial pattern to create detailed metal components.'},
'MIG welding':{src:C+'GMAW_weld_area.svg',alt:'MIG welding process diagram',caption:'MIG welding feeds a consumable wire electrode into a shielded weld pool.'},
'TIG welding':{src:C+'GTAW.svg',alt:'TIG welding process diagram',caption:'TIG welding uses a non-consumable tungsten electrode and separate filler where required.'},
'Spot welding':{src:C+'Spot_welding.svg',alt:'Resistance spot welding diagram',caption:'Spot welding clamps sheet between electrodes and creates localised heat by electrical resistance.'},
'Steam bending':{src:C+'Steam_bending_wood.jpg',alt:'Timber being steam bent around a former',caption:'Steam softens lignin so timber can be bent around a former and held until dry.'},
'Laminating':{src:C+'Bent_lamination.jpg',alt:'Bent wood lamination clamped around a former',caption:'Thin veneers are glued and clamped around a former to create strong curved laminated components.'},
'Flexography':{src:C+'Flexographic%20printing%20diagram.svg',alt:'Flexographic printing press diagram',caption:'Flexography uses a relief plate and rollers to transfer ink to the substrate.'},
'Offset lithography':{src:C+'Offset-diagram.svg',alt:'Offset lithography process diagram',caption:'Offset lithography transfers the image from plate to blanket cylinder and then to the substrate.'},
'Screen printing':{src:C+'Screen_printing_process.svg',alt:'Screen printing process',caption:'Screen printing pushes ink through open areas of a mesh stencil onto the substrate.'},
'Laser cutting':{src:C+'Laser_cutting_process.svg',alt:'Laser cutting process diagram',caption:'A focused laser beam follows a programmed path while assist gas helps clear the cut.'},
'Milling':{src:C+'Milling_machine_diagram.svg',alt:'Milling machine diagram',caption:'Milling removes material with a rotating multi-point cutter while the work is accurately positioned.'},
'Turning':{src:C+'Lathe-machine.jpg',alt:'Centre lathe showing turning operation',caption:'In turning, the workpiece rotates while a cutting tool removes material to create cylindrical forms.'},
'Finite element analysis (FEA)':{src:C+'Finite_element_method_1D_illustration1.svg',alt:'Finite element mesh illustration',caption:'FEA divides a model into a mesh so stresses and deformation can be calculated.'},
'Computational fluid dynamics (CFD)':{src:C+'CFD_around_airfoil.png',alt:'CFD airflow simulation',caption:'CFD predicts how fluids move around or through a product.'},
'Go/no-go gauges':{src:C+'Go_no_go_gauge.png',alt:'Go no-go gauge',caption:'A go/no-go gauge quickly checks whether a feature lies within its permitted tolerance.'},
'Vernier callipers':{src:C+'Vernier_caliper.svg',alt:'Vernier calliper diagram',caption:'Vernier callipers can measure external, internal and depth dimensions accurately.'},
'Micrometers':{src:C+'Micrometer_caliper_parts_0001.png',alt:'Micrometer diagram',caption:'A micrometer uses a precision screw to measure small dimensions accurately.'}
};
const media = pageMedia[key];
---
{media && <template id="note-page-media" data-key={key}><figure class="note-figure sourced-visual"><img src={media.src} alt={media.alt} loading="lazy" referrerpolicy="no-referrer"/><figcaption>{media.caption}</figcaption></figure></template>}
{Object.entries(headingMedia).map(([heading,m]) => <template class="note-heading-media" data-heading={heading}><figure class="note-figure sourced-visual"><img src={m.src} alt={m.alt} loading="lazy" referrerpolicy="no-referrer"/><figcaption>{m.caption}</figcaption></figure></template>)}
<script>
 const prose=document.querySelector('.prose');
 if(prose){
  const page=document.querySelector('#note-page-media');
  if(page){const node=page.content.cloneNode(true); const panel=prose.querySelector('.note-panel'); panel?.insertAdjacentElement('afterend',node.firstElementChild) || prose.prepend(node);}
  document.querySelectorAll('template.note-heading-media').forEach(t=>{const wanted=(t.dataset.heading||'').toLowerCase();const h=[...prose.querySelectorAll('h2,h3,h4')].find(x=>x.textContent.trim().toLowerCase()===wanted);if(h){const fig=t.content.cloneNode(true).firstElementChild;h.insertAdjacentElement('afterend',fig);}});
 }
</script>
