---
const { code, slug } = Astro.props;
const key = `${code}/${slug}`;
const visuals = {
  '3.1.4/polymer-processes': {title:'Polymer processes — how the material moves', rows:[['Vacuum forming','heat sheet','raise mould','vacuum pulls sheet','cool + trim'],['Injection moulding','granules','heat + screw','inject into mould','cool + eject'],['Blow moulding','make parison','close mould','blow air inside','cool + eject'],['Rotational moulding','powder in mould','heat + rotate','coat inside wall','cool while rotating'],['Extrusion','granules','melt in barrel','force through die','cool + cut']]},
  '3.1.4/metal-processes': {title:'Metal processes — process families', rows:[['Casting','melt metal','fill mould','solidify','remove + finish'],['Press / deep draw','sheet blank','clamp','punch into die','trim'],['Drop forging','heat billet','place in dies','hammer / press','trim + finish'],['Turning','rotate work','feed cutter','remove material','check size'],['Welding','prepare joint','apply heat / arc','fuse joint','inspect weld']]},
  '3.1.4/wood-processes': {title:'Wood processes — key sequences', rows:[['Steam bending','steam timber','soften lignin','bend on former','clamp + dry'],['Laminating','thin layers','apply adhesive','bend on former','clamp + cure'],['Turning','secure work','rotate on lathe','cut to profile','sand + finish'],['CNC routing','CAD model','create toolpath','secure board','machine + inspect']]},
  '3.1.3/metal-enhancement': {title:'Metal heat treatment', rows:[['Case hardening','carburise surface','reheat','quench','hard case + tough core'],['Hardening + tempering','heat steel','quench rapidly','reheat lower','air cool']]},
  '3.1.7/computer-aided-manufacture-cam': {title:'CAD to CAM workflow', rows:[['Digital manufacture','CAD model','CAM toolpath','machine setup','CNC manufacture','quality check']]},
  '3.1.7/rapid-prototyping-processes': {title:'FDM / 3D printing', rows:[['Layer-by-layer build','3D CAD model','slice model','extrude filament','build layers','remove supports']]},
  '3.1.7/production-planning-and-control-ppc-networking': {title:'PPC information flow', rows:[['Connected production','EPOS / demand','MPS planning','materials + people','machines scheduled','production']]},
  '3.2.1/iterative-design-process': {title:'Iterative design cycle', rows:[['Repeat until requirements are met','investigate','design','model / prototype','test','evaluate + refine','↺ repeat']]},
  '3.2.3/product-life-cycle': {title:'Product life cycle', rows:[['Sales over time','introduction','growth','maturity','decline','replacement / redevelopment']]},
  '3.2.4/the-use-of-a-design-process': {title:'Design process at a glance', rows:[['Development route','brief + research','specification','ideas','model / prototype','test + evaluate','plan manufacture']]},
  '3.2.7/measuring-aids': {title:'Template, jig and fixture', rows:[['Template','repeat shape / marking'],['Jig','holds / locates work','guides the tool'],['Fixture','holds work securely','does not guide tool']]},
  '3.2.7/measuring-and-marking-out': {title:'Tolerance check', rows:[['50 ± 0.5 mm','49.5 mm minimum','← acceptable range →','50.5 mm maximum']]},
  '3.2.9/quality-assurance-qa': {title:'QA versus QC', rows:[['QA — prevent defects','standards','training','process planning','maintenance'],['QC — detect defects','measure','inspect','test','accept / reject']]},
  '3.2.9/quality-control-qc': {title:'Typical QC route', rows:[['Production check','make component','measure / scan','compare tolerance','pass or correct process']]},
  '3.2.8/environmental-issues': {title:'Circular design loop', rows:[['Keep value in circulation','design durable','use','repair / upgrade','reuse','recover materials','↺ new product']]},
  '3.1.1/methods-for-investigating-and-testing-materials': {title:'Fair material testing', rows:[['Reliable comparison','same specimen size','same test setup','controlled load','measure result','compare samples']]},
  '3.1.6/scales-of-production': {title:'Scale of production', rows:[['Volume increases →','one-off','batch','mass / line'],['Typical change →','high skill + flexibility','jigs / CNC','dedicated tooling + automation']]},
  '3.1.5/paper-and-board-printing-processes': {title:'Printing processes — what transfers the image?', rows:[['Screen','ink through mesh','substrate'],['Flexography','relief plate','ink','substrate'],['Offset lithography','plate','blanket','substrate'],['Digital','digital file','print head / toner','substrate']]}
};
const visual = visuals[key];
---
{visual && <figure class="visual-explainer" aria-label={visual.title}><figcaption>{visual.title}</figcaption><div class="visual-rows">{visual.rows.map(row => <div class="visual-row">{row.map((step,i) => <><span class={i===0?'visual-label':'visual-step'}>{step}</span>{i>0 && i<row.length-1 && <b aria-hidden="true">→</b>}</>)}</div>)}</div></figure>}
<style>
.visual-explainer{max-width:760px;margin:24px auto 34px;padding:18px 20px;border:1px solid #e6d9ea;border-radius:14px;background:#fcf9fd;box-shadow:0 6px 20px #44215b0a}.visual-explainer figcaption{font-size:16px;font-weight:800;color:#4b2862;margin-bottom:13px}.visual-rows{display:grid;gap:10px}.visual-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.visual-row span{font-size:12px;line-height:1.35;border-radius:8px;padding:8px 10px}.visual-label{font-weight:800;background:#5a2d77;color:#fff}.visual-step{background:#f0e6f5;color:#4e4056;border:1px solid #e2d3e8}.visual-row b{font-size:13px;color:#9a72ad}@media(max-width:650px){.visual-explainer{padding:15px}.visual-row{gap:6px}.visual-row span{font-size:11px;padding:7px 8px}}
</style>