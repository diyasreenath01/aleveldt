---
{d && <figure class="topic-visual"><figcaption>{d[0]}</figcaption><div class="flow">{d[1].map((s,i)=><><span>{s}</span>{i<d[1].length-1&&<b aria-hidden="true">→</b>}</>)}</div></figure>}
<style>.topic-visual{max-width:720px;margin:24px auto 30px;padding:18px 20px;background:#fbf7fd;border:1px solid #e6d9ea;border-radius:14px}.topic-visual figcaption{font-size:16px;font-weight:800;color:#4b2862;margin-bottom:13px}.flow{display:flex;align-items:center;justify-content:center;gap:7px;flex-wrap:wrap}.flow span{font-size:12px;line-height:1.35;text-align:center;padding:9px 11px;border-radius:8px;background:#f0e6f5;border:1px solid #e0d0e7;color:#4d4054}.flow b{font-size:13px;color:#9b73ae}@media(max-width:650px){.topic-visual{padding:14px}.flow{justify-content:flex-start}.flow span{font-size:11px;padding:7px 8px}}</style>