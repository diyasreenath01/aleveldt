---
{d && <figure class="topic-visual" role="img" aria-label={d[0]}><figcaption><span>LABELLED REVISION DIAGRAM</span>{d[0]}</figcaption><div class="flow">{d[1].map((s,i)=><><span>{s}</span>{i<d[1].length-1&&<b aria-hidden="true">→</b>}</>)}</div></figure>}
<style>.topic-visual{max-width:760px;margin:26px auto 34px;padding:20px 22px;background:linear-gradient(135deg,#fbf7fd,#fffaf4);border:1px solid #e6d9ea;border-radius:14px;box-shadow:0 7px 22px #4d275b0a}.topic-visual figcaption{font-size:17px;font-weight:800;color:#4b2862;margin-bottom:15px}.topic-visual figcaption span{display:block;font-size:9px;letter-spacing:.14em;color:#986daf;margin-bottom:5px}.flow{display:flex;align-items:center;justify-content:center;gap:7px;flex-wrap:wrap}.flow span{font-size:12px;line-height:1.35;text-align:center;padding:10px 12px;border-radius:8px;background:#f0e6f5;border:1px solid #e0d0e7;color:#4d4054;max-width:150px}.flow b{font-size:14px;color:#9b73ae}@media(max-width:650px){.topic-visual{padding:15px}.flow{justify-content:flex-start}.flow span{font-size:11px;padding:8px 9px}.flow b{font-size:12px}}</style>